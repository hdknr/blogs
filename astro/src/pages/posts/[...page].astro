---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Redirect from "@/layouts/Redirect.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Card from "@/components/Card.astro";
import Footer from "@/components/Footer.astro";
import HugoPagination from "@/components/HugoPagination.astro";
import { sortByDate, visiblePosts } from "@/utils/getTerms";
import { hugoPaginate } from "@/utils/hugoPaginate";
import config from "@/config";

/**
 * `/posts/` and `/posts/page/N/`.
 *
 * AstroPaper's `paginate()` numbers these `/posts/2/`, which would 404 every
 * bookmark of `/posts/page/2/` and leave 102 new URLs nobody links to.
 */
export async function getStaticPaths() {
  const posts = sortByDate(visiblePosts(await getCollection("posts")));
  const baseUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/posts/`;

  return hugoPaginate(posts, baseUrl).map(({ param, props }) => ({
    params: { page: param },
    props: { ...props, baseUrl },
  }));
}

const { items, current, lastPage, redirectTo, baseUrl } = Astro.props;
---

{
  redirectTo ? (
    <Redirect to={redirectTo} />
  ) : (
    <Layout title={`記事一覧 | ${config.site.title}`}>
      <Header activeNav="posts" />
      <Breadcrumb />
      <Main pageTitle="記事一覧" pageDesc="すべての記事">
        <ul>
          {items.map(post => <Card {...post} />)}
        </ul>
      </Main>
      <HugoPagination baseUrl={baseUrl} current={current} lastPage={lastPage} />
      <Footer noMarginTop={lastPage > 1} />
    </Layout>
  )
}
