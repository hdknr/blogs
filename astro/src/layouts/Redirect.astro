---
/**
 * A meta-refresh redirect page, matching what Hugo emits for aliases and for
 * every `page/1`. The site has 1648 of these; they exist so that bookmarks and
 * inbound links keep resolving, so the shape has to stay byte-compatible in the
 * ways that matter: a canonical link, a refresh, and the target in the title.
 */
type Props = { to: string };
const { to } = Astro.props;
const target = new URL(to, Astro.site).toString();
---

<!doctype html>
<html lang="ja">
  <head>
    <title>{target}</title>
    <link rel="canonical" href={target} />
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
</html>
