---
import LinkButton from "./LinkButton.astro";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

/**
 * Pagination over Hugo's URL shape (`<base>/page/N/`) rather than Astro's
 * `Page` object, which numbers pages as `<base>/N/`.
 *
 * Page 1 links to the base URL, not to `page/1` -- that route exists only as a
 * redirect back here, so linking to it would send readers through a bounce.
 */
type Props = {
  baseUrl: string;
  current: number;
  lastPage: number;
};

const { baseUrl, current, lastPage } = Astro.props;

const urlFor = (n: number) => (n === 1 ? baseUrl : `${baseUrl}page/${n}/`);
---

{
  lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex items-center justify-center gap-4"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={current === 1}
        href={urlFor(current - 1)}
        ariaLabel="前のページ"
      >
        <IconArrowLeft class="inline-block size-6 shrink-0" />
        前へ
      </LinkButton>

      <span aria-current="page">{current} / {lastPage}</span>

      <LinkButton
        disabled={current === lastPage}
        href={urlFor(current + 1)}
        ariaLabel="次のページ"
      >
        次へ
        <IconArrowRight class="inline-block size-6 shrink-0" />
      </LinkButton>
    </nav>
  )
}
