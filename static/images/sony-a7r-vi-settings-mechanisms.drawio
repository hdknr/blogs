<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="sony-a7rvi-mechanisms" name="Three Setting Mechanisms">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="α7R VI で「設定を保存する仕組み」は 3 つある" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="名前が似ていて混同しやすい。「何を・どこに・どうやって呼び戻すか」で切り分ける" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="50" width="600" height="20" as="geometry"/>
        </mxCell>

        <!-- MR -->
        <mxCell id="mr-box" value="［MR 撮影設定登録］" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="340" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="mr-what" value="何を：撮影に関する設定をひとまとめに&#xa;（露出モード、F 値、SS、ISO、AF、WB…）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="150" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="mr-where" value="どこに：本体に MR1〜MR10&#xa;（撮影モード 4 系統それぞれに 10 枠）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="mr-how" value="呼び戻し：モードダイヤル 1／2、&#xa;✱ からメニュー、カスタムキー" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="270" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="mr-when" value="使いどころ：撮る対象ごとの「構え」を&#xa;丸ごと切り替える。&#xa;例）風景／ポートレート／動体／夜景" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f0fe;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="330" width="300" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="mr-caveat" value="注意：プログラムシフトは登録不可。&#xa;カスタムキー設定は保存できない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="405" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="mr-mode" value="持続性：切り替えたら、その状態で撮り続ける" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#3b6ea5;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="70" y="465" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- Custom shooting -->
        <mxCell id="cs-box" value="［カスタム撮影設定登録］" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="410" y="110" width="340" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="cs-what" value="何を：露出、フォーカス設定、ドライブモード&#xa;（セルフタイマー以外）、連写速度ブースト、&#xa;シャッター方式" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="150" width="300" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cs-where" value="どこに：本体（呼び出し 1〜3）&#xa;静止画撮影時、かつ P/A/S/M のときのみ有効" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="220" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cs-how" value="呼び戻し：カスタムキーに&#xa;［押す間カスタム設定呼出1〜3］を割り当て" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="280" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cs-when" value="使いどころ：一瞬だけ設定を変えたい。&#xa;例）鳥が飛び立った瞬間だけ高速連写＋&#xa;動体 AF に切り替え、離せば元に戻る" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="340" width="300" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="cs-caveat" value="注意：装着レンズやカメラの状態によっては、&#xa;登録した設定にならない場合がある" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="430" y="415" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cs-mode" value="持続性：押している間だけ。離すと戻る" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#4a7c3f;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="470" width="300" height="25" as="geometry"/>
        </mxCell>

        <!-- Save/Load -->
        <mxCell id="sl-box" value="［設定の保存/読込］" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="770" y="110" width="340" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="sl-what" value="何を：カメラの設定をファイルとして&#xa;（MR の登録内容も含まれる）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sl-where" value="どこに：メモリーカード（スロット 1 のみ）&#xa;1 枚あたり設定ファイルは 10 個まで" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="210" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sl-how" value="呼び戻し：MENU →［セットアップ］→&#xa;［設定初期化/保存］→［設定の保存/読込］" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="270" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="sl-when" value="使いどころ：2 台目への複製、&#xa;初期化前のバックアップ、&#xa;現場ごとのプリセットの持ち出し" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e6;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="330" width="300" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sl-caveat" value="注意：型名が違うカメラでは読み込めない。&#xa;同型名でも本体ソフトのバージョン差で&#xa;読み込めないことがある。&#xa;撮影モードが MR 中は操作できない" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="405" width="300" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="sl-mode" value="持続性：読み込んだらカメラ全体が置き換わる" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#a86a00;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="478" width="300" height="25" as="geometry"/>
        </mxCell>

        <mxCell id="footer" value="α7R V までカードに置けた MR（M1〜M4）の代わりになるのは、いちばん右の［設定の保存/読込］" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="560" width="700" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
