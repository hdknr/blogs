<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="ai-delegation-flow" name="AI に任せるかの判断フロー">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="仕事を AI に任せるときの考える順番" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="q1" value="① AI に任せられる仕事か？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="70" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="blocker" value="ブロッカーは何かを特定する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="metric" value="② 完了の定義・評価指標を決める&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;数値化できるなら AI で自動化できる&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="200" width="260" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="tryrun" value="③ 一度やらせて振る舞いを観察する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="260" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="q2" value="できたか？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="390" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="automate" value="④ ワークフローを自動化できるか&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;つきっきりではなく判断基準を作る&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="650" y="400" width="250" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="why" value="⑤ できなかった理由を切り分ける" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="520" width="260" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="causes" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="90" y="610" width="780" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="ctx" value="&lt;b&gt;コンテキスト不足&lt;/b&gt;&lt;br&gt;→ 指示や守るべきテストを追加" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="120" y="640" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="perm" value="&lt;b&gt;権限不足&lt;/b&gt;&lt;br&gt;→ 与えられるか検討" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="370" y="640" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="perf" value="&lt;b&gt;性能不足&lt;/b&gt;&lt;br&gt;→ 半年寝て待つ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="640" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="retrynote" value="手当てしたら ③ に戻って再挑戦" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="715" width="300" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="No" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="q1" target="blocker">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="Yes" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="q1" target="metric">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1" source="metric" target="tryrun">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;" edge="1" parent="1" source="tryrun" target="q2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="できた" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;fontSize=11;" edge="1" parent="1" source="q2" target="automate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="できなかった" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;fontSize=11;" edge="1" parent="1" source="q2" target="why">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="endArrow=classic;html=1;rounded=0;strokeColor=#d79b00;" edge="1" parent="1" source="why" target="causes">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" value="再挑戦" style="endArrow=classic;html=1;rounded=1;strokeColor=#999999;dashed=1;fontSize=11;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="causes" target="tryrun">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="40" y="685"/>
              <mxPoint x="40" y="325"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
