        </mxCell>

        <mxCell id="title2" value="② パーティションとシャッフル（例: filter → groupBy で集計）" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
