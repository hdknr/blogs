<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="spark-arch" name="Spark driver executor shuffle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title1" value="① ドライバーとエグゼキューター" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="driver" value="&lt;b&gt;ドライバー&lt;/b&gt;（SparkSession）&lt;br&gt;&lt;div style=&quot;text-align:left;font-size:11px&quot;&gt;・コードを実行計画に変換&lt;br&gt;・ステージ／タスクに分割&lt;br&gt;・結果を受け取る&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="230" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="cm" value="&lt;b&gt;クラスターマネージャー&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Standalone / YARN / Kubernetes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="60" width="190" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="execgroup" value="ワーカーノード群" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="600" y="55" width="360" height="175" as="geometry"/>
        </mxCell>
        <mxCell id="exec1" value="&lt;b&gt;エグゼキューター 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;タスク・タスク&lt;br&gt;（パーティションごとに処理）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="615" y="90" width="160" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="exec2" value="&lt;b&gt;エグゼキューター 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;タスク・タスク&lt;br&gt;（パーティションごとに処理）&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="785" y="90" width="160" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="資源を要求" style="endArrow=block;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="driver" target="cm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="起動" style="endArrow=block;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cm" target="execgroup">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="タスクを配る／結果を返す" style="endArrow=block;startArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1">
