          <mxGeometry x="410" y="215" width="230" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="noteInner" value="論点 1・2・4：そもそもここに投資するか&lt;br&gt;（品質とは別軸の、組織としての判断）" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#b46504;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="275" width="300" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="nCheck" value="Linter・AI がルール準拠を確認 ／ デザイナーがレビュー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="355" width="520" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="noteMid" value="論点 7：デザインの良し悪しはルールに書ききれず、&lt;br&gt;内部の目で測れる範囲が狭い" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#2f5597;fontStyle=1;" vertex="1" parent="1">
