        <mxCell id="layerOuter" value="③ リリース後：利用者を含めた運用" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="15" y="58" width="1065" height="607" as="geometry"/>
        </mxCell>

        <!-- Layer 2' -->
        <mxCell id="layerUser" value="②' リリース前：少人数のユーザーで検証" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;" vertex="1" parent="1">
