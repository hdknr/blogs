<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="cgw-two-paths" name="Claude for Google Workspace">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Claude for Google Workspace の 2 つの入口" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Path 1: sidebar add-on -->
        <mxCell id="grp-addon" value="① サイドバー（アドオン）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="380" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="openfile" value="開いている 1 ファイル&lt;br&gt;Docs / Sheets / Slides" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sidebar" value="Claude サイドバー&lt;br&gt;（拡張機能から起動）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="120" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e-side" value="読み取り&lt;br&gt;直接編集" style="endArrow=classic;startArrow=classic;html=1;fontSize=10;strokeColor=#666666;" edge="1" parent="1" source="sidebar" target="openfile">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="mode" value="Ask before edits（既定）&lt;br&gt;Accept all edits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="215" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="history" value="変更は Google の&lt;br&gt;バージョン履歴に残る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="215" width="140" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="scope1" value="他のファイル・Gmail・Calendar は見ない" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="55" y="300" width="335" height="30" as="geometry"/>
        </mxCell>

        <!-- Path 2: connectors -->
        <mxCell id="grp-conn" value="② Claude のチャット（コネクター）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="590" y="70" width="380" height="280" as="geometry"/>
        </mxCell>
        <mxCell id="chat" value="Claude アプリ&lt;br&gt;（チャット画面）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="drivefiles" value="共有権限の範囲の&lt;br&gt;Google ファイル" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="810" y="120" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e-conn" value="作成&lt;br&gt;編集" style="endArrow=classic;html=1;fontSize=10;strokeColor=#666666;" edge="1" parent="1" source="chat" target="drivefiles">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="multi" value="複数資料を読んで&lt;br&gt;新しいファイルを作る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="610" y="215" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="scope2" value="Team / Enterprise はオーナーが有効化" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="615" y="300" width="335" height="30" as="geometry"/>
        </mxCell>

        <!-- Shared settings -->
        <mxCell id="settings" value="Claude 側の設定を共有：モデル選択 ／ Skills ／ コネクター（組織で許可された範囲）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="440" width="640" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e-s1" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="settings" target="grp-addon">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-s2" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;" edge="1" parent="1" source="settings" target="grp-conn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
