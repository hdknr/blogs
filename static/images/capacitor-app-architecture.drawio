<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="capacitor-app-architecture" name="Capacitor App Architecture">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="940" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="n_title" value="Capacitor アプリの構成（ネイティブ拡張を含む）" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="560" height="30" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="n_legend_custom" value="自作（ネイティブ拡張）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="18" width="150" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="n_legend_lib" value="既製のプラグイン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="18" width="140" height="26" as="geometry"/>
        </mxCell>

        <!-- Native app container -->
        <mxCell id="n_app" value="ネイティブアプリ（iOS: ios/App ／ Android: android/app）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;dashed=1;dashPattern=5 5;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="1040" height="720" as="geometry"/>
        </mxCell>

        <!-- WebView layer -->
        <mxCell id="n_webview" value="WebView（iOS: WKWebView ／ Android: WebView）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="980" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="n_webapp" value="&lt;b&gt;Web アプリ&lt;/b&gt;&lt;br&gt;React / Vue / Svelte など&lt;br&gt;HTML・CSS・JS&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;（npx cap sync でアプリに同梱）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="140" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n_js_lib" value="&lt;b&gt;既製プラグインの JS API&lt;/b&gt;&lt;br&gt;import { Geolocation } from&lt;br&gt;'@capacitor/geolocation'&lt;br&gt;Geolocation.getCurrentPosition()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="140" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n_js_custom" value="&lt;b&gt;自作プラグインの JS 定義&lt;/b&gt;&lt;br&gt;const Echo =&lt;br&gt;registerPlugin&amp;lt;EchoPlugin&amp;gt;('Echo')&lt;br&gt;await Echo.echo({ value: 'hi' })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="140" width="280" height="120" as="geometry"/>
        </mxCell>

        <!-- Bridge -->
        <mxCell id="n_bridge" value="&lt;b&gt;Capacitor ブリッジ&lt;/b&gt;（@capacitor/core ⇄ ネイティブランタイム）&lt;br&gt;メソッド名と引数をネイティブへ渡し、結果を Promise として JS に返す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="980" height="60" as="geometry"/>
        </mxCell>

        <!-- Native plugins layer -->
        <mxCell id="n_native_layer" value="ネイティブ側のプラグイン（Swift ／ Kotlin・Java）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="980" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="n_plugin_official" value="&lt;b&gt;公式プラグイン&lt;/b&gt;&lt;br&gt;@capacitor/camera&lt;br&gt;@capacitor/geolocation&lt;br&gt;@capacitor/haptics など" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="485" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n_plugin_third" value="&lt;b&gt;コミュニティ製・サービス提供元の SDK&lt;/b&gt;&lt;br&gt;例: @revenuecat/purchases-capacitor&lt;br&gt;（npm で入れて npx cap sync）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="485" width="280" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="n_plugin_custom" value="&lt;b&gt;自作プラグイン（ネイティブ拡張）&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;iOS: class EchoPlugin: CAPPlugin, CAPBridgedPlugin&lt;br&gt;　@objc func echo(_ call: CAPPluginCall)&lt;br&gt;Android: @CapacitorPlugin(name = &quot;Echo&quot;)&lt;br&gt;　@PluginMethod echo(PluginCall call)&lt;br&gt;→ call.resolve(...) で結果を返す&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="730" y="485" width="280" height="120" as="geometry"/>
        </mxCell>

        <!-- App native code (registration) -->
        <mxCell id="n_appcode" value="&lt;b&gt;アプリ本体のネイティブコード&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;iOS: 独自の ViewController の capacitorDidLoad() で&lt;br&gt;　bridge?.registerPluginInstance(EchoPlugin())&lt;br&gt;Android: MainActivity の onCreate() で&lt;br&gt;　registerPlugin(EchoPlugin.class)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="570" y="660" width="330" height="90" as="geometry"/>
        </mxCell>

        <!-- OS layer (outside the app) -->
        <mxCell id="n_os" value="&lt;b&gt;OS の API ・ネイティブ SDK&lt;/b&gt;&lt;br&gt;カメラ・位置情報・通知・StoreKit ／ Google Play Billing・サードパーティのネイティブ SDK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="820" width="1040" height="60" as="geometry"/>
        </mxCell>

        <!-- Edges: Web app -> JS APIs -->
        <mxCell id="e_web_lib" value="呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n_webapp" target="n_js_lib">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_web_custom" value="呼び出し" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_webapp" target="n_js_custom">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="125"/>
              <mxPoint x="870" y="125"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Edges: JS APIs -> bridge -->
        <mxCell id="e_lib_bridge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;" edge="1" parent="1" source="n_js_lib" target="n_bridge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_custom_bridge" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.798;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_js_custom" target="n_bridge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_bridge_custom_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;exitX=0.898;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_bridge" target="n_js_custom">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edges: bridge -> native plugins -->
        <mxCell id="e_bridge_official" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.173;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="n_bridge" target="n_plugin_official">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_bridge_third" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="n_bridge" target="n_plugin_third">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_bridge_custom" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.798;exitY=1;exitDx=0;exitDy=0;entryX=0.4;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_bridge" target="n_plugin_custom">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_custom_bridge_back" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.898;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_plugin_custom" target="n_bridge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge: registration -->
        <mxCell id="e_register" value="登録" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_appcode" target="n_plugin_custom">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edges: native plugins -> OS -->
        <mxCell id="e_official_os" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.192;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_plugin_official" target="n_os">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_third_os" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_plugin_third" target="n_os">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_custom_os" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.94;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_plugin_custom" target="n_os">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="982" y="800"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Labels for the custom plugin call / return -->
        <mxCell id="n_lbl_call" value="CAPPluginCall ／ PluginCall" style="text;html=1;fontSize=10;align=right;verticalAlign=middle;fontColor=#9c6500;" vertex="1" parent="1">
          <mxGeometry x="640" y="400" width="195" height="20" as="geometry"/>
