        <!-- Values -->
        <mxCell id="lyr-val" value="&lt;b&gt;価値（Values）5 つ&lt;/b&gt;&lt;br&gt;Communication / Simplicity / Feedback / Courage / Respect&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;方向を決めるが、それだけでは曖昧&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
