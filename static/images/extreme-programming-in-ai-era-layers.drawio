          <mxGeometry x="40" y="230" width="560" height="90" as="geometry"/>
        </mxCell>

        <!-- Practices -->
        <mxCell id="lyr-prac" value="&lt;b&gt;実践（Practices）24 個&lt;/b&gt;&lt;br&gt;Whole Team / Pair Programming / Test-First / Incremental Design …&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;具体的で、やったかどうかが分かる&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="560" height="90" as="geometry"/>
