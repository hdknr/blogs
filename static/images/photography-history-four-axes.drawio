<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="photo-four-axes" name="Four Axes of Photographic Change">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="写真史の転換点を測る 4 つの軸" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="500" y="18" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="同じ「転換点」でも、性質の異なる 4 種類がある。混ぜて並べると個々の運動の役割が見えなくなる。" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="350" y="48" width="700" height="24" as="geometry"/>
        </mxCell>

        <!-- Axis 1: technical -->
        <mxCell id="ax1" value="① 技術的転換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="310" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="ax1q" value="問い&#10;「何が記録できるようになったか」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="270" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ax1e" value="例&#10;湿板コロジオン／網版（ハーフトーン）／&#10;35mm／カラー乳剤／デジタルセンサー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="192" width="270" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="ax1w" value="記録する分野&#10;技術史・産業史" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="270" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ax1n" value="技術が可能になっても、芸術として&#10;認められるとは限らない" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="62" y="354" width="270" height="54" as="geometry"/>
        </mxCell>

        <!-- Axis 2: institutional / aesthetic -->
        <mxCell id="ax2" value="② 制度的・美学的転換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="375" y="90" width="310" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="ax2q" value="問い&#10;「何が芸術写真と認められるか」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="130" width="270" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ax2e" value="例&#10;ピクトリアリズム／f/64／&#10;ニュー・トポグラフィックス／ニューカラー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="192" width="270" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="ax2w" value="記録する分野&#10;美術館・写真批評（＝写真史の正典）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=12;fontStyle=1;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="395" y="290" width="270" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ax2n" value="作者・宣言・展覧会が揃うため&#10;「運動」として記述しやすい" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="397" y="354" width="270" height="54" as="geometry"/>
        </mxCell>

        <!-- Axis 3: circulation -->
        <mxCell id="ax3" value="③ 流通・受容の転換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="90" width="310" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="ax3q" value="問い&#10;「誰がどこで写真を撮り、見るか」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="730" y="130" width="270" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ax3e" value="例&#10;コダック No.1／グラフ誌／&#10;Web と JPEG／Instagram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="730" y="192" width="270" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="ax3w" value="記録する分野&#10;メディア論・産業統計（正典では手薄）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="730" y="290" width="270" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ax3n" value="作者も宣言も展覧会も持たないため&#10;「背景」に落とされやすい" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="732" y="354" width="270" height="54" as="geometry"/>
        </mxCell>

        <!-- Axis 4: commission -->
        <mxCell id="ax4" value="④ 発注の転換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1045" y="90" width="310" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="ax4q" value="問い&#10;「誰の費用と目的で写真が撮られるか」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1065" y="130" width="270" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="ax4e" value="例&#10;肖像写真館／カルト・ド・ヴィジット／&#10;広告写真の職業化／FSA・OWI／USIA／&#10;ストックフォト／学習データ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1065" y="192" width="270" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="ax4w" value="記録する分野&#10;広告史・政治史・経済史&#10;（正典ではほぼ不在）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1065" y="290" width="270" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ax4n" value="最初の発注者は個人（富裕層）だった。&#10;個人の発注は今日まで途切れていない" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1067" y="354" width="270" height="54" as="geometry"/>
        </mxCell>

        <!-- Bottom band -->
        <mxCell id="band" value="写真史の教科書は ② だけを「運動」として詳述し、①③④ を文脈の章に落とす。&#10;③ と ④ が落ちる理由は同じで、どちらも作者も宣言も展覧会も持たないからである。&#10;だが実践としての写真をどれだけ変えたかで測ると、③ と ④ のほうが桁が大きい。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1315" height="76" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="この記事では、主要な転換点をこの 4 軸でスコアリングし直す。" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="410" y="548" width="580" height="24" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
