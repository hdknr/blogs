<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="routines-decisions" name="Routines three decisions">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Routines（現 scheduled tasks）を設計する 3 つの決定" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- 1. Trigger -->
        <mxCell id="grp-trigger" value="① トリガー：いつ起動するか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="230" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="trg-schedule" value="スケジュール&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;毎週月曜 10:00 など&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="115" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="trg-github" value="GitHub イベント&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Issue 作成・PR マージなど&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="195" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="trg-api" value="API（HTTP POST）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;CD パイプライン・監視アラート&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="275" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- 2. Context -->
        <mxCell id="grp-context" value="② コンテキスト：何を渡すか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="230" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-prompt" value="プロンプト&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;単体で完結し、成功条件まで書く&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="345" y="115" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-repo" value="リポジトリ&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ソースとドキュメントの 2 本など&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="345" y="195" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-connector" value="コネクタ（MCP）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Slack・Google Drive・監視ツール&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="345" y="275" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- Cloud session -->
        <mxCell id="session" value="Anthropic 管理のクラウド上で&lt;br&gt;Claude Code セッションが走る&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PC を閉じていても動く&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="180" width="190" height="80" as="geometry"/>
        </mxCell>

        <!-- 3. Steering -->
        <mxCell id="grp-steer" value="③ 舵取り：品質をどう担保するか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="230" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="st-review" value="エージェント同士のレビュー&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PR 作成で別のルーティンが起動&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="865" y="115" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="st-watch" value="実行中のセッションを見て介入&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Web・CLI・デスクトップから&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="865" y="195" width="180" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="st-verify" value="成果物を検証する&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;変更したページを実際に描画&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="865" y="275" width="180" height="55" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="grp-trigger" target="grp-context">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-context" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="grp-context" target="session">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="session" target="grp-steer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="コンテキストが Claude の成功の上限になる ── ワークショップでの指摘" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="250" y="400" width="600" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
