<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="loop-convergence-failures" name="Loop Convergence Failures">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="ループが収束しない 3 つの壊れ方" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="390" y="18" width="400" height="30" as="geometry"/>
        </mxCell>

        <!-- ============ Column 1: never stops ============ -->
        <mxCell id="col1" value="① 止まらない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="340" height="490" as="geometry"/>
        </mxCell>
        <mxCell id="c1cause" value="停止条件が測れない&#xa;「いい感じになったら」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="260" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="c1work" value="作業する&#xa;(generator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="200" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c1judge" value="判定できない" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="125" y="300" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c1e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="c1work" target="c1judge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c1e2" value="常に「まだ」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;fontSize=11;fontColor=#b85450;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1judge" target="c1work">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="90" y="340"/><mxPoint x="90" y="225"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c1out" value="トークンを焼き続ける&#xa;＝「開いた請求書」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="420" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c1fix" value="対策: 反復上限・コスト上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="495" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- ============ Column 2: stops on a lie ============ -->
        <mxCell id="col2" value="② 嘘で止まる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="420" y="70" width="340" height="490" as="geometry"/>
        </mxCell>
        <mxCell id="c2cause" value="作る役が自分で採点する&#xa;／合言葉を先に出す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="260" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="c2work" value="作業する&#xa;(generator)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="200" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c2judge" value="「もう十分だろう」" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="505" y="300" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="c2e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="c2work" target="c2judge">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c2e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="c2judge" target="c2out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c2out" value="条件未達のまま停止&#xa;＝ 緑に見える赤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="420" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c2fix" value="対策: 採点役を別コンテキストに分離" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="495" width="260" height="40" as="geometry"/>
        </mxCell>

        <!-- ============ Column 3: oscillates ============ -->
        <mxCell id="col3" value="③ 振動する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="70" width="340" height="490" as="geometry"/>
        </mxCell>
        <mxCell id="c3cause" value="停止条件に不動点がない&#xa;直すと新しい指摘が生まれる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="110" width="260" height="46" as="geometry"/>
        </mxCell>

        <mxCell id="c3fix1" value="指摘を直す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="205" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="c3new" value="別の指摘が出る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="310" width="130" height="45" as="geometry"/>
