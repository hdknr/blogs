        <mxCell id="c3e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3fix1" target="c3new">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c3e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c3new" target="c3fix1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c3lbl" value="件数が減らない" style="text;html=1;fontSize=11;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="880" y="265" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="c3out" value="上限で強制終了&#xa;＝ ゼロに到達しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="420" width="260" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="c3fix" value="対策: 不動点のある量を停止条件にする" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="495" width="260" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="①②は停止条件の「書き方」の問題、③は停止条件に選んだ「量そのもの」の問題" style="text;html=1;fontSize=13;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="575" width="700" height="30" as="geometry"/>
        </mxCell>

      </root>
