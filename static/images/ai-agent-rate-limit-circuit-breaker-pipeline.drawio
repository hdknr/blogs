          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fanout" value="10 銘柄 × 4 エージェント ＝ 1 回の日次実行で 40 回以上の CLI 呼び出し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
