<mxfile host="app.diagrams.net" agent="generated" type="device"><diagram name="1. 全体構成" id="956488342"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1290" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="EUメール トラッキング対応 ── 全体構成" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#21295C;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="判定はコンタクトの属性で自動。人がやるのは「2通つくって2回送る」だけ。点線の枠は EU一律OFF 方式では不要になる部品。" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1300" height="22" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fontStyle=1;fillColor=#FAFBFC;strokeColor=none;fontColor=#5A6B87;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1500" height="104" as="geometry"/></mxCell><mxCell id="c4" value="① 発生源" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="160" height="104" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fontStyle=1;fillColor=#FAFBFC;strokeColor=none;fontColor=#5A6B87;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="1500" height="202" as="geometry"/></mxCell><mxCell id="c6" value="② 同意記録&lt;br&gt;（コンタクト単位）" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="232" width="160" height="202" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fontStyle=1;fillColor=#FAFBFC;strokeColor=none;fontColor=#5A6B87;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="462" width="1500" height="96" as="geometry"/></mxCell><mxCell id="c8" value="③ 自動で効く仕組み" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="462" width="160" height="96" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fontStyle=1;fillColor=#FAFBFC;strokeColor=none;fontColor=#5A6B87;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="1500" height="156" as="geometry"/></mxCell><mxCell id="c10" value="④ リスト&lt;br&gt;（条件式で自動振り分け）" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="586" width="160" height="156" as="geometry"/></mxCell><mxCell id="c11" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fontStyle=1;fillColor=#FAFBFC;strokeColor=none;fontColor=#5A6B87;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1500" height="148" as="geometry"/></mxCell><mxCell id="c12" value="⑤ 配信物&lt;br&gt;（人が2通つくる）" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="770" width="160" height="148" as="geometry"/></mxCell><mxCell id="c13" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fontStyle=1;fillColor=#FAFBFC;strokeColor=none;fontColor=#5A6B87;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="946" width="1500" height="132" as="geometry"/></mxCell><mxCell id="c14" value="⑥ 計測結果の置き場" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="946" width="160" height="132" as="geometry"/></mxCell><mxCell id="c15" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fontStyle=1;fillColor=#FAFBFC;strokeColor=none;fontColor=#5A6B87;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1106" width="1500" height="110" as="geometry"/></mxCell><mxCell id="c16" value="⑦ 同意の取得と撤回" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="1106" width="160" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;新規コンタクト&lt;/b&gt;&lt;br&gt;フォーム送信（資料DL・申込・問い合わせ）&lt;br&gt;&lt;b&gt;1つのフォームで①②③を同時に記録&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="210" y="90" width="305" height="68" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;既存コンタクト&lt;/b&gt;&lt;br&gt;現在の配信対象DB" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="535" y="90" width="305" height="68" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;営業・展示会・受注&lt;/b&gt;&lt;br&gt;商談時のフォーム案内・受付・申込書" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="860" y="90" width="305" height="68" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;地域情報&lt;/b&gt;&lt;br&gt;国／地域・IP国（判定不能を含む）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="1185" y="90" width="305" height="68" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;① 処理の法的根拠&lt;/b&gt;&lt;br&gt;&lt;br&gt;GDPR 6条&lt;br&gt;HubSpotネイティブ&lt;br&gt;&lt;b&gt;プロパティー&lt;/b&gt;／CSVで一括付与できる" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="210" y="258" width="330" height="150" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;② 配信登録ステータス&lt;/b&gt;&lt;br&gt;&lt;br&gt;ePrivacy 13条&lt;br&gt;HubSpotネイティブ&lt;br&gt;&lt;b&gt;プロパティーではない&lt;/b&gt;／&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;一括では作れない&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="565" y="258" width="330" height="150" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;③ トラッキング同意&lt;/b&gt;&lt;br&gt;&lt;br&gt;ePrivacy 5条3項&lt;br&gt;&lt;b&gt;自作のカスタムプロパティー&lt;/b&gt;&lt;br&gt;単一チェックボックス／既定は未チェック&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;EU一律OFF方式では不要&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFFFFF;strokeColor=#5A6B87;fontColor=#30405C;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="258" width="330" height="150" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;リスト条件式による判定（自動）&lt;/b&gt;　地域 × 配信登録 × トラッキング同意。&lt;b&gt;判定不能はEU扱いに倒す&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="210" y="484" width="620" height="56" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;送信ゲート（アカウント設定）&lt;/b&gt;　「法的根拠に基づいてEメールを送信」＝ON。配信同意のないコンタクトは送信対象から除外" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="484" width="630" height="56" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;L1｜EU・UK・判定不能&lt;/b&gt;&lt;br&gt;&lt;br&gt;地域＝EU／UK／不明&lt;br&gt;&lt;b&gt;かつ&lt;/b&gt; トラッキング同意 ≠ Yes" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="210" y="610" width="310" height="110" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;L2｜EU・UK・同意済&lt;/b&gt;&lt;br&gt;&lt;br&gt;地域＝EU／UK&lt;br&gt;&lt;b&gt;かつ&lt;/b&gt; トラッキング同意＝Yes&lt;br&gt;&lt;b&gt;かつ&lt;/b&gt; 配信登録にオプトイン済み&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;EU一律OFF方式では不要&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFFFFF;strokeColor=#5A6B87;fontColor=#30405C;dashed=1;" vertex="1" parent="1"><mxGeometry x="542" y="610" width="310" height="110" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;L3｜非EU・UK&lt;/b&gt;&lt;br&gt;&lt;br&gt;地域＝EU／UK以外&lt;br&gt;&lt;b&gt;かつ&lt;/b&gt; 地域が判明している" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="874" y="610" width="310" height="110" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;S｜配信対象外&lt;/b&gt;&lt;br&gt;&lt;br&gt;有効な同意が存在しないコンタクト&lt;br&gt;（購入リスト・出所不明など）" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;" vertex="1" parent="1"><mxGeometry x="1206" y="610" width="284" height="110" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;通①　計測OFF便&lt;/b&gt;&lt;br&gt;&lt;br&gt;メール単位でトラッキングOFF&lt;br&gt;ビーコンなし・href書き換えなし&lt;br&gt;UTMのみ付与" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="210" y="792" width="370" height="104" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;通②　計測ON便&lt;/b&gt;&lt;br&gt;&lt;br&gt;開封・クリックを個人単位で計測（従来どおり）&lt;br&gt;UTMも併用&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;作り方：「計測OFF原本」を複製して本文を作り、さらに複製した側を ON に戻す&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="630" y="792" width="554" height="104" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;送信しない&lt;/b&gt;&lt;br&gt;&lt;br&gt;メールでの同意依頼も行わない&lt;br&gt;削除ではなく抑止リストとして保持" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;" vertex="1" parent="1"><mxGeometry x="1206" y="792" width="284" height="104" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;サーバー／CDNのアクセスログ&lt;/b&gt;&lt;br&gt;utm_campaign 別のリクエスト数&lt;br&gt;&lt;b&gt;配信単位の集計のみ・IP非保持&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="210" y="968" width="310" height="88" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;HubSpot（コンタクトのタイムライン）&lt;/b&gt;&lt;br&gt;開封・クリック・リスト抽出・リードスコアリングが使える&lt;br&gt;＋ サーバーログのUTM集計も併用できる" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="740" y="968" width="444" height="88" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;得られないもの（通①）&lt;/b&gt;&lt;br&gt;開封率／誰がクリックしたか／HubSpot側の記録" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;" vertex="1" parent="1"><mxGeometry x="1206" y="968" width="284" height="88" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;配信設定ページ（HubSpotネイティブ）を一次導線にする&lt;/b&gt;　全メールのフッターにリンクを置く（通①にも必ず入れる）。現在の状態を反映して表示するため、&lt;b&gt;未取得は必然的に未チェック&lt;/b&gt;になる。&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;クリックではなくフォーム送信で記録すること&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="210" y="1124" width="974" height="74" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;凡例&lt;/b&gt;&lt;br&gt;黄＝計測なしの経路／緑＝計測ありの経路&lt;br&gt;点線＝EU一律OFF方式では不要" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;" vertex="1" parent="1"><mxGeometry x="1206" y="1124" width="284" height="74" as="geometry"/></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="CSVで一括付与できる" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c21"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c42" value="一括では作れない" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c18" target="c22"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="14" as="offset"/></mxGeometry></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c19" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c21" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="地域判定" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#065A82;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1520" y="200"/><mxPoint x="1520" y="456"/><mxPoint x="700" y="456"/></Array></mxGeometry></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#065A82;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#065A82;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#065A82;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#065A82;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c24" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c26" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c27" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c28" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c29" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c30" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c31" target="c34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c30" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c31" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="本人が同意／撤回 → ③に反映 → 次回配信から L2 へ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.95;exitY=0;entryX=1;entryY=0.5;verticalAlign=bottom;" edge="1" parent="1" source="c36" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1134" y="1092"/><mxPoint x="1545" y="1092"/><mxPoint x="1545" y="333"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2. 同意取得の3経路" id="957527233"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="同意取得の3経路" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#21295C;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="同意は2種類あり、相手が「配信同意」を持っているかで取得経路が変わる。ここを混ぜると設計が破綻する。" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;配信同意（ePrivacy 13条）&lt;/b&gt;　メールを送ってよいか。&lt;b&gt;これがないと送れない&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;トラッキング同意（ePrivacy 5条3項）&lt;/b&gt;　開封・クリックを計測してよいか。&lt;b&gt;これがなくても送れる&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="700" height="96" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;組み合わせは4通り（段階ではなく直交）&lt;/b&gt;&lt;br&gt;配信○＋計測○ → L2（通②）　／　&lt;b&gt;配信○＋計測× → L1（通①）&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;配信×＋計測○ → 送れない&lt;/font&gt;　／　配信×＋計測× → 送れない" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="770" y="100" width="670" height="96" as="geometry"/></mxCell><mxCell id="c5" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#EDF6F3;strokeColor=#10B98A;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="1400" height="170" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;経路1&lt;/b&gt;&lt;br&gt;新規コンタクト" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="252" width="150" height="44" as="geometry"/></mxCell><mxCell id="c7" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#FFF6E5;strokeColor=#EFCB93;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1400" height="180" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;経路2&lt;/b&gt;&lt;br&gt;既存・配信同意あり" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="462" width="150" height="44" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;html=1;fillColor=#F4F5F7;strokeColor=#D5D9E0;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="1400" height="190" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;経路3&lt;/b&gt;&lt;br&gt;既存・配信同意なし" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="712" width="150" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;1つのフォーム&lt;/b&gt;&lt;br&gt;&lt;br&gt;□ ニュースレターの配信を希望します&lt;br&gt;□ 開封・クリックの計測に同意します&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;（同意されない場合も配信されます）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="230" y="262" width="300" height="120" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;送信 → 3つの記録が同時に入る&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 処理の法的根拠&lt;br&gt;② 配信登録&lt;br&gt;③ トラッキング同意" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="600" y="262" width="300" height="120" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;L2 に入る&lt;/b&gt;&lt;br&gt;&lt;br&gt;次回配信から計測ON便（通②）を受け取る" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="262" width="300" height="120" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#065A82;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;通①（計測OFF便）を送る&lt;/b&gt;&lt;br&gt;&lt;br&gt;配信同意はあるので送信は適法&lt;br&gt;計測OFFなので5条3項も発生しない&lt;br&gt;フッターに配信設定ページのリンク" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="476" width="300" height="130" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;本人がフォームを送信&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;★クリックを証跡にしないこと&lt;/b&gt;&lt;/font&gt;&lt;br&gt;計測OFFなのでクリックは記録されない。&lt;br&gt;必ずフォーム送信で記録する" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="600" y="476" width="300" height="130" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;③ が Yes になり L1 → L2 へ&lt;/b&gt;&lt;br&gt;&lt;br&gt;リスト条件式が自動で移す&lt;br&gt;&lt;b&gt;手動更新は不要&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="970" y="476" width="300" height="130" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#065A82;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;メールで依頼できない&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;依頼メール自体がダイレクトマーケティングに該当し得る（ePrivacy 13条・独UWG §7の警告書リスク）&lt;/font&gt;&lt;br&gt;&lt;b&gt;法務の結論が出るまで動かさない&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="230" y="726" width="300" height="140" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;メール以外の経路のみ&lt;/b&gt;&lt;br&gt;&lt;br&gt;サイト訪問時のフォーム&lt;br&gt;商談・訪問時にURL／QRを案内&lt;br&gt;受注時の申込書・契約書別紙&lt;br&gt;展示会・イベントの受付フォーム" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="600" y="726" width="300" height="140" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;本人が能動的に送信した記録が残る&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;口頭同意は証跡が弱いので避ける&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="970" y="726" width="300" height="140" as="geometry"/></mxCell><mxCell id="c24" value="メール以外へ迂回" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;記録すべき項目（GDPR 7条(1) の立証責任）&lt;/b&gt;　取得日時／取得元／同意文言のバージョン。&lt;b&gt;一次証跡は HubSpot のネイティブ履歴&lt;/b&gt;（配信登録の変更履歴・プロパティー変更履歴）を使い、手で埋めるカスタム日付は補助に留める。Starter ではワークフローが使えず、手動の日付は必ず埋め漏れる。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="40" y="908" width="1400" height="72" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3. 既存データの4バケット仕分け" id="600357860"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="既存データの仕分け ── 全員リセットはしない" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#21295C;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="判定はバケット単位。全員一律の操作（リセット＋一斉リパーミッション）はこの計画で最も法的リスクが高い。" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;やってはいけない：全員リセット＋一斉リパーミッション&lt;/b&gt;&lt;br&gt;証跡の破棄（GDPR 7条(1)の立証手段を自分で失う・不可逆）／送信ゲートによる自己ブロック／配信同意がない相手への依頼メールは新規の違反／再オプトイン率は5〜15%でリストの85〜95%を失う" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="700" height="106" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;論理が自己矛盾している&lt;/b&gt;&lt;br&gt;同意が&lt;b&gt;有効&lt;/b&gt;なら → リセットすべきでない（証拠を捨てるだけ）&lt;br&gt;同意が&lt;b&gt;無効&lt;/b&gt;なら → メールで直せない（送る根拠がない）&lt;br&gt;&lt;b&gt;リセット＋送信が最善になる中間領域が存在しない&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="770" y="96" width="670" height="106" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;既存コンタクト1件&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="240" height="60" as="geometry"/></mxCell><mxCell id="c6" value="取得日時・取得元・文言の&lt;br&gt;証跡が残っているか" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fillColor=#FFFFFF;strokeColor=#065A82;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="240" height="90" as="geometry"/></mxCell><mxCell id="c7" value="既存顧客・取引関係が&lt;br&gt;あるか" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fillColor=#FFFFFF;strokeColor=#065A82;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="240" height="90" as="geometry"/></mxCell><mxCell id="c8" value="証跡が曖昧か&lt;br&gt;（取得経路・文言が不明）" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=11;fillColor=#FFFFFF;strokeColor=#065A82;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="240" height="90" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;バケット1｜有効&lt;/b&gt;　触らない&lt;br&gt;配信継続。通①／通②のフッターの配信設定ページで③を自然に回収" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="350" width="300" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;バケット2｜別根拠の可能性&lt;/b&gt;&lt;br&gt;ePrivacy 13条(2) の soft opt-in。&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;法務判断。配信可能な相手が増える&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="490" width="300" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;バケット3｜グレー&lt;/b&gt;&lt;br&gt;法務判断。送るなら&lt;b&gt;計測OFF・単発・最小限&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="420" y="630" width="300" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;バケット4｜無効&lt;/b&gt;&lt;br&gt;購入リスト・スクレイピング・抱き合わせ同意・事前チェック済みボックス" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;" vertex="1" parent="1"><mxGeometry x="420" y="770" width="300" height="100" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="はい" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#065A82;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="はい" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="はい" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c8" target="c12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="180" y="820"/></Array></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;L1 または L2 に入る&lt;/b&gt;&lt;br&gt;&lt;br&gt;配信を継続しながら、配信設定ページでトラッキング同意を回収していく。一斉キャンペーンは不要。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="820" y="400" width="300" height="130" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;S｜配信対象外へ隔離&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;メールを送らない。同意依頼もしない&lt;/b&gt;&lt;br&gt;経路3（サイト・商談・イベント）のみ&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;削除ではなく保持する&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;" vertex="1" parent="1"><mxGeometry x="820" y="730" width="300" height="130" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c9" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="法務OKなら" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c10" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="法務OKなら" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="c11" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Meiryo;fontSize=10;strokeColor=#5A6B87;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontColor=#5A6B87;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c12" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;なぜ削除しないのか&lt;/b&gt;&lt;br&gt;&lt;br&gt;完全に削除すると、後で別ソースから再インポートして再び配信を始めてしまう。抑止目的での保持は正当な目的。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="1180" y="730" width="260" height="130" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;バケット2の優先度が高い理由&lt;/b&gt;&lt;br&gt;&lt;br&gt;soft opt-in が使えると、既存顧客に配信を継続できる。法務確認の第1項目に置くべき。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="1180" y="400" width="260" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4. 同意者ON と EU一律OFF の差分" id="732468622"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="2つの方式の差分 ── 同意者ON と EU一律OFF" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#21295C;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c2" value="配信作業（2通つくって2回送る）は同じ。違いは「トラッキング同意を管理するか」だけ。" style="text;html=1;fontFamily=Meiryo;align=left;verticalAlign=middle;fontColor=#5A6B87;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c3" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="700" height="640" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;方式2：同意者ON&lt;/b&gt;（旧 F）&lt;br&gt;同意を取り、取れた人だけ計測ON。EU／UKの一部を個人単位で計測できる" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="80" y="126" width="660" height="60" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;必要な部品&lt;/b&gt;&lt;br&gt;L1・L2・L3・S／計測OFF原本／&lt;b&gt;③ トラッキング同意（自作）／配信設定ページの同意項目／撤回導線&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="660" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;運用&lt;/b&gt;&lt;br&gt;通①（L1宛・計測OFF）と通②（L2+L3宛・計測ON）を毎回送る。&lt;br&gt;配信設定ページで同意が入ると L1 → L2 へ自動で移る。&lt;br&gt;Starterではワークフローが使えないため、統制は人手（四眼チェック）に依存。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="80" y="284" width="660" height="92" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;得られるもの&lt;/b&gt;&lt;br&gt;EU／UKの同意者について開封率・個人単位のクリック・リスト抽出・リードスコアリング。&lt;br&gt;非EU／UKは従来どおり全指標。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="660" height="92" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;弱点&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;取得率は実務上1〜3割。L1の大半は恒久的にL1のまま残り、二重配信が定常状態になる。得られる標本も偏る。&lt;br&gt;同意プロパティーの手動更新が事故要因になる。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="80" y="496" width="660" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;向いているケース&lt;/b&gt;&lt;br&gt;EU／UKの開封率や個人単位のクリックを、リードスコアリングやクリック起点のフォローに&lt;b&gt;実際に使っている&lt;/b&gt;場合。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="660" height="112" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=1;absoluteArcSize=1;arcSize=14;html=1;fillColor=#FFFFFF;strokeColor=#10B98A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="700" height="640" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;方式1：EU一律OFF&lt;/b&gt;（旧 F-lite）　&lt;font color=&quot;#065A82&quot;&gt;&lt;b&gt;★推奨の起点&lt;/b&gt;&lt;/font&gt;&lt;br&gt;同意を取らず、EU／UK宛は常に計測OFF" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="126" width="660" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;必要な部品&lt;/b&gt;&lt;br&gt;L1・L3・S／計測OFF原本&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;③ トラッキング同意・L2・同意項目・撤回導線は不要&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="200" width="660" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;運用&lt;/b&gt;&lt;br&gt;通①（L1宛・計測OFF）と通②（L3宛・計測ON）を毎回送る。&lt;br&gt;判定は&lt;b&gt;「EU／UKか否か」だけ&lt;/b&gt;。コンタクトごとの同意状態を維持しない。&lt;br&gt;&lt;b&gt;手動更新が発生しないため、Starterの最大の弱点が消える。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="840" y="284" width="660" height="92" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;得られるもの&lt;/b&gt;&lt;br&gt;EU／UK：&lt;b&gt;UTMによる配信単位のクリック数&lt;/b&gt;（サーバーログ集計）。&lt;br&gt;非EU／UK：従来どおり全指標。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="840" y="390" width="660" height="92" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;弱点&lt;/b&gt;&lt;br&gt;EU／UKの開封率と個人単位のクリック情報を全面的に失う。&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;ただし取得率1〜3割なら、同意者ONでも測れるのは同程度に限られる。&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="496" width="660" height="110" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;向いているケース&lt;/b&gt;&lt;br&gt;EU／UKの開封率を配信効果の比較にしか使っていない場合。URL計測（p1の⑥）でクリック数が代替できるなら、&lt;b&gt;同意管理の仕組み一式を省略できる&lt;/b&gt;。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="840" y="620" width="660" height="112" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;共通の前提（どちらを選ぶ場合も）&lt;/b&gt;　① メール単位OFFで実際にピクセルが消えることの確認（HubSpotサポートへの書面照会＋raw HTML検査）。② 配信同意（ePrivacy 13条）の仕組みは EU一律OFF でも全て必要。③ 1対1営業メールは別問題（全ユーザー一律のOFFしかない）。④ サイト側のCookie同意・米国移転・GDPR 27条代理人は本件と別に必要。" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;arcSize=8;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="60" y="776" width="1460" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="S1. 提案の運用フロー（スライド用）" id="730530277"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;コンタクトの属性&lt;/b&gt;（国／地域・IP国 ＋ 配信登録） → リストの条件式で自動振り分け。&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;判定不能は EU 扱いに倒す&lt;/b&gt;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="12" width="1440" height="62" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;L1｜EU・UK・判定不能&lt;/b&gt;&lt;br&gt;&lt;br&gt;トラッキング同意は取らない" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="104" width="330" height="190" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;通①　計測OFF便&lt;/b&gt;&lt;br&gt;&lt;br&gt;メール単位でトラッキングOFF&lt;br&gt;&lt;b&gt;ビーコンなし・href書き換えなし&lt;/b&gt;&lt;br&gt;全リンクに配信単位のUTMを付与（記録は残す）" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="104" width="520" height="190" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;EU／UK は「送るが測らない」&lt;/b&gt;&lt;br&gt;&lt;br&gt;取れる：LPのフォーム送信数（同意に依存しない）&lt;br&gt;&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;取れない：開封率・クリック数&lt;/b&gt;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="1000" y="104" width="470" height="190" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;L3｜非EU・UK&lt;/b&gt;&lt;br&gt;&lt;br&gt;日本ほか。従来どおり" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="324" width="330" height="190" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;通②　計測ON便&lt;/b&gt;&lt;br&gt;&lt;br&gt;開封・クリックを個人単位で計測&lt;br&gt;UTMも併用&lt;br&gt;&lt;b&gt;原本を複製し、複製側をONに戻す&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="324" width="520" height="190" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;HubSpot のタイムライン&lt;/b&gt;&lt;br&gt;&lt;br&gt;開封・クリック・リスト抽出&lt;br&gt;リードスコアリングが使える" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#F1F5F9;strokeColor=#E2E8F0;fontColor=#30405C;" vertex="1" parent="1"><mxGeometry x="1000" y="324" width="470" height="190" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B87;strokeWidth=2.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B87;strokeWidth=2.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B87;strokeWidth=2.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B87;strokeWidth=2.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="&lt;b&gt;用意するもの&lt;/b&gt;　L1／L3／S（抑止リスト）／「計測OFF原本」の下書き1本／配信登録・処理の法的根拠（HubSpot標準）／&lt;b&gt;LPの同意バナー（CMP）&lt;/b&gt;" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="524" width="1440" height="52" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;作らないもの&lt;/b&gt;　トラッキング同意の&lt;b&gt;チェックボックス・プロパティー・同意済リスト（L2）・撤回導線&lt;/b&gt;　── 維持する同意状態が無いため、手動更新が発生しない" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=15;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=10;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="584" width="1440" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="S2. 既存データの仕分け（スライド用）" id="563069517"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;既存コンタクトを1件ずつ、同意の証跡の質で4つに仕分ける。&lt;/b&gt;　全員一律のリセット＋一斉リパーミッションは行わない" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="1440" height="48" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;バケット1｜有効&lt;/b&gt;&lt;br&gt;取得日時・取得元・文言の証跡が残っている" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="72" width="620" height="96" as="geometry"/></mxCell><mxCell id="c3" value="そのまま配信継続（EU／UKは計測OFF便、日本ほかは計測ON便）" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#EDF6F3;strokeColor=#10B98A;fontColor=#30405C;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="72" width="730" height="96" as="geometry"/></mxCell><mxCell id="c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B87;strokeWidth=2.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;b&gt;バケット2｜別根拠の可能性&lt;/b&gt;&lt;br&gt;既存顧客・取引関係がある（soft opt-in）" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="184" width="620" height="96" as="geometry"/></mxCell><mxCell id="c6" value="&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;法務判断&lt;/b&gt;&lt;/font&gt;のうえ配信継続　── 確認の優先度は最も高い" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="184" width="730" height="96" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B87;strokeWidth=2.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="&lt;b&gt;バケット3｜グレー&lt;/b&gt;&lt;br&gt;証跡が曖昧（取得経路・文言が不明）" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="296" width="620" height="96" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font color=&quot;#A2540A&quot;&gt;&lt;b&gt;法務判断&lt;/b&gt;&lt;/font&gt;。送るなら計測OFF・単発・最小限" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="740" y="296" width="730" height="96" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B87;strokeWidth=2.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;バケット4｜無効&lt;/b&gt;&lt;br&gt;購入リスト・スクレイピング・抱き合わせ同意" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;" vertex="1" parent="1"><mxGeometry x="30" y="408" width="620" height="96" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;S｜配信対象外へ隔離。&lt;/b&gt;メールでの同意依頼もしない（削除ではなく保持）" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#F4F5F7;strokeColor=#D5D9E0;fontColor=#5A6B87;" vertex="1" parent="1"><mxGeometry x="740" y="408" width="730" height="96" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5A6B87;strokeWidth=2.5;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;「一旦リセットして全員に許諾メール」は採らない&lt;/b&gt;　── 同意記録はこちら側の証拠であり、消すと立証手段を自ら失う（不可逆）。配信同意がない相手への依頼メールは、それ自体が新規の違反になり得る（独UWG §7）。再オプトイン率は5〜15%で、リストの大半を失う点も見合わない" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fontFamily=Meiryo;fontSize=14;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fillColor=#FFF6E5;strokeColor=#EFCB93;fontColor=#A2540A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="30" y="524" width="1440" height="68" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>