<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="maintenance-ladder" name="Building Maintenance IoT Ladder">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="建築設備メンテナンスの IoT 分類 — 保全高度化ラダー" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="560" height="30" as="geometry"/>
        </mxCell>

        <!-- Up arrow (diagonal) -->
        <mxCell id="uparrow" value="保全の高度化 →" style="endArrow=classic;html=1;strokeColor=#4472C4;strokeWidth=4;fontSize=13;fontStyle=1;fontColor=#3b5a8a;rounded=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="70" y="600" as="sourcePoint"/>
            <mxPoint x="1050" y="230" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- L1 -->
        <mxCell id="l1" value="L1 遠隔見える化&#xa;&#xa;事後保全の高速化&#xa;稼働状態・警報を遠隔把握&#xa;&#xa;例: ソラカメで盤・機械室を遠隔目視／接点入力(Button Plus)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="230" height="130" as="geometry"/>
        </mxCell>

        <!-- L2 -->
        <mxCell id="l2" value="L2 点検の省力化&#xa;&#xa;時間基準保全 (TBM)&#xa;検針・巡回・法定点検の遠隔化&#xa;&#xa;例: 温湿度/CO2センサー／カメラ遠隔臨検" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="425" width="230" height="130" as="geometry"/>
        </mxCell>

        <!-- L3 -->
        <mxCell id="l3" value="L3 状態基準保全&#xa;&#xa;CBM&#xa;振動・温度・電流をしきい値監視&#xa;&#xa;例: 振動/温度センサー内蔵デバイス／電流(CT)センサー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="340" width="230" height="130" as="geometry"/>
        </mxCell>

        <!-- L4 -->
        <mxCell id="l4" value="L4 予知保全&#xa;&#xa;PdM&#xa;データ蓄積＋分析で故障予兆・余寿命予測&#xa;&#xa;例: L3データ＋クラウドAI分析(Monitron等)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="730" y="255" width="230" height="130" as="geometry"/>
        </mxCell>

        <!-- L5 -->
        <mxCell id="l5" value="L5 エネルギー最適化&#xa;&#xa;省エネ / BEMS 連携&#xa;電力・熱の見える化と制御&#xa;&#xa;例: 電力センサー／室内環境センサー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="900" y="70" width="230" height="130" as="geometry"/>
        </mxCell>

        <!-- Sub-axis panel -->
        <mxCell id="subaxis-group" value="直交する副軸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="430" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="subaxis-cat" value="設備カテゴリ軸：空調熱源／給排水衛生／電気受変電／昇降機／防災" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="390" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subaxis-param" value="監視パラメータ軸：振動・温度・電流電力・圧力・漏水・室内環境(CO2/温湿度)・開閉稼働" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="390" height="40" as="geometry"/>
        </mxCell>

        <!-- Foundation bar: connectivity -->
        <mxCell id="found" value="⑥ 接続レイヤ（すべての土台）— 機械室・地下・屋上など電波が届きにくい閉所が多い → 電池駆動＋ LTE-M / セルラー＋アンテナ選定が要。既設設備は電源不要の無線 IoT ユニットで後付けネット化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="670" width="1090" height="60" as="geometry"/>
        </mxCell>

        <!-- Legend note -->
        <mxCell id="note" value="※ 段が上がるほど「壊れてから直す」から「壊れる前に予測する」へ。IoT の価値は L3〜L5 への移行に集中する。" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="900" height="25" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
