<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="indra-ocr-pipeline" name="Indra OCR Pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Indra OCR の処理の流れ（CPU のみ・ONNX Runtime）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Input -->
        <mxCell id="input" value="入力&lt;br&gt;PDF / 画像&lt;br&gt;(PNG・JPEG ほか)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="230" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- Mode decision -->
        <mxCell id="modecheck" value="テキスト層の&lt;br&gt;チェック&lt;br&gt;(--mode auto)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="210" width="140" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="textlayer" value="テキスト層を読む&lt;br&gt;（デジタル PDF・全文字種）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="170" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="prep" value="向き・傾きの補正&lt;br&gt;レイアウト検出&lt;br&gt;行の検出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="230" width="170" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="classifier" value="行分類器&lt;br&gt;（行ごとに文字種を判定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="230" width="150" height="70" as="geometry"/>
        </mxCell>

        <!-- Recognizers group -->
        <mxCell id="recgroup" value="認識器（4 種類）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="780" y="120" width="190" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="reclatin" value="rec.onnx&lt;br&gt;ラテン・キリル・ギリシャ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="155" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="reccjk" value="rec_cjk.onnx&lt;br&gt;中国語・日本語・韓国語" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="215" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="recrtl" value="rec_rtl.onnx&lt;br&gt;アラビア語・ヘブライ語ほか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="275" width="150" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="recworld" value="rec_world.onnx&lt;br&gt;インド系・タイ語ほか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="335" width="150" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="output" value="出力&lt;br&gt;Markdown / テキスト /&lt;br&gt;JSON（座標・信頼度つき）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="230" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="判定に自信がない行は主認識器（rec.onnx）も読み、&lt;br&gt;信頼度の高い方を採用" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="720" y="430" width="310" height="40" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="input" target="modecheck">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="合格" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="modecheck" target="textlayer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="不合格" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" parent="1" source="modecheck" target="prep">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="prep" target="classifier">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="classifier" target="recgroup">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;" edge="1" parent="1" source="recgroup" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="textlayer" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
