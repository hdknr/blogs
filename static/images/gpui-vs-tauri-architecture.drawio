        <mxCell id="g-e1" style="endArrow=classic;html=1;" edge="1" parent="1" source="g-app" target="g-layout">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="g-gpu" value="GPU API&lt;br&gt;Metal（macOS）/ Direct3D 11（Windows）/ wgpu（Linux）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="300" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g-e2" style="endArrow=classic;html=1;" edge="1" parent="1" source="g-layout" target="g-gpu">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="g-screen" value="画面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="420" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g-e3" value="ピクセル単位で直接描画" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="g-gpu" target="g-screen">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
