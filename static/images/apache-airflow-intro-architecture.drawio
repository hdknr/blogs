<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="airflow-architecture" name="Apache Airflow 3 Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Apache Airflow 3 の主なコンポーネント" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="0" width="460" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="user" value="利用者&lt;br&gt;（ブラウザ / CLI）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="&lt;b&gt;API server&lt;/b&gt;&lt;br&gt;UI と REST API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="70" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="scheduler" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;実行時刻と依存を判定&lt;br&gt;（Executor は Scheduler の設定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="60" width="210" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="db" value="&lt;b&gt;メタデータ DB&lt;/b&gt;&lt;br&gt;DAG・実行履歴・&lt;br&gt;タスクの状態" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="180" width="170" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="dagfiles" value="&lt;b&gt;DAG ファイル&lt;/b&gt;&lt;br&gt;（Python コード）" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="330" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="dagproc" value="&lt;b&gt;Dag processor&lt;/b&gt;&lt;br&gt;DAG を解析して保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="335" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="workers" value="&lt;b&gt;ワーカー（Workers）&lt;/b&gt;&lt;br&gt;タスクを実際に実行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="335" width="210" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="操作・監視" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="user" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="api" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="読み込み" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="dagfiles" target="dagproc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="保存" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="dagproc" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="scheduler" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="タスクを投入" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="scheduler" target="workers">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="状態を報告（Execution API）" style="endArrow=classic;html=1;strokeColor=#b85450;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="workers" target="api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1030" y="365"/>
              <mxPoint x="1030" y="40"/>
              <mxPoint x="360" y="40"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
