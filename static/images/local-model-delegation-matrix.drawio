<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="local-model-delegation-matrix" name="Local Model Delegation Matrix">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="委譲の判断軸 — 高ボリューム・低判断を出す / 低ボリューム・高判断を残す" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="120" y="24" width="760" height="30" as="geometry"/>
        </mxCell>

        <!-- Quadrant: high volume / low judgment -->
        <mxCell id="q-hv-lj" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="100" width="340" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="q-hv-lj-head" value="◎ 小さいモデルに委譲" style="text;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fontColor=#3f6f2f;" vertex="1" parent="1">
          <mxGeometry x="200" y="115" width="300" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="q-hv-lj-body" value="・長い設計ドキュメントの要約&#xa;・失敗ログからの原因箇所の抽出&#xa;・大量ファイルの API 表面の機械的抽出&#xa;&#xa;共通点: 入力が巨大で、判断が要らない&#xa;= 証拠の圧縮" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="150" width="300" height="175" as="geometry"/>
        </mxCell>

        <!-- Quadrant: high volume / high judgment -->
        <mxCell id="q-hv-hj" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="340" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="q-hv-hj-head" value="✗ 上位モデルが持つ" style="text;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fontColor=#93312e;" vertex="1" parent="1">
          <mxGeometry x="540" y="115" width="300" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="q-hv-hj-body" value="・敵対的レビュー（差分全体を読む）&#xa;・アーキテクチャ上の設計判断&#xa;&#xa;量は多いが、結論の質が成果を決める。&#xa;安く済ませると後段が全部やり直しになる" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="150" width="300" height="175" as="geometry"/>
        </mxCell>

        <!-- Quadrant: low volume / low judgment -->
        <mxCell id="q-lv-lj" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="180" y="340" width="340" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="q-lv-lj-head" value="△ そもそも LLM 不要" style="text;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fontColor=#9a7d21;" vertex="1" parent="1">
          <mxGeometry x="200" y="355" width="300" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="q-lv-lj-body" value="・規約遵守チェック → grep&#xa;・pass / fail の判定 → exit code&#xa;・失敗テスト名の抽出 → junitxml + jq&#xa;&#xa;コスト 0・幻覚リスク 0。&#xa;安いモデルを検討する前にここを潰す" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="200" y="390" width="300" height="175" as="geometry"/>
        </mxCell>

        <!-- Quadrant: low volume / high judgment -->
        <mxCell id="q-lv-hj" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="340" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="q-lv-hj-head" value="✗ 最も委譲してはいけない" style="text;html=1;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;fontColor=#93312e;" vertex="1" parent="1">
          <mxGeometry x="540" y="355" width="300" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="q-lv-hj-body" value="・レビュー指摘の反映（diff は小さい）&#xa;・受入基準を満たしたかの判定&#xa;・ループの停止条件&#xa;&#xa;節約額が最小で、事故率が最大。&#xa;= 証拠からの結論" style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="390" width="300" height="175" as="geometry"/>
        </mxCell>

        <!-- Y axis -->
        <mxCell id="y-axis" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="150" y="580" as="sourcePoint"/>
            <mxPoint x="150" y="100" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="y-label" value="トークン量（入力＋生成）" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="95" y="270" width="30" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="y-hi" value="大" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="125" y="105" width="24" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="y-lo" value="小" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="125" y="552" width="24" height="20" as="geometry"/>
        </mxCell>

        <!-- X axis -->
        <mxCell id="x-axis" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="180" y="610" as="sourcePoint"/>
            <mxPoint x="860" y="610" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="x-label" value="必要な判断の重さ" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="160" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="x-lo" value="低" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="186" y="615" width="24" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="x-hi" value="高" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="828" y="615" width="24" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
