<mxfile host="app.diagrams.net">
  <diagram name="Claude Codeの4種類のループ">
    <mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Claude Codeの4種類のループ設計" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="10" width="420" height="30" as="geometry" />
        </mxCell>

        <mxCell id="col1" value="Turn-based" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col1t" value="トリガー: ユーザーの手動プロンプト" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="col1s" value="停止条件: Claudeが完了 or 追加情報が必要と判断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col1u" value="用途: 探索・単発の短いタスク" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="arrow1" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;" edge="1" source="col1" target="col2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="col2" value="Goal-based（/goal）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="60" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col2t" value="トリガー: 手動プロンプト＋完了条件の指定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="120" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="col2s" value="停止条件: 評価モデルがゴール達成を確認 or 最大試行回数到達" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="170" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col2u" value="用途: 検証可能なゴールがあるタスク" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="260" y="230" width="180" height="40" as="geometry" />
        </mxCell>

        <mxCell id="arrow2" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;" edge="1" source="col2" target="col3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="col3" value="Time-based（/loop, /schedule）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col3t" value="トリガー: 一定間隔での定期実行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="120" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="col3s" value="停止条件: ユーザーが手動キャンセル or 作業完了（PRマージ等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="170" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col3u" value="用途: 反復作業・外部システム連携（/loopはローカル、/scheduleはクラウド）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="480" y="230" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="arrow3" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;" edge="1" source="col3" target="col4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="col4" value="Proactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="60" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="col4t" value="トリガー: イベント or スケジュール（人が介在しない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="col4s" value="停止条件: 各タスクはゴール達成で終了、ルーチン自体はオフにするまで継続" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="170" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="col4u" value="用途: 定型化された反復業務（バグ対応・移行・依存関係更新など）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="240" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="bottomnote" value="委譲の段階が進むほど、人間が手放す範囲が「チェック → 停止条件 → トリガー → プロンプトそのもの」へと広がる" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="120" y="320" width="660" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
