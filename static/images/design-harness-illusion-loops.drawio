        <mxCell id="rUser" value="ユーザーがどう評価し、受け入れたかを観測" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
