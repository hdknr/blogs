<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="design-harness-loops" name="Design Harness Loops">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="評価ループに「ユーザー」はいるか" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Left group -->
        <mxCell id="grpLeft" value="デザインハーネス型の評価ループ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="500" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="lRules" value="ルール・デザインシステム&lt;br&gt;（Markdown で記述）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="110" width="240" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lGen" value="AI・エンジニア・PM が生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="205" width="240" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lEval" value="Linter・AI がルール準拠を評価&lt;br&gt;デザイナーは最後にチェック" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="300" width="240" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lRel" value="「90 点」でリリース" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="395" width="240" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="lNote" value="ユーザーの評価がループの外にある&lt;br&gt;→ 実際の評価は 70 点かもしれない" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;fontStyle=1;" vertex="1" parent="1">
