        <mxCell id="eL2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="lGen" target="lEval">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eL3" value="合格" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=11;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="lEval" target="lRel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eL4" value="不合格" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=11;labelBackgroundColor=#f5f5f5;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="lEval" target="lGen">
          <mxGeometry relative="1" as="geometry">
