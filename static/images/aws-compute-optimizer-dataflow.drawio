<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="aws-compute-optimizer-dataflow" name="AWS Compute Optimizer Data Flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="AWS Compute Optimizer が推奨を出すまでのデータの流れ" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="メトリクスの蓄積 → ML 分析 → findings と削減額（料金情報は Cost Explorer / Cost Optimization Hub 由来）" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="140" y="50" width="900" height="24" as="geometry"/>
        </mxCell>

        <!-- Stage labels -->
        <mxCell id="stage1" value="① 分析対象リソース" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="stage2" value="② メトリクスの供給元" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="320" y="96" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="stage3" value="③ Compute Optimizer" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="600" y="96" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="stage4" value="④ 出力される推奨" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="880" y="96" width="260" height="20" as="geometry"/>
        </mxCell>

        <!-- Resources -->
        <mxCell id="res" value="EC2 インスタンス&#xa;EC2 Auto Scaling グループ&#xa;EBS ボリューム&#xa;Lambda 関数&#xa;ECS サービス（Fargate）&#xa;Aurora / RDS（MySQL・PostgreSQL）&#xa;Microsoft SQL Server ライセンス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;fontColor=#1f3864;" vertex="1" parent="1">
          <mxGeometry x="40" y="124" width="240" height="176" as="geometry"/>
        </mxCell>

        <!-- CloudWatch -->
        <mxCell id="cw" value="CloudWatch メトリクス&#xa;&#xa;CPU / ネットワーク / ディスク・EBS の&#xa;IOPS とスループット" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;fontColor=#274e13;" vertex="1" parent="1">
          <mxGeometry x="320" y="124" width="240" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="cwagent" value="統合 CloudWatch Agent（別途導入）&#xa;&#xa;メモリ使用率 / GPU 使用率&#xa;※ 入れないとメモリ観点の推奨は出ない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;fontColor=#7f3f00;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="320" y="244" width="240" height="104" as="geometry"/>
        </mxCell>

        <!-- Compute Optimizer engine -->
        <mxCell id="co" value="機械学習による使用率分析&#xa;&#xa;ルックバック期間&#xa;・14 日（デフォルト・無料）&#xa;・32 日（無料）&#xa;・93 日（拡張インフラメトリクス＝有料）&#xa;&#xa;推奨は 1 日 1 回更新&#xa;最低 30 時間分のメトリクスが必要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;fontColor=#4b2e5e;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="124" width="240" height="224" as="geometry"/>
        </mxCell>

        <!-- Outputs -->
        <mxCell id="out1" value="サイズ適正化推奨&#xa;&#xa;Finding：Over-provisioned /&#xa;Under-provisioned / Optimized&#xa;Finding reasons（CPU・メモリ・&#xa;ネットワーク・EBS など）&#xa;パフォーマンスリスク（5 段階）&#xa;移行の労力・プラットフォーム差異" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;fontColor=#7a2622;" vertex="1" parent="1">
          <mxGeometry x="880" y="124" width="260" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="out2" value="アイドルリソース推奨&#xa;&#xa;停止・削除の候補を提示。EC2 / ASG /&#xa;EBS / ECS / Aurora・RDS / NAT Gateway /&#xa;DynamoDB / ElastiCache / MemoryDB /&#xa;DocumentDB / WorkSpaces /&#xa;SageMaker エンドポイント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=14;verticalAlign=middle;fontColor=#7f6000;" vertex="1" parent="1">
          <mxGeometry x="880" y="292" width="260" height="150" as="geometry"/>
        </mxCell>

        <!-- Pricing sources -->
        <mxCell id="pricing" value="Cost Explorer（有効化が必須）／Cost Optimization Hub＝コスト最適化ハブ（推奨）&#xa;現在と推奨構成の料金差・推定月間削減額を算出。コスト最適化ハブを有効にすると&#xa;Savings Plans / RI の割引を織り込んだ削減額になる（節約額見積もりモード）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#444444;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="310" y="398" width="560" height="84" as="geometry"/>
        </mxCell>

        <!-- Opt-in note -->
        <mxCell id="optin" value="前提：オプトインが必要&#xa;aws compute-optimizer&#xa;update-enrollment-status&#xa;--status Active&#xa;&#xa;Organizations の管理アカウントなら&#xa;--include-member-accounts で&#xa;全メンバーアカウントを一括オプトイン&#xa;（全機能有効化が前提）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=middle;fontColor=#1f3864;dashed=1;dashPattern=6 4;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="240" height="150" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="res" target="cw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="cw" target="co">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1" source="cwagent" target="co">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="co" target="out1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="co" target="out2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a6" value="料金情報" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontSize=11;fontColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="pricing" target="co">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Footnote -->
        <mxCell id="footnote" value="※ Lambda は CloudWatch メトリクス不要（過去 14 日で 50 回以上の呼び出しと、設定メモリ 1,792 MB 以下が条件）。EBS ボリュームは実行中インスタンスに 30 時間以上連続アタッチされている必要がある。" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1100" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
