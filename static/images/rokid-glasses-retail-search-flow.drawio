<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="rokid-retail-search" name="Rokid Retail Shelf Search Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="売り場検索アプリ ― 常時認識をやめて「聞かれたときだけ」動かす" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="640" height="30" as="geometry"/>
        </mxCell>

        <!-- Lane labels -->
        <mxCell id="lane-glass" value="グラス" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="70" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lane-app" value="AIUI アプリ" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="30" y="280" width="70" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lane-cloud" value="店舗システム" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="30" y="440" width="70" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="① 音声で起動&#xa;「〇〇はどこ？」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="110" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s1n" value="呼ばれるまでカメラも通信も止めておく&#xa;＝ 210mAh を持たせる唯一の方法" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="110" y="176" width="190" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="② 商品名を照会&#xa;fetch (Internet 権限)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="270" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2n" value="署名が要る API なら&#xa;HMAC は自前実装" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="350" y="336" width="170" height="34" as="geometry"/>
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="s3" value="③ 商品マスタ / 在庫&#xa;棚番号・通路・在庫数を返す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="430" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3n" value="既存の基幹システムに&#xa;REST の口があるかが実現性を決める" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="570" y="496" width="220" height="40" as="geometry"/>
        </mxCell>

        <!-- Step 4 -->
        <mxCell id="s4" value="④ 表示を最小化&#xa;通路 / 棚段 / 在庫の 3 行だけ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="270" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Step 5 -->
        <mxCell id="s5" value="⑤ 視界に表示 ＋ 読み上げ&#xa;スワイプで次候補" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="110" width="170" height="60" as="geometry"/>
        </mxCell>

        <!-- Screen mock -->
        <mxCell id="mock" value="A-7 通路　中段&#xa;めんつゆ 2倍濃縮&#xa;在庫 12" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1a1a1a;strokeColor=#82b366;fontSize=13;fontColor=#7ee787;fontFamily=Courier New;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="430" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="mockn" value="実際に出せる情報量はこの程度" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="990" y="516" width="190" height="20" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2.5;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2.5;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2.5;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2.5;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5m" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="s5" target="mock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="s4n" value="グリーン単色・視界の一部&#xa;地図もサムネイルも載らない" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#b85450;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="830" y="336" width="200" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="s5n" value="読み上げは止められない&#xa;＝ 1 文を短く作る" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#b85450;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="1000" y="176" width="170" height="34" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
