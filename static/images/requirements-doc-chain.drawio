        <mxCell id="note" value="AI で実装は安くなっても、要件の読み違いは安くならない" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;fontStyle=2;" vertex="1" parent="1">
