<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="requirements-doc-chain" name="Requirements Doc Chain">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="人間が持つ成果物の順番 ― 要件定義書からコードまで鎖をつなぐ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="human-group" value="人間が持つ（上流ほど重く）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="940" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="req" value="&lt;b&gt;① 要件定義書&lt;/b&gt;&lt;br&gt;誰の課題か・何を良くするか&lt;br&gt;使わない場面・破れない制約" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=3;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ac" value="&lt;b&gt;② 受入基準&lt;/b&gt;&lt;br&gt;何をもって成功とするか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="test" value="&lt;b&gt;③ テスト&lt;/b&gt;&lt;br&gt;受入基準を&lt;br&gt;機械で確かめる形に" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="130" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="code" value="&lt;b&gt;④ コード&lt;/b&gt;&lt;br&gt;テストを通す実装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="140" width="200" height="60" as="geometry"/>
