        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="ac" target="test">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="test" target="code">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="thin" value="&lt;b&gt;詳細仕様書・実装作業&lt;/b&gt;&lt;br&gt;鎖がつながっていれば薄くしてよい&lt;br&gt;（AI エージェントに任せる）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;dashed=1;" vertex="1" parent="1">
