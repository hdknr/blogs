<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="distributed-spa-agent-tools" name="AI agent uses app tools without credentials">
    <mxGraphModel dx="1200" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AI エージェントにはツールを渡し、鍵は渡さない" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="10" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Heads -->
        <mxCell id="h0" value="利用者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="110" height="45" as="geometry"/></mxCell>
        <mxCell id="h1" value="AI エージェント&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;鍵を持たない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcc99;strokeColor=#cc6600;strokeWidth=2;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="180" y="55" width="150" height="45" as="geometry"/></mxCell>
        <mxCell id="h2" value="デスクトップアプリ&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;MCP サーバー + 確認画面&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="55" width="180" height="45" as="geometry"/></mxCell>
        <mxCell id="h3" value="API クライアント&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;トークンはここだけ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="55" width="160" height="45" as="geometry"/></mxCell>
        <mxCell id="h4" value="業務 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="55" width="140" height="45" as="geometry"/></mxCell>

        <!-- Lifelines -->
        <mxCell id="l0" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="75" y="100" as="sourcePoint"/><mxPoint x="75" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l1" style="endArrow=none;dashed=1;html=1;strokeColor=#cc6600;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="100" as="sourcePoint"/><mxPoint x="255" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l2" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="100" as="sourcePoint"/><mxPoint x="510" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l3" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="100" as="sourcePoint"/><mxPoint x="740" y="680" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="l4" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="100" as="sourcePoint"/><mxPoint x="960" y="680" as="targetPoint"/></mxGeometry></mxCell>

        <!-- Credential boundary -->
        <mxCell id="boundary" value="鍵の境界（ここから右にだけトークンがある）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#d6b656;dashed=1;strokeWidth=2;fontSize=10;fontColor=#b38f00;align=right;verticalAlign=top;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="410" height="560" as="geometry"/></mxCell>

        <mxCell id="m1" value="指示" style="html=1;endArrow=block;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="75" y="145" as="sourcePoint"/><mxPoint x="255" y="145" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m1n" value="&lt;font style=&quot;font-size:11px&quot;&gt;「先月分の未入金を洗い出して督促状を作って」&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="270" y="128" width="330" height="30" as="geometry"/></mxCell>

        <!-- read tool -->
        <mxCell id="m2" value="① 参照ツール: list_unpaid(month)" style="html=1;endArrow=block;strokeColor=#cc6600;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="190" as="sourcePoint"/><mxPoint x="510" y="190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2b" value="" style="html=1;endArrow=block;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="190" as="sourcePoint"/><mxPoint x="740" y="190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2c" value="利用者のトークンで GET" style="html=1;endArrow=block;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="190" as="sourcePoint"/><mxPoint x="960" y="190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="結果（データだけ。トークンは含まない）" style="html=1;endArrow=block;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="235" as="sourcePoint"/><mxPoint x="255" y="235" as="targetPoint"/></mxGeometry></mxCell>

        <!-- write tool with confirmation -->
        <mxCell id="m4" value="② 更新ツール: issue_reminders(ids)" style="html=1;endArrow=block;strokeColor=#cc6600;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="300" as="sourcePoint"/><mxPoint x="510" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="confirm" value="&lt;b&gt;確認画面&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;「督促状を 12 件発行します」&lt;br&gt;対象一覧と件数を表示&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="325" width="180" height="60" as="geometry"/></mxCell>
        <mxCell id="m5" value="承認（アプリの画面で）" style="html=1;endArrow=block;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="75" y="410" as="sourcePoint"/><mxPoint x="510" y="410" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="Saga ランナー / 帳票レンダラで実行" style="html=1;endArrow=block;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="460" as="sourcePoint"/><mxPoint x="740" y="460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" value="冪等キー付きで POST&lt;br&gt;via: agent を付ける" style="html=1;endArrow=block;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="460" as="sourcePoint"/><mxPoint x="960" y="460" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="authz" value="&lt;font style=&quot;font-size:10px&quot;&gt;利用者の権限で認可を検査&lt;br&gt;監査ログに記録&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="880" y="490" width="160" height="45" as="geometry"/></mxCell>
        <mxCell id="m8" value="結果（発行済み 12 件）" style="html=1;endArrow=block;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="570" as="sourcePoint"/><mxPoint x="255" y="570" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="報告" style="html=1;endArrow=block;dashed=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="620" as="sourcePoint"/><mxPoint x="75" y="620" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
