<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="reuse-stt" name="RE-USE STT pipeline">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="録音 → 音声強調 → 文字起こし のパイプライン" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="rec" value="&lt;b&gt;録音&lt;/b&gt;&lt;br&gt;ボイスレコーダー&lt;br&gt;スマートリング&lt;br&gt;会議の録音" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="noisy" value="劣化した音声&lt;br&gt;雑音・残響・クリッピング&lt;br&gt;帯域制限・コーデック歪み" style="text;html=1;fontSize=11;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="reuse" value="&lt;b&gt;RE-USE&lt;/b&gt;&lt;br&gt;音声強調（USE）&lt;br&gt;9.6M パラメータ&lt;br&gt;8〜48kHz mono wav" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="reusenote" value="主話者を残し、&lt;br&gt;重なった他の話者は抑える" style="text;html=1;fontSize=11;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="stt" value="&lt;b&gt;STT&lt;/b&gt;&lt;br&gt;音声認識&lt;br&gt;（Whisper など）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="180" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="out" value="&lt;b&gt;テキスト&lt;/b&gt;&lt;br&gt;メモ・議事録&lt;br&gt;LLM への入力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="110" width="160" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="rec" target="reuse">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="reuse" target="stt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="stt" target="out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="前処理を 1 段挟むだけで、STT 側のモデルは変えずに入力の質を上げる" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="310" width="700" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
