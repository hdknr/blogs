  <diagram id="port-exposure" name="port-exposure">
    <mxGraphModel dx="1400" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="root0" />
        <mxCell id="layer1" parent="root0" />

        <mxCell id="title" value="分類を「パブリック→プライベート」にした瞬間、開いたのは 445 だけではなかった" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="layer1">
          <mxGeometry x="40" y="22" width="1180" height="32" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="セキュリティ製品のネットワーク分類は、ポート単位のスイッチではない。1 つのアプリを通すために緩めると、そのマシンで待ち受けている全部が同時に露出する。" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1A1A1A;fontColor=#5A5A5A;" vertex="1" parent="layer1">
          <mxGeometry x="40" y="58" width="1210" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hName" value="このマシンが待ち受けているポート" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#F5F5F5;strokeColor=#8A8A8A;fontColor=#4A4A4A;" vertex="1" parent="layer1">
          <mxGeometry x="50" y="108" width="240" height="76" as="geometry" />
        </mxCell>
        <mxCell id="hA" value="① 分類 = パブリック&#xa;（当初）" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#E8EEF7;strokeColor=#4A6FA5;fontColor=#1A1A1A;" vertex="1" parent="layer1">
          <mxGeometry x="310" y="108" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="hB" value="② 分類 = プライベート&#xa;（共有を通した直後）" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#FDE7E7;strokeColor=#C62828;fontColor=#B71C1C;" vertex="1" parent="layer1">
          <mxGeometry x="630" y="108" width="300" height="76" as="geometry" />
        </mxCell>
        <mxCell id="hC" value="③ プライベート&#xa;＋ トラフィックルールで遮断" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;fillColor=#E6F4EA;strokeColor=#2E7D32;fontColor=#1B5E20;" vertex="1" parent="layer1">
          <mxGeometry x="950" y="108" width="300" height="76" as="geometry" />
