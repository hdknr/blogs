        <mxCell id="noserver" value="中継サーバーは&#xa;立てなくてよい" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#d79b00;whiteSpace=wrap;" vertex="1" parent="1">
