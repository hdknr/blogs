<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="hybrid" name="Hybrid data inquiry chatbot">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="ハイブリッド運用：利用者の役割でツール呼び出しと Text-to-SQL を使い分ける" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="130" y="15" width="840" height="30" as="geometry"/>
        </mxCell>

        <!-- Users -->
        <mxCell id="u1" value="一般の利用者&lt;br&gt;（事業所の担当者）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="管理本部・監査担当&lt;br&gt;（全社データを&lt;br&gt;閲覧できる）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="30" y="330" width="150" height="60" as="geometry"/>
        </mxCell>

        <!-- Router -->
        <mxCell id="router" value="&lt;b&gt;振り分け（アプリ）&lt;/b&gt;&lt;br&gt;ログイン中の利用者の&lt;br&gt;役割で決める&lt;br&gt;（LLM には決めさせない）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="220" y="185" width="200" height="130" as="geometry"/>
        </mxCell>

        <!-- Tool path -->
        <mxCell id="tool-group" value="ツール呼び出し（全員が使う）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="460" y="60" width="610" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="t-llm" value="LLM&lt;br&gt;ツールと引数を選ぶ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="110" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="t-tools" value="照会ツール&lt;br&gt;利用者の権限で&lt;br&gt;既存の業務ロジック" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="105" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t-db" value="業務 DB（正本）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="t-note" value="定型の質問に、画面と同じ範囲・同じ計算で答える" style="text;html=1;fontSize=10;align=left;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="480" y="190" width="400" height="20" as="geometry"/>
        </mxCell>

        <!-- SQL path -->
        <mxCell id="sql-group" value="Text-to-SQL（許可された役割だけ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="460" y="270" width="610" height="190" as="geometry"/>
        </mxCell>
        <mxCell id="s-llm" value="Text-to-SQL&lt;br&gt;（Auto Ontology など）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="480" y="320" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s-check" value="SQL を利用者に提示&lt;br&gt;タイムアウト・件数上限" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="320" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s-db" value="読み取り専用レプリカ&lt;br&gt;／分析用 DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="310" width="150" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s-note" value="横断集計・例外抽出・突合など、ツールにない問い合わせ。結果は「調査用の数字」として扱う" style="text;html=1;fontSize=10;align=left;fontColor=#666666;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="480" y="395" width="560" height="20" as="geometry"/>
        </mxCell>

        <!-- Promotion -->
        <mxCell id="promote" value="頻出の SQL → 検証してツールや SQL 属性として登録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="460" y="490" width="380" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="audit" value="監査ログ：質問・ツール・SQL を記録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="860" y="490" width="210" height="36" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1" target="router"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u2" target="router"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="全員" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;fontSize=10;exitX=0.5;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="router" target="t-llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="140"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" value="許可された役割で&lt;br&gt;ツールで答えられないとき" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;endArrow=block;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="router" target="s-llm"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="350"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="t-llm" target="t-tools"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="t-tools" target="t-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="s-llm" target="s-check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="読み取り専用&lt;br&gt;DB ユーザー" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;fontSize=10;" edge="1" parent="1" source="s-check" target="s-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d6b656;endArrow=block;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="sql-group" target="promote"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
