<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="tlc-triage" name="TLC performance triage">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="TLC が遅いときの切り分け" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="TLC の出力を確認&lt;br&gt;（Distinct states・経過時間）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="240" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="q1" value="Distinct states が&lt;br&gt;多すぎる？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;モデリングを見直す&lt;/b&gt;&lt;br&gt;対称性（SYMMETRY）&lt;br&gt;状態の制約（CONSTRAINT）&lt;br&gt;アクションをまとめる&lt;br&gt;変数の削減・抽象化 / VIEW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="155" width="260" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="q2" value="Liveness（時相論理の&lt;br&gt;性質）を検査している？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;修正中は INVARIANT だけ&lt;/b&gt;&lt;br&gt;PROPERTY は最終確認で回す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="330" width="260" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="a3" value="&lt;b&gt;実行環境を調整する&lt;/b&gt;&lt;br&gt;-workers でマルチスレッド&lt;br&gt;-Xmx でヒープを増やす&lt;br&gt;-fpmem で指紋用メモリを確保" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="260" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="a4" value="&lt;b&gt;それでも終わらないとき&lt;/b&gt;&lt;br&gt;小さい構成で回す（パラメータは CI で拡大）&lt;br&gt;シミュレーションモード（-simulate）&lt;br&gt;Apalache（SMT ベース）を併用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="600" width="320" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="start" target="q1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="はい" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="a1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q1" target="q2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="はい" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="a2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="いいえ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="q2" target="a3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="a1" target="a4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="205"/>
              <mxPoint x="760" y="645"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="a2" target="a4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="530" y="600"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#999999;dashed=1;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="645"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
