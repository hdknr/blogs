        <mxCell id="concl-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="50" y="440" width="1160" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="concl-title" value="この表が意味すること" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="70" y="452" width="400" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="concl-1" value="USB / DC 給電なら 1 分アラートは妥当&#10;&#10;出荷時の 10 秒に対して閾値 1 分は 6 倍。&#10;取りこぼし 1 回では鳴らない、良い比率。&#10;セッションも張られ続けるので、この構成で&#10;Deleted → Created が出ているなら&#10;無通信タイマーではない別の原因。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="482" width="365" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="concl-2" value="電池運用は周期を延ばすしかない&#10;&#10;出荷時 10 秒のままでは約 33 分で電池が終わる。&#10;必要な稼働日数から周期を逆算すると、&#10;実用域は必ず無通信タイマー 1 時間を超える。&#10;つまり電池を選んだ時点で&#10;Deleted → Created は正常な姿になる。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="450" y="482" width="365" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="concl-3" value="閾値は「周期の倍数」で決める&#10;&#10;絶対時間で決めるのではなく、周期の 2〜6 倍。&#10;検知遅延は原理的に周期より短くできない。&#10;24 時間周期なら故障を知るのは最短 48 時間後。&#10;それで困る要求は、死活監視ではなく&#10;接点変化送信（即時）で拾う。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="482" width="365" height="160" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
