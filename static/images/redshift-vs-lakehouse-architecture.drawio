        <mxCell id="lh-spark" value="Spark&lt;br&gt;（Glue・EMR）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="105" width="110" height="40" as="geometry"/>
