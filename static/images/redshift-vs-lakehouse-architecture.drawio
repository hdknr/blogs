        </mxCell>
        <mxCell id="lh-cat" value="&lt;b&gt;カタログ&lt;/b&gt;&lt;br&gt;AWS Glue Data Catalog / S3 Tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
