<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="redshift-vs-lakehouse" name="Redshift vs Lakehouse">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="DWH 一体型とレイクハウス" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Left: Redshift native -->
        <mxCell id="rs-group" value="Redshift にデータを持つ（DWH 一体型）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="380" height="510" as="geometry"/>
        </mxCell>
        <mxCell id="rs-bi" value="BI・アプリケーション" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="120" y="105" width="200" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="rs-box" value="Amazon Redshift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="320" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="rs-compute" value="計算&lt;br&gt;（Serverless の RPU / ノード）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="85" y="225" width="270" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rs-catalog" value="テーブル管理（Redshift 内部のカタログ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="85" y="295" width="270" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rs-rms" value="Redshift マネージドストレージ（RMS）&lt;br&gt;Redshift 内部の形式で保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="85" y="365" width="270" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="rs-note" value="すべてが 1 つの製品の中にある。&lt;br&gt;読み書きは Redshift 経由" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="320" height="50" as="geometry"/>
        </mxCell>

        <!-- Right: Lakehouse -->
        <mxCell id="lh-group" value="S3 にデータを持つ（レイクハウス）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="450" y="60" width="520" height="510" as="geometry"/>
        </mxCell>
        <mxCell id="lh-rs" value="Redshift" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="105" width="110" height="40" as="geometry"/>
