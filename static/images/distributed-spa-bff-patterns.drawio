<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="distributed-spa-bff-patterns" name="BFF patterns">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1140" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="BFF の 3 つの置き方" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="370" y="10" width="400" height="30" as="geometry"/>
        </mxCell>

        <!-- Column A: no BFF -->
        <mxCell id="ga" value="① BFF なし" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="20" y="55" width="340" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="a-spa" value="&lt;b&gt;ブラウザの SPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;トークンを JavaScript で持つ&lt;br&gt;画面ごとに何本も API を呼ぶ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="100" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a-api1" value="受注 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="a-api2" value="在庫 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="145" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="a-api3" value="請求 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="a-e1" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="a-spa" target="a-api1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e2" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="a-spa" target="a-api2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e3" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="a-spa" target="a-api3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-cors" value="&lt;font style=&quot;font-size:10px&quot;&gt;オリジンごとに CORS&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="120" y="225" width="140" height="25" as="geometry"/></mxCell>
        <mxCell id="a-note" value="&lt;font style=&quot;font-size:11px&quot;&gt;・画面の都合が汎用 API に入り込む&lt;br&gt;・XSS でトークンを抜かれやすい&lt;br&gt;・往復が多く、画面が遅い&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="45" y="380" width="290" height="70" as="geometry"/></mxCell>

        <!-- Column B: server-side BFF -->
        <mxCell id="gb" value="② サーバー側の BFF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="400" y="55" width="340" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="b-spa" value="&lt;b&gt;ブラウザの SPA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;HttpOnly の Cookie だけを持つ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b-bff" value="&lt;b&gt;BFF&lt;/b&gt;（サーバー）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;トークンを保持・集約・画面用に整形&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b-api1" value="受注 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="b-api2" value="在庫 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="525" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="b-api3" value="請求 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="630" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="b-e0" value="&lt;font style=&quot;font-size:10px&quot;&gt;1 回で取得&lt;/font&gt;" style="html=1;endArrow=block;strokeColor=#666666;labelBackgroundColor=#fafafa;" edge="1" parent="1" source="b-spa" target="b-bff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e1" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="b-bff" target="b-api1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e2" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="b-bff" target="b-api2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e3" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="b-bff" target="b-api3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-note" value="&lt;font style=&quot;font-size:11px&quot;&gt;・画面の都合は BFF が吸収する&lt;br&gt;・トークンはブラウザに渡らない&lt;br&gt;・BFF というサーバーの運用が増える&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="425" y="380" width="290" height="70" as="geometry"/></mxCell>

        <!-- Column C: in-app BFF -->
        <mxCell id="gc" value="③ アプリ内の BFF（この記事の方針 3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4fa;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="55" width="340" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="c-app" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="815" y="90" width="270" height="185" as="geometry"/>
        </mxCell>
        <mxCell id="c-applabel" value="&lt;font style=&quot;font-size:10px&quot;&gt;デスクトップアプリ&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="825" y="92" width="150" height="20" as="geometry"/></mxCell>
        <mxCell id="c-ui" value="&lt;b&gt;業務画面&lt;/b&gt;（WebView）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="115" width="240" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="c-bff" value="&lt;b&gt;API クライアント&lt;/b&gt;（アプリ内 BFF）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;トークンは OS のキーチェーン・集約・整形&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="200" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="c-api1" value="受注 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="c-api2" value="在庫 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="905" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="c-api3" value="請求 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="90" height="40" as="geometry"/></mxCell>
        <mxCell id="c-e0" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="c-ui" target="c-bff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e1" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="c-bff" target="c-api1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e2" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="c-bff" target="c-api2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-e3" value="" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="c-bff" target="c-api3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c-note" value="&lt;font style=&quot;font-size:11px&quot;&gt;・BFF の役割はそのまま、置き場所がアプリの中へ&lt;br&gt;・サーバー側に BFF の運用がない&lt;br&gt;・CORS はそもそも関係ない（ネイティブの HTTP）&lt;br&gt;・認可は各業務 API が行う&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="805" y="380" width="300" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
