<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="pmlp" name="Perceptron and MLP">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="パーセプトロン（1 層）と多層パーセプトロン" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Left: perceptron -->
        <mxCell id="pg" value="パーセプトロン（レッスン 03）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="450" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="px1" value="x₁" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="44" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="px2" value="x₂" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="190" width="44" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="px3" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="44" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="pbias" value="バイアス用に&lt;br&gt;常に 1 の入力" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="45" y="305" width="90" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="psum" value="Σ wᵢxᵢ" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="200" y="180" width="70" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="pstep" value="ステップ関数&lt;br&gt;+1 / −1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="187" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="pe1" value="w₁" style="endArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="px1" target="psum"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe2" value="w₂" style="endArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="px2" target="psum"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe3" value="w₃" style="endArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=11;" edge="1" parent="1" source="px3" target="psum"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pe4" value="" style="endArrow=classic;html=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="psum" target="pstep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="pnote" value="境界は wᵀx = 0 の直線（超平面）1 本だけ&lt;br&gt;&lt;br&gt;○ 0 と 1 の手書き数字：99.75%&lt;br&gt;× XOR：どう引いても 4 点中 3 点（75%）まで" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="360" width="400" height="95" as="geometry"/>
        </mxCell>

        <!-- Right: MLP -->
        <mxCell id="mg" value="多層パーセプトロン（レッスン 04）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="450" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="m1" value="Linear&lt;br&gt;2 → 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="185" width="80" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="tanh&lt;br&gt;（非線形）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="645" y="185" width="80" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="m3" value="Linear&lt;br&gt;4 → 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="185" width="80" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="Softmax&lt;br&gt;確率" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="855" y="185" width="80" height="54" as="geometry"/>
        </mxCell>
        <mxCell id="me1" value="" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="m1" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me2" value="" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="m2" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me3" value="" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="m3" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="mwhy" value="非線形の活性化をはさまないと、Linear を何層重ねても&lt;br&gt;1 層の Linear と同じ（線形の合成は線形）" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="540" y="260" width="410" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="mnote" value="曲がった（非線形の）境界が作れる&lt;br&gt;&lt;br&gt;○ XOR：4 点すべて正解（100%）&lt;br&gt;学習は誤差逆伝播法（バックプロパゲーション）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="545" y="360" width="400" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="数値は、教材のノートブックのコードを筆者が 2026 年 9 月に実行した結果" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="30" y="495" width="940" height="25" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
