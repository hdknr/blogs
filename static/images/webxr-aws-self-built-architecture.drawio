<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="webxr-aws" name="WebXR on AWS">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="AWS 上に独自構築する WebXR 空間の構成例" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Client -->
        <mxCell id="client-group" value="クライアント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="200" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="ブラウザ / VR 機器&lt;br&gt;Three.js・A-Frame&lt;br&gt;WebXR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="255" width="150" height="90" as="geometry"/>
        </mxCell>

        <!-- AWS -->
        <mxCell id="aws-group" value="AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffaf0;strokeColor=#d79b00;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="770" height="540" as="geometry"/>
        </mxCell>

        <!-- Row 1: delivery -->
        <mxCell id="lane1" value="① 配信（静的ファイル・3D アセット）" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="300" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="cf" value="Amazon CloudFront" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="130" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="Amazon S3&lt;br&gt;HTML/JS・glTF・テクスチャ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="130" width="200" height="50" as="geometry"/>
        </mxCell>

        <!-- Row 2: sync -->
        <mxCell id="lane2" value="② リアルタイム同期・API" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="330" y="250" width="300" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="alb" value="ALB / API Gateway&lt;br&gt;（WebSocket）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="280" width="170" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ecs" value="ECS / EKS・Lambda&lt;br&gt;位置同期・ルーム管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="280" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="RDS / DynamoDB&lt;br&gt;ユーザー・ルーム設定" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="270" width="160" height="70" as="geometry"/>
        </mxCell>

        <!-- Row 3: media -->
        <mxCell id="lane3" value="③ 音声・映像（WebRTC）" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="330" y="430" width="300" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="sfu" value="SFU（mediasoup など）&lt;br&gt;EC2 / ECS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="460" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="turn" value="STUN / TURN（coturn など）&lt;br&gt;EC2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="460" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cost" value="通信量・常時稼働で&lt;br&gt;コストが膨らみやすい" style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="890" y="460" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="cf">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="155"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="cf" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="WebSocket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="alb">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" parent="1" source="alb" target="ecs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;endArrow=block;endFill=1;" edge="1" parent="1" source="ecs" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="WebRTC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=10;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="browser" target="sfu">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="490"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="NAT 越え" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;endArrow=none;dashed=1;fontSize=10;" edge="1" parent="1" source="sfu" target="turn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
