<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="openwiki-ci" name="OpenWiki GitHub Actions Pipeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="maintitle" value="OpenWiki を GitHub Actions で回す構成" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="370" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== Left: config layers ===== -->
        <mxCell id="cfggroup" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="310" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="cfgtitle" value="設定の置き場所（3 層）" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="82" width="270" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="cfgrepo" value="① リポジトリにコミット（チーム共有）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="270" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="cfgwf" value=".github/workflows/openwiki-update.yml&#xa;プロバイダ名・モデル ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="75" y="150" width="240" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="cfginst" value="openwiki/INSTRUCTIONS.md&#xa;何を重点的に書かせるか" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="75" y="200" width="240" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="cfgignore" value=".openwikiignore&#xa;読み取り境界（読ませない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="75" y="246" width="240" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="cfgsec" value="② GitHub Secrets（秘密）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cfgkey" value="OPENROUTER_API_KEY 等&#xa;※ OIDC を使えばキー自体が不要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="75" y="345" width="240" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="cfglocal" value="③ ~/.openwiki/.env（ローカル）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cfglocalnote" value="手元の provider 設定とキー&#xa;CI では読まれない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="75" y="470" width="240" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="cfgwarn" value="生成方針＝エージェント設定は ① に置く&#xa;（CLI にエージェント本体は同梱済み）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="558" width="270" height="55" as="geometry"/>
        </mxCell>

        <!-- ===== Center: job steps ===== -->
        <mxCell id="jobgroup" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f9fbff;strokeColor=#6c8ebf;verticalAlign=top;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="390" y="70" width="380" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="jobtitle" value="GitHub Actions ジョブ" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#4472C4;" vertex="1" parent="1">
          <mxGeometry x="430" y="82" width="300" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="schedule（cron）/ workflow_dispatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="120" width="330" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="checkout（fetch-depth: 0）&#xa;浅いクローンだと差分が空になる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="185" width="330" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="npm i -g openwiki mermaid jsdom" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="258" width="330" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="openwiki code --update --print&#xa;（エージェント実行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="415" y="325" width="330" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="openwiki/ の Markdown を生成・更新&#xa;（AGENTS.md / CLAUDE.md も自動追記）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="450" width="330" height="52" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="create-pull-request&#xa;ブランチ openwiki/update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="530" width="330" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s7" value="人間がレビューしてマージ&#xa;差分が無い実行は no-op（PR が出ない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="415" y="608" width="330" height="52" as="geometry"/>
        </mxCell>

        <!-- ===== Right: LLM provider ===== -->
        <mxCell id="llmgroup" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf7ff;strokeColor=#9673a6;verticalAlign=top;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="810" y="240" width="390" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="llmtitle" value="推論プロバイダ（外部 / 自分で選ぶ）" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#7c4daa;" vertex="1" parent="1">
          <mxGeometry x="830" y="252" width="350" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="llmkey" value="API キー方式&#xa;OpenRouter / OpenAI / Anthropic / Gemini&#xa;→ キーを Secrets に置く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="288" width="350" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="llmoidc" value="キーレス方式（CI では推奨）&#xa;AWS Bedrock / Gemini Enterprise&#xa;→ OIDC で認証。長期キーを持たない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="365" width="350" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="llmlocal" value="ローカル完結（Ollama / LM Studio）&#xa;→ セルフホストランナーが必要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="830" y="442" width="350" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="codenote" value="コードはここへ送られる&#xa;送信先の選択＝統制ポイント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="830" y="560" width="350" height="55" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
