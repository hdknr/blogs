        <mxCell id="ecfg1" value="読み込む" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;dashed=1;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cfgrepo" target="s4">
          <mxGeometry relative="1" as="geometry"/>
