        <mxCell id="400" value="サンドボックス環境は存在しない。&lt;br&gt;書き込み系の試行は本番データに当たるため、対応しているメソッドでは validateOnly を使う。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6e6;strokeColor=#b85450;fontSize=11;align=center;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="110" y="678" width="480" height="56" as="geometry" />
