<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="cornell-5r" name="Cornell 5R">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="コーネル式ノートの 5R サイクル" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="460" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="&lt;b&gt;1. 記録&lt;/b&gt;&lt;br&gt;Record&lt;br&gt;&lt;br&gt;要点を箇条書きや&lt;br&gt;図で書き留める" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="r2" value="&lt;b&gt;2. 抽出&lt;/b&gt;&lt;br&gt;Reduce&lt;br&gt;&lt;br&gt;キーワードと問いを&lt;br&gt;抜き出す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="90" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="r3" value="&lt;b&gt;3. 暗唱&lt;/b&gt;&lt;br&gt;Recite&lt;br&gt;&lt;br&gt;ノート欄を隠し、&lt;br&gt;キューだけ見て説明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="90" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="r4" value="&lt;b&gt;4. 熟考&lt;/b&gt;&lt;br&gt;Reflect&lt;br&gt;&lt;br&gt;「なぜ？」「何と&lt;br&gt;繋がる？」を考える" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="90" width="170" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="r5" value="&lt;b&gt;5. 復習&lt;/b&gt;&lt;br&gt;Review&lt;br&gt;&lt;br&gt;サマリーを書き、&lt;br&gt;週 1 回見返す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="90" width="170" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="a1" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a3" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a4" style="endArrow=block;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="loop" value="週 1 回の見返しで再びキュー欄から暗唱へ" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;dashed=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r5" target="r3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="955" y="250"/>
              <mxPoint x="535" y="250"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Area legend -->
        <mxCell id="lg-title" value="使う欄：" style="text;html=1;fontSize=12;fontStyle=1;align=left;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="70" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lg1" value="ノート欄" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
