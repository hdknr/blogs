        <mxCell id="lg4" value="頭の中（余白にメモ）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="490" y="300" width="150" height="30" as="geometry"/>
