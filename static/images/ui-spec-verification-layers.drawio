<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="ui-spec-verification-layers" name="UI spec verification layers">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="UI モックの仕様を検証する 4 つの層" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="285" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="h1" value="層（何と照らし合わせるか）" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="240" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="主な道具" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="300" y="55" width="420" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="判定するのは" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="880" y="55" width="150" height="25" as="geometry"/>
        </mxCell>

        <!-- Layer 1 -->
        <mxCell id="l1" value="&lt;b&gt;1. 書式&lt;/b&gt;&lt;br&gt;仕様 ↔ 決まった型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t1" value="JSON Schema・コンポーネントカタログ&lt;br&gt;DTCG のバリデータ・EARS / Gherkin のリンター" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="90" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="j1" value="機械" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="100" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- Layer 2 -->
        <mxCell id="l2" value="&lt;b&gt;2. 仕様の中の整合&lt;/b&gt;&lt;br&gt;仕様 ↔ 仕様自身" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="状態遷移の検査（TLA+ など）・決定表の検査（Z3）&lt;br&gt;反例を出させ、陽性対照で空振りでないことを確かめる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="j2" value="機械（形式手法）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="190" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- Layer 3 -->
        <mxCell id="l3" value="&lt;b&gt;3. 実装との一致&lt;/b&gt;&lt;br&gt;仕様 ↔ 実装" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t3" value="Gherkin → Cucumber・モデルベーステスト&lt;br&gt;ビジュアル回帰テスト・stylelint（色の直書きを禁止）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="270" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="j3" value="機械（テスト）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="280" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- Layer 4 -->
        <mxCell id="l4" value="&lt;b&gt;4. 意図との一致&lt;/b&gt;&lt;br&gt;仕様 ↔ 利用者の意図" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="240" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="t4" value="モックを見せながら仕様を 1 行ずつ確認&lt;br&gt;見つかった反例を「どうなるべきか」の質問にして返す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="420" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="j4" value="人" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="880" y="370" width="150" height="50" as="geometry"/>
        </mxCell>

        <!-- Feedback arrow: counterexample becomes question -->
        <mxCell id="fb" value="反例を質問に変える" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#d6b656;strokeWidth=2;fontSize=11;fontColor=#8a6d00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="t2" target="t4">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="232"/>
              <mxPoint x="790" y="377"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Cost arrow -->
        <mxCell id="cost" value="" style="endArrow=block;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="20" y="95" as="sourcePoint"/>
            <mxPoint x="20" y="425" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="costlabel" value="下ほど手間がかかり、機械に任せにくい" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#777777;" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="400" height="25" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
