<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="interview-flow" name="Interview Prompting Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="インタビュー型プロンプティングの流れ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="s1" value="&lt;b&gt;① プロンプトを書く&lt;/b&gt;&lt;br&gt;役割・目的&lt;br&gt;自明な質問 NG・最大3問&lt;br&gt;終了条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="200" height="110" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="s2" value="&lt;b&gt;② メモを添える&lt;/b&gt;&lt;br&gt;要件・制約・候補案を&lt;br&gt;箇条書きのまま" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="290" y="90" width="180" height="110" as="geometry"/>
        </mxCell>

        <!-- Loop group -->
        <mxCell id="loop" value="インタビューのループ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="510" y="70" width="230" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="q" value="&lt;b&gt;AI が質問する&lt;/b&gt;&lt;br&gt;前提・判断基準・制約を&lt;br&gt;最大3問ずつ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="535" y="110" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a" value="&lt;b&gt;人間が答える&lt;/b&gt;&lt;br&gt;暗黙知が言語化される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="535" y="230" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="d" value="十分？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="575" y="340" width="100" height="80" as="geometry"/>
        </mxCell>

        <!-- Output -->
        <mxCell id="out" value="&lt;b&gt;③ 成果物を作らせる&lt;/b&gt;&lt;br&gt;トレードオフ表&lt;br&gt;構成案・まとめ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="340" width="170" height="80" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="q">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="q" target="a">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="a" target="d">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="まだ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;" edge="1" parent="1" source="d" target="q">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="525" y="380"/>
              <mxPoint x="525" y="150"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="「十分」と合図" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;" edge="1" parent="1" source="d" target="out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
