<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="checkout-statechart" name="Checkout statechart example">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="状態遷移図の例：購入フロー（仮想例）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="start" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="45" y="155" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="カート確認中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="120" y="137" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="支払い処理中" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="420" y="137" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="購入完了" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="760" y="137" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="支払い失敗" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=30;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="二重請求&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;規則違反：請求は 1 注文 1 回&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;arcSize=30;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="330" width="190" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="t0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t1" value="購入ボタンを押す" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t2" value="決済が成功する" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t3" value="決済が失敗する" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s2" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t4" value="もう一度試す" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="s4" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="t5" value="購入ボタンをもう一度押す&lt;br&gt;[支払い処理中に]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;endArrow=block;endFill=1;fontSize=11;fontColor=#b85450;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="182"/><mxPoint x="660" y="270"/><mxPoint x="835" y="270"/></Array></mxGeometry></mxCell>

        <mxCell id="note" value="図にすると「処理中にもう一度押したら？」という抜けた遷移に気づける。&lt;br&gt;ここで規則（不変条件）を言葉にしてから形式検証に渡す。" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="860" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
