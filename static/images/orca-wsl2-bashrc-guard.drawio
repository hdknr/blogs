<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="bashrc-guard" name="bashrc guard and nvm">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="660" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="なぜ「Node.js not found on remote host」が出るのか" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="18" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="nvm は ~/.bashrc の「末尾」に追記される。Ubuntu の ~/.bashrc は「冒頭」で非対話シェルを弾く。" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="210" y="48" width="700" height="24" as="geometry"/>
        </mxCell>

        <!-- bashrc file -->
        <mxCell id="file-group" value="~/.bashrc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="330" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="line-top" value="# 冒頭（Ubuntu の既定）&#xa;case $- in&#xa;    *i*) ;;&#xa;      *) return;;&#xa;esac" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontFamily=Courier New;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="150" width="280" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="line-mid" value="…（エイリアス、プロンプト設定など）…" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;fontColor=#999999;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="425" y="252" width="280" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="line-bottom" value="# 末尾（nvm インストーラが追記）&#xa;export NVM_DIR=&quot;$HOME/.nvm&quot;&#xa;[ -s &quot;$NVM_DIR/nvm.sh&quot; ] &amp;&amp; \. &quot;$NVM_DIR/nvm.sh&quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;fontFamily=Courier New;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="425" y="295" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="gap-note" value="この2箇所の距離が、そのまま不具合の距離になる" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="415" y="392" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- interactive path -->
        <mxCell id="inter" value="対話シェル&#xa;（ターミナルで ssh してログイン）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="inter-res" value="&#x2705; $- に i が含まれる → 素通り&#xa;末尾の nvm まで到達する&#xa;node -v が動く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="270" height="90" as="geometry"/>
        </mxCell>

        <!-- non-interactive path -->
        <mxCell id="noninter" value="非対話シェル&#xa;（ssh host &apos;node -v&apos; のような一発実行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="150" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="noninter-res" value="&#x274c; $- に i が無い → return&#xa;末尾の nvm を読まずに終了&#xa;PATH に node が入らない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="800" y="250" width="270" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="ea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="inter" target="line-top">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="noninter" target="line-top">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="line-bottom" target="inter-res">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="line-top" target="noninter-res">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="fix" value="対処：ログインシェルでも読まれる ~/.profile に nvm の読み込みを書く（対話判定より前で評価される場所に置く）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="490" width="820" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="fix2" value="ターミナルで手で ssh すると動くのに、GUI クライアントからだと動かない — この非対称がヒントになる" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="150" y="560" width="820" height="26" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
