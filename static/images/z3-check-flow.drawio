<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="z3-check-flow" name="Z3 check flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Z3 で性質を確かめる流れ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="400" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="prop" value="&lt;b&gt;確かめたい性質 P&lt;/b&gt;&lt;br&gt;例：lo ≤ hi なら&lt;br&gt;lo ≤ mid ≤ hi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="neg" value="&lt;b&gt;否定 Not(P) を&lt;br&gt;制約として加える&lt;/b&gt;&lt;br&gt;「P を破る入力はあるか」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="200" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;Z3&lt;/b&gt;&lt;br&gt;s.check()" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="185" width="140" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="sat" value="&lt;b&gt;sat&lt;/b&gt;&lt;br&gt;P を破る入力がある。&lt;br&gt;s.model() がそのまま反例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="70" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="unsat" value="&lt;b&gt;unsat&lt;/b&gt;&lt;br&gt;どの入力でも P が成り立つ&lt;br&gt;（制約の範囲内で）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="200" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="unknown" value="&lt;b&gt;unknown&lt;/b&gt;&lt;br&gt;判定できなかった&lt;br&gt;（非線形・量化子・時間切れなど）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="330" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeColor=#666666;" edge="1" parent="1" source="prop" target="neg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeColor=#666666;" edge="1" parent="1" source="neg" target="check">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#b85450;" edge="1" parent="1" source="check" target="sat">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="570" y="110"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeColor=#82b366;" edge="1" parent="1" source="check" target="unsat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;html=1;strokeColor=#999999;" edge="1" parent="1" source="check" target="unknown">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="570" y="370"/></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="note" value="unsat を信じる前に、わざと P を破る版で sat が出ることを確かめる（陽性対照）" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;fontColor=#777777;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="440" width="700" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
