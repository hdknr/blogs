<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="llmloop-five-loops" name="LLMLOOP Five Feedback Loops">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="LLMLOOP: 5つのフィードバックループ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="10" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- LLM box -->
        <mxCell id="llm" value="LLM&#xa;(GPT-4o-mini)&#xa;&#xa;コード生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="180" width="130" height="90" as="geometry"/>
        </mxCell>

        <!-- Loop 1: Compile -->
        <mxCell id="loop1" value="Loop 1&#xa;コンパイル&#xa;&#xa;エラーを検出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="210" y="180" width="150" height="90" as="geometry"/>
        </mxCell>

        <!-- Loop 2: Test failures -->
        <mxCell id="loop2" value="Loop 2&#xa;テスト実行&#xa;&#xa;失敗テストを検出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="410" y="180" width="150" height="90" as="geometry"/>
        </mxCell>

        <!-- Loop 3: Static analysis -->
        <mxCell id="loop3" value="Loop 3&#xa;静的解析（PMD）&#xa;&#xa;未使用変数・空catch等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="610" y="180" width="150" height="90" as="geometry"/>
        </mxCell>

        <!-- Loop 4: Test generation -->
        <mxCell id="loop4" value="Loop 4&#xa;テスト生成&#xa;&#xa;EvoSuite / LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="810" y="180" width="150" height="90" as="geometry"/>
        </mxCell>

        <!-- Loop 5: Mutation analysis -->
        <mxCell id="loop5" value="Loop 5&#xa;ミューテーション解析&#xa;（PIT）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1010" y="180" width="140" height="90" as="geometry"/>
        </mxCell>

        <!-- Output -->
        <mxCell id="output" value="最終成果物&#xa;コード + テストスイート" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1010" y="330" width="140" height="70" as="geometry"/>
        </mxCell>

        <!-- Forward flow arrows -->
        <mxCell id="a-llm-l1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="llm" target="loop1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-l1-l2" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="loop1" target="loop2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-l2-l3" value="Pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="loop2" target="loop3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-l3-l4" value="Clean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="loop3" target="loop4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-l4-l5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" parent="1" source="loop4" target="loop5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-l5-out" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="loop5" target="output">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Self-loop retry markers -->
        <mxCell id="retry1" value="🔁 LLMにフィードバック" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="210" y="275" width="150" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="retry2" value="🔁 LLMにフィードバック" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="410" y="275" width="150" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="retry3" value="🔁 LLMにフィードバック" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="610" y="275" width="150" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="retry4" value="🔁 LLMにフィードバック" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="810" y="275" width="150" height="16" as="geometry"/>
        </mxCell>
        <mxCell id="retry5" value="🔁 LLMにフィードバック" style="rounded=1;arcSize=100;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=9;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="1010" y="275" width="140" height="16" as="geometry"/>
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="※ 各ループで問題が見つかった場合はその内容を LLM にフィードバックし、再生成・再検証する（すべて Docker サンドボックス内で実行）" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="1120" height="20" as="geometry"/>
        </mxCell>

      </root>
