        <mxCell id="sess-online2" value="オンライン" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="300" width="190" height="44" as="geometry"/>
