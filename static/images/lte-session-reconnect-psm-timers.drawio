        <mxCell id="idle-line" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="270" as="sourcePoint"/>
            <mxPoint x="630" y="270" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="idle-label" value="無通信タイマー（サブスクリプションごとに異なる）" style="text;html=1;fontSize=11;fontStyle=0;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#d79b00;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="290" y="258" width="300" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="ev-deleted" value="Deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="366" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ev-created" value="Created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="830" y="366" width="100" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="ev-note" value="端末は寝ているだけなのに、ログには「切断→再接続」として残る" style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="580" y="400" width="440" height="24" as="geometry"/>
