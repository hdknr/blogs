        <mxCell id="offnote" value="数字 = オフセット（パーティション内の連番）。同じキーは同じパーティションに入り、その中で順序が保たれる" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="280" y="395" width="450" height="35" as="geometry"/></mxCell>

