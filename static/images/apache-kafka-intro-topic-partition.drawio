        <mxCell id="cgnote" value="グループごとに「どこまで読んだか（コミット済みオフセット）」を別々に持つ。同じデータを何度でも、別々の用途で読める" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="800" y="400" width="270" height="50" as="geometry"/></mxCell>

