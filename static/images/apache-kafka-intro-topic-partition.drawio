        <mxCell id="cA2" value="コンシューマー A2&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;担当: パーティション 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="830" y="180" width="210" height="50" as="geometry"/></mxCell>

        <!-- Consumer group B -->
        <mxCell id="cgB" value="コンシューマーグループ B（分析基盤へ転送）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
