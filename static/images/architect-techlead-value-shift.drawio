        <mxCell id="p2" value="AI が肩代わりし始めた領域" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="430" y="75" width="380" height="465" as="geometry"/>
