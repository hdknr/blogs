        <mxCell id="p1d" value="レビューで誤りを見抜ける" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="65" y="325" width="300" height="48" as="geometry"/>
