        <mxCell id="p1c" value="技術選定の引き出しが多い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="65" y="265" width="300" height="48" as="geometry"/>
