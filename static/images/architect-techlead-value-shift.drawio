        <mxCell id="valueshift" value="価値の源泉の移動：知識の独占 → 判断と責任" style="shape=singleArrow;whiteSpace=wrap;html=1;arrowWidth=0.55;arrowSize=0.06;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;fontColor=#4472C4;" vertex="1" parent="1">
