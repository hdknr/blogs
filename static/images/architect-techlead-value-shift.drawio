        <mxCell id="p1a" value="設計パターンを一番知っている" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="65" y="145" width="300" height="48" as="geometry"/>
