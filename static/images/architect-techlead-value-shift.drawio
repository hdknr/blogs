        <mxCell id="p1e" value="＝「一番詳しい人」が強い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;fontColor=#4472C4;verticalAlign=middle;align=center;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="425" width="300" height="55" as="geometry"/>
