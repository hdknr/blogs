        </mxCell>

        <mxCell id="note" value="肩書きが消えるのではない。肩書きを支えていた「知識を独占できる状態」が消える" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="220" y="640" width="800" height="30" as="geometry"/>
