<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="architect-techlead-value-shift" name="Architect and TechLead Value Shift">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="テックリード／アーキテクトの「価値の源泉」はどこへ移るか" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="270" y="20" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- Panel 1: former value -->
        <mxCell id="p1" value="これまでの価値の源泉&#xa;（知識の非対称性）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="350" height="465" as="geometry"/>
