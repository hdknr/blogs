        <mxCell id="210" value="&lt;b&gt;Account Management&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#666&quot;&gt;mybusinessaccountmanagement&lt;/span&gt;&lt;br&gt;アカウント／管理者／招待" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
