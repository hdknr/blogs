<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="dory-arch" name="Dory1.0-4B Looped Transformer">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Dory1.0-4B（Looped Transformer）の構造" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="tokens" value="入力トークン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="140" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="input" value="&lt;b&gt;入力ブロック&lt;/b&gt;&lt;br&gt;16 層（8 ブロック）&lt;br&gt;1 回だけ実行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="loopgroup" value="k 回ループ（k = 1〜4、推奨 2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d79b00;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="280" y="90" width="340" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="add" value="加算&lt;br&gt;s&lt;sub&gt;t-1&lt;/sub&gt; + x" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="130" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="norm" value="L2 正規化 N(·)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="205" width="120" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="rec" value="&lt;b&gt;再帰ブロック（重み共有）&lt;/b&gt;&lt;br&gt;40 層（20 ブロック）&lt;br&gt;出力も L2 正規化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="180" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="output" value="&lt;b&gt;出力ブロック&lt;/b&gt;&lt;br&gt;16 層（8 ブロック）&lt;br&gt;1 回だけ実行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="180" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="head" value="LM ヘッド → 次トークン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="690" y="300" width="160" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="実効的な深さ = 32 + 40k 層（k=1: 72 / k=2: 112 / k=4: 192）&lt;br&gt;パラメータ数は k によらず約 4B のまま" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="150" y="460" width="600" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="tokens" target="input">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="x（= s&lt;sub&gt;0&lt;/sub&gt;）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="input" target="add">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="250" y="215"/><mxPoint x="250" y="155"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;" edge="1" parent="1" source="add" target="norm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;" edge="1" parent="1" source="norm" target="rec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="s&lt;sub&gt;t&lt;/sub&gt;（次のループへ）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;dashed=1;fontSize=11;labelBackgroundColor=#fff8e1;" edge="1" parent="1" source="rec" target="add">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="450" y="380"/><mxPoint x="330" y="380"/><mxPoint x="330" y="155"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" value="s&lt;sub&gt;k&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rec" target="output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="590" y="305"/><mxPoint x="590" y="215"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="output" target="head">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
