<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="davinci-keyframe-pages" name="Keyframes per Page">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="ページごとに「キーフレームを打つ場所」が違う" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="同じ「キーフレーム」という言葉でも、UI も補間のモデルも別物。迷ったらまず「どのページの話か」を確定させる" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="230" y="50" width="700" height="20" as="geometry"/>
        </mxCell>

        <!-- Edit / Cut -->
        <mxCell id="edit-box" value="エディット／カット" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="250" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="edit-ui" value="打つ場所：インスペクタの ◇ アイコン" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="210" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="edit-what" value="対象：変形（位置・ズーム・回転）、クロップ、合成（不透明度）、速度、音量、エフェクトの各パラメーター" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="205" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="edit-editor" value="編集ツール：クリップ名バー右端の 2 ボタン → キーフレームエディター／カーブエディター" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- Color -->
        <mxCell id="color-box" value="カラー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="250" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="color-ui" value="打つ場所：キーフレームエディター（ノード別のトラック）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="150" width="210" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="color-what" value="対象：カラーホイール、カーブ、ウィンドウの位置・サイズ（＝トラッキングの手動補正）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="205" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="color-editor" value="固有の概念：ダイナミック◇（徐々に変化）とスタティック○（そのフレームで切り替わる）の 2 種類" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- Fusion -->
        <mxCell id="fusion-box" value="Fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="250" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="fusion-ui" value="打つ場所：インスペクタ（ノードのパラメーター）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="150" width="210" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="fusion-what" value="対象：ノードグラフ上の全ノード。テキスト、マスク（ポリゴンの頂点）、パーティクル、3D カメラなど" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="205" width="210" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="fusion-editor" value="編集ツール：キーフレームエディター＋スプラインエディター（緩急の作り込みはここが本命）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- Fairlight -->
        <mxCell id="fair-box" value="Fairlight" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="110" width="200" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="fair-ui" value="打つ場所：クリップ上のボリュームライン、またはトラックのオートメーション" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="160" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="fair-what" value="対象：音量、パン、プラグインのパラメーター" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="225" width="160" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="fair-editor" value="注意：ダッキングはキーフレーム手打ちより先にダイナミクス（サイドチェーン）を検討" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="300" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- bottom common -->
        <mxCell id="common-box" value="どのページでも共通する 3 つの操作" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=10;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="1040" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="c-1" value="1. 再生ヘッドを置く&#xa;&#xa;「いつ」を先に決める。値を先に触ると、意図しないフレームに 1 点目が刺さる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="90" y="470" width="310" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="c-2" value="2. 1 点目だけは手動で打つ&#xa;&#xa;2 点目以降は「再生ヘッドを移動 → 値を変える」だけで自動的に追加される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="425" y="470" width="310" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="c-3" value="3. 補間を直す&#xa;&#xa;打ち終わってからカーブエディターでイーズを当てる。ここまでやって初めて「完成」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="470" width="310" height="95" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
