<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="lte-m-two-layer-alerting" name="Two Layer Alerting">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="異常検知と死活監視を分けて組む" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="330" y="20" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="送信契機（message_type）ごとに監視の役割が違う。1 本のアラートで両方やろうとすると破綻する" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="50" width="800" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="dev" value="SmartFitPRO&#10;（LTE Cat.M1 / plan-D）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="170" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="harvest" value="SORACOM&#10;Harvest Data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="180" width="150" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="lagoon" value="SORACOM Lagoon 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="660" y="100" width="440" height="330" as="geometry"/>
        </mxCell>

        <mxCell id="msg3" value="message_type 0003&#10;接点変化送信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="140" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="msg2" value="message_type 0002&#10;周期送信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="255" y="205" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="msg1" value="message_type 0001&#10;起動送信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="255" y="270" width="160" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e-dev-3" value="" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;exitX=1;exitY=0.2;exitDx=0;exitDy=0;" edge="1" parent="1" source="dev" target="msg3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-dev-2" value="" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="dev" target="msg2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-dev-1" value="" style="endArrow=classic;html=1;strokeColor=#999999;strokeWidth=2;exitX=1;exitY=0.8;exitDx=0;exitDy=0;" edge="1" parent="1" source="dev" target="msg1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e-3-h" value="" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="msg3" target="harvest">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-2-h" value="" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="msg2" target="harvest">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-1-h" value="" style="endArrow=classic;html=1;strokeColor=#999999;strokeWidth=2;" edge="1" parent="1" source="msg1" target="harvest">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="rule1" value="Alert rule ①：異常検知&#10;&#10;条件: di0 が「閉」に変化&#10;Evaluate every: 1m&#10;for: 0（1 回で発火）&#10;&#10;→ 接点変化は即時に飛ぶので、&#10;　 検知は送信間隔に依存しない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="685" y="140" width="390" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="rule2" value="Alert rule ②：死活監視&#10;&#10;条件: Alert state if no data or all values are null → Alerting&#10;From: now-（定期送信間隔 × 2〜3）&#10;Evaluate every: 10 秒の倍数（例 5m）&#10;&#10;→ 1 回の取りこぼしでは鳴らさない。&#10;　 検知遅延は必ず送信間隔以上になる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="685" y="285" width="390" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="e-h-l" value="取得間隔&#10;Free 60s / Maker 30s / Pro 5s" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=10;fontColor=#d79b00;labelBackgroundColor=#ffffff;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="590" y="225" as="sourcePoint"/>
            <mxPoint x="660" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="warn-box" value="やってはいけない設計：1 本のアラートで両方を兼ねる&#10;&#10;「1 分データが来なければ鳴らす」を 1 本で組むと、周期送信の間隔が 1 分より長い時点で常時発火する。&#10;異常が起きていなくても鳴り続けるため、本当の異常（接点変化）が埋もれる。&#10;アラートは「異常が起きたら鳴る」ではなく「異常が起きていないときは鳴らない」で設計する。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=14;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="1040" height="120" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
