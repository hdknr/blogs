<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="fable-factor-analysis" name="Factor Analysis Tool Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="株式ファクター分析ツールの構成（Claude Fable 5 に設計を任せた例）" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="20" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- Data Source: J-Quants API -->
        <mxCell id="jquants" value="J-Quants API&#xa;(JPX 公式データ)&#xa;&#xa;&#x2022; 株価 OHLC&#xa;&#x2022; 財務情報 /fins/summary&#xa;&#x2022; 配当&#xa;&#x2022; 株式分割" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="190" height="180" as="geometry"/>
        </mxCell>

        <!-- Feature 1 Group: Factor calc & register -->
        <mxCell id="feat1-group" value="① ファクターを算出して DB に登録する機能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="290" y="90" width="270" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="calc-engine" value="ファクター算出エンジン&#xa;(プラグイン形式で拡張)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="130" width="230" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="factors" value="ファクター定義&#xa;&#x2022; バリュー(PER/PBR)&#xa;&#x2022; モメンタム(過去リターン)&#xa;&#x2022; クオリティ / サイズ / 低ボラ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="200" width="230" height="100" as="geometry"/>
        </mxCell>

        <!-- Database -->
        <mxCell id="db" value="データベース&#xa;&#xa;&#x2022; 株価テーブル&#xa;&#x2022; 財務テーブル&#xa;&#x2022; ファクター値テーブル" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="620" y="240" width="180" height="160" as="geometry"/>
        </mxCell>

        <!-- Feature 2 Group: Analysis & backtest -->
        <mxCell id="feat2-group" value="② 登録済みファクターを使って分析する機能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="860" y="90" width="270" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="backtest" value="バックテストエンジン&#xa;&#xa;過去の株価で&#xa;ファクター戦略を検証" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="885" y="140" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="screen" value="分析画面&#xa;&#xa;&#x2022; バックテスト結果グラフ&#xa;&#x2022; 累積リターン / ドローダウン&#xa;&#x2022; ファクター別ランキング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="885" y="270" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="user" value="&#x1f464; 投資家（画面から確認）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="885" y="440" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="jquants" target="calc-engine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="calc-engine" target="factors">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="ファクター値を保存" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="factors" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3b" value="株価/財務を格納" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;dashed=1;" edge="1" parent="1" source="jquants" target="db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="ファクター値を読み出し" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="db" target="backtest">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="backtest" target="screen">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="screen" target="user">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
