<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram name="1. 経路と構成" id="page-arch">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="社外リモートアクセス — WireGuard 中継ハブ" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="24" width="620" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="社外の端末の通信をオフィス経由にして、IP 制限されている SaaS の許可 IP から出る。ハブは中継のみで NAT しない。" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="900" height="20" as="geometry" />
        </mxCell>

        <mxCell id="zone-out" value="社外（自宅・出張先）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#F7F9FA;strokeColor=#9AA5AB;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="30" y="210" width="220" height="300" as="geometry" />
        </mxCell>
        <mxCell id="zone-aws" value="AWS リージョン" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#FCF8F2;strokeColor=#D9A85F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#9A6B14;" vertex="1" parent="1">
          <mxGeometry x="310" y="100" width="320" height="600" as="geometry" />
        </mxCell>
        <mxCell id="zone-off" value="オフィス" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#F4F8F4;strokeColor=#7FA87F;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#3F6B3F;" vertex="1" parent="1">
          <mxGeometry x="690" y="210" width="240" height="410" as="geometry" />
        </mxCell>
        <mxCell id="zone-net" value="インターネット" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#F7F9FA;strokeColor=#9AA5AB;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=12;fontStyle=1;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="980" y="260" width="160" height="200" as="geometry" />
        </mxCell>

        <mxCell id="client" value="&lt;b&gt;クライアント端末&lt;/b&gt;&lt;br&gt;10.100.0.17/32&lt;br&gt;MTU 1280&lt;br&gt;DNS 1.1.1.1, 8.8.8.8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5560;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="250" width="170" height="86" as="geometry" />
        </mxCell>
        <mxCell id="router" value="自宅ルータ / ISP&lt;br&gt;&lt;font color=&quot;#B03A2E&quot;&gt;&lt;b&gt;上限 1454 B&lt;/b&gt;&lt;/font&gt;&lt;br&gt;（PPPoE 等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5560;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="400" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="hub" value="&lt;b&gt;EC2 中継ハブ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;EIP 203.0.113.10:51820 / arm64&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8860B;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="240" width="280" height="290" as="geometry" />
        </mxCell>
        <mxCell id="wg0" value="wg0  10.100.0.1/24  MTU 1420&lt;br&gt;&lt;b&gt;Table = off&lt;/b&gt;（自身の通信は吸わない）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF4FA;strokeColor=#7A9CC0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="346" y="290" width="248" height="44" as="geometry" />
        </mxCell>
        <mxCell id="rule" value="ip rule from 10.100.0.16/28 → table 200&lt;br&gt;table 200: default dev wg0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF4FA;strokeColor=#7A9CC0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="346" y="344" width="248" height="44" as="geometry" />
        </mxCell>
        <mxCell id="fwd" value="FORWARD  -i wg0 -o wg0  ACCEPT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EEF4FA;strokeColor=#7A9CC0;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="346" y="398" width="248" height="32" as="geometry" />
        </mxCell>
        <mxCell id="mss" value="&lt;b&gt;TCPMSS --set-mss 1240&lt;/b&gt;（細い回線の吸収）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D9822B;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="346" y="440" width="248" height="32" as="geometry" />
        </mxCell>
        <mxCell id="nonat" value="&lt;font color=&quot;#B03A2E&quot;&gt;NAT しない&lt;/font&gt;（すると出口 IP が AWS になる）" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fontColor=#B03A2E;" vertex="1" parent="1">
          <mxGeometry x="346" y="478" width="248" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ssm" value="SSM&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;管理経路（SSH なし）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8899A6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="140" width="130" height="52" as="geometry" />
        </mxCell>
        <mxCell id="param" value="Parameter Store&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;peers / ハブ公開鍵&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8899A6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="130" height="52" as="geometry" />
        </mxCell>
        <mxCell id="cw" value="CloudWatch — ConfigHealthy / ExitPeerHandshakeAge&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;ip-rule / table-default / forward-accept / mss-clamp / route-via-wg0 を 5 分ごとに検査&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8899A6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="330" y="570" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="node" value="&lt;b&gt;社内ノード&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;ハブの peer / AllowedIPs = 0.0.0.0/0&lt;br&gt;PersistentKeepalive = 25&lt;br&gt;&lt;b&gt;NAT → 198.51.100.20&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F6B3F;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="710" y="270" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="lan" value="社内 LAN&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;（到達不可。要件どおり）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#AAAAAA;fontSize=11;fontColor=#777777;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="520" width="200" height="70" as="geometry" />
        </mxCell>

        <mxCell id="saas" value="&lt;b&gt;IP 制限されている&lt;br&gt;SaaS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;許可 IP&lt;br&gt;198.51.100.20&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5560;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="310" width="120" height="100" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;endArrow=block;" edge="1" parent="1" source="client" target="router">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="&lt;b&gt;WireGuard&lt;/b&gt; UDP/51820&lt;br&gt;外側 1340 B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#2E6DA4;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="router" target="hub">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="270" y="435" /><mxPoint x="270" y="385" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="&lt;b&gt;WireGuard&lt;/b&gt;（2 段目のカプセル化）&lt;br&gt;wg0 → wg0 の転送" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#2E6DA4;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="hub" target="node">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="NAT 後&lt;br&gt;送信元 198.51.100.20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=3;strokeColor=#2E8B57;endArrow=block;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="node" target="saas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;strokeColor=#B03A2E;dashed=1;endArrow=none;startArrow=none;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="node" target="lan">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="✕" style="text;html=1;fontSize=30;fontColor=#B03A2E;align=center;verticalAlign=middle;fontStyle=1;labelBackgroundColor=#F4F8F4;" vertex="1" parent="1">
          <mxGeometry x="790" y="376" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="rejnote" value="&lt;b&gt;REJECT&lt;/b&gt;  icmp-admin-prohibited&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;RFC1918 宛（10/8・172.16/12・192.168/16）&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B03A2E&quot; style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;自宅 DNS 宛もここで落ちる → 障害 1&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B03A2E;dashed=1;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="425" width="220" height="66" as="geometry" />
        </mxCell>

        <mxCell id="e6" value="管理" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#8899A6;dashed=1;endArrow=block;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ssm" target="hub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="peer 同期&lt;br&gt;wg syncconf（無停止）" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#8899A6;dashed=1;endArrow=block;fontSize=9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="param" target="hub">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=1;strokeColor=#8899A6;dashed=1;endArrow=block;" edge="1" parent="1" source="hub" target="cw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note1" value="&lt;b&gt;なぜハブを挟むのか&lt;/b&gt;&lt;br&gt;社内ノードは固定のグローバル IP を持てないため、社外の端末が直接張れない。&lt;br&gt;ハブに EIP を置き、社内ノードからハブへ&lt;b&gt;アウトバウンドで&lt;/b&gt;張らせる。&lt;br&gt;&lt;br&gt;&lt;b&gt;デフォルトルートを peer で表現している&lt;/b&gt;&lt;br&gt;cryptokey routing は最長一致。クライアント宛（/32）に一致しないパケットは&lt;br&gt;すべて AllowedIPs = 0.0.0.0/0 の社内ノードへ振られる。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#D6C68A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="690" y="650" width="450" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="&lt;b&gt;匿名化&lt;/b&gt;&lt;br&gt;IP は RFC 5737 の&lt;br&gt;ドキュメント用アドレス。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#C8D0D6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;fontColor=#5A6570;" vertex="1" parent="1">
          <mxGeometry x="30" y="650" width="220" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

