<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="laplace-architecture" name="AI Native Data Platform">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
