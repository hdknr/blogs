        <mxCell id="b1" value="① マクロ先行変数&#10;&#10;長期金利↑&#10;イールドカーブの&#10;スティープ化&#10;&#10;（循環の上流）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f0fd;strokeColor=#2f6fc0;fontSize=12;fontColor=#12345b;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
