        <mxCell id="title" value="セクターローテーションを検知する4つの層（先行 → 遅行）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
