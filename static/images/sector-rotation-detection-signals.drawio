        </mxCell>
        <mxCell id="b3" value="③ 出来高の裏付け&#10;&#10;買われる側は大商いで上昇&#10;売られる側は投げ売り&#10;&#10;（本物度の確認）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4d6;strokeColor=#d39e00;fontSize=12;fontColor=#6b5200;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="200" height="180" as="geometry" />
