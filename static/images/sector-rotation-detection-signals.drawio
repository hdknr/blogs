        </mxCell>
        <mxCell id="b2" value="② 相対力（RS比）の転換&#10;&#10;銀行株指数 ÷ 半導体株指数&#10;の比がトレンド転換&#10;&#10;（循環の本体）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3e6;strokeColor=#27803a;fontSize=12;fontColor=#12401d;align=center;verticalAlign=middle;arcSize=10;" vertex="1" parent="1">
