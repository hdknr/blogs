<mxfile host="app.diagrams.net">
  <diagram name="Airtable と HubSpot の課金軸の違い">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="470" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" value="同じ「コンタクト 50,000 件」でも、何に値段が付くかが違う" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="110" y="16" width="700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="atbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="62" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="athd" value="Airtable" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="atsub" value="課金軸 ＝ 行数 × 座席" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="40" y="98" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="at1" value="50,000 件を持つ&#10;→ base 上限に当たる&#10;（Free 1,000 / Team 50,000）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="132" width="352" height="60" as="geometry" />
        </mxCell>
        <mxCell id="at2" value="見る人・コメントする人も座席として課金&#10;（Team は Commenter 以上が課金対象）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="64" y="204" width="352" height="54" as="geometry" />
        </mxCell>
        <mxCell id="at3" value="持っているだけで課金軸に乗る" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="270" width="352" height="38" as="geometry" />
        </mxCell>
        <mxCell id="at4" value="MA 機能は無い（別途 ESP・iPaaS が要る）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="316" width="352" height="34" as="geometry" />
        </mxCell>
        <mxCell id="hsbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="480" y="62" width="400" height="300" as="geometry" />
        </mxCell>
        <mxCell id="hshd" value="HubSpot" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="72" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="hssub" value="課金軸 ＝ 今月わざわざ接触する人数" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="480" y="98" width="400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hs1" value="50,000 件を保管するだけなら&#10;非マーケティングコンタクト扱いで課金対象外" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="504" y="132" width="352" height="60" as="geometry" />
        </mxCell>
        <mxCell id="hs2" value="そのうち今月メール・広告で接触する 3,000 件&#10;＝ マーケティングコンタクトだけが課金対象" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="504" y="204" width="352" height="54" as="geometry" />
        </mxCell>
        <mxCell id="hs3" value="使った分だけ課金軸に乗る" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="504" y="270" width="352" height="38" as="geometry" />
        </mxCell>
        <mxCell id="hs4" value="MA 機能は本体に含まれる（ただし Pro 以上）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="504" y="316" width="352" height="34" as="geometry" />
        </mxCell>
        <mxCell id="ftr" value="CRM の形をしたデータでは、HubSpot の課金軸のほうが実態に合う。逆に CRM の形をしていない業務データでは、この軸がそもそも使えない。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="386" width="840" height="44" as="geometry" />
