        <mxCell id="loop1" value="① 要求確定ループ&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;利用者 ⇔ 開発者（構造化 → 意地悪な質問 → 利用者確認）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="175" width="300" height="70" as="geometry"/>
