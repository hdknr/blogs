        <mxCell id="input" value="ヒアリングメモ・業務要望&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;曖昧・断片的&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
