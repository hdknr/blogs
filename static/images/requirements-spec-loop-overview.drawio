        <mxCell id="band1label" value="Validation：作るべきものは正しいか" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#9c7a1c;" vertex="1" parent="1">
          <mxGeometry x="470" y="145" width="420" height="20" as="geometry"/>
