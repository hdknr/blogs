<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="spec-loop-scope" name="Spec Loop Scope Comparison">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="2 つの spec-loop が受け持つ工程" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- timeline -->
        <mxCell id="tl-req" value="要求確定" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="70" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="tl-spec" value="仕様レビュー" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="70" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="tl-cost" value="見積り・提案書" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="70" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="tl-handoff" value="引き渡し（Issue）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="70" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="tl-plan" value="調査・計画" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="tl-impl" value="実装・検証・レビュー" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="70" width="190" height="36" as="geometry"/>
        </mxCell>

        <!-- lane labels -->
        <mxCell id="lane-hdknr" value="hdknr&lt;br&gt;spec-loop&lt;br&gt;＋ dev-loop" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="120" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="lane-dpol" value="dpolivaev&lt;br&gt;Spec Loop" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="120" height="110" as="geometry"/>
        </mxCell>

        <!-- hdknr spec-loop bar -->
        <mxCell id="bar-hspec" value="&lt;b&gt;spec-loop&lt;/b&gt;（要求側のループ）&lt;br&gt;req-loop → spec-review → feasibility → proposal → scaffold&lt;br&gt;相手: 利用者・予算責任者・決裁者 ／ 関門: サインオフのタグをスクリプトで照合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="160" y="140" width="580" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="bar-hdev" value="&lt;b&gt;dev-loop&lt;/b&gt;&lt;br&gt;Issue 1 件を&lt;br&gt;verify が通るまで 1 周" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="140" width="260" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="e-handoff" value="1 機能 = Issue 1 件&lt;br&gt;＋ Red テスト" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="bar-hspec" target="bar-hdev">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-gap" value="仕様の穴は Q&amp;A 表へ差し戻し" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;dashed=1;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="bar-hdev" target="bar-hspec">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="935" y="270"/>
              <mxPoint x="460" y="270"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- dpolivaev bar -->
        <mxCell id="bar-dpol" value="&lt;b&gt;Spec Loop&lt;/b&gt;（次の小さな仕様を回す）&lt;br&gt;clarify → plan → 承認 → 実装 → review → 承認&lt;br&gt;相手: 開発者 ／ 関門: 人間の承認（PLAN→EXECUTION→DONE）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="760" y="300" width="340" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="dpol-weak" value="広い問題領域の分析は守備範囲外（自己評価 ★★）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;dashed=1;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="320" width="450" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="hdknr の spec-loop は dev-loop の「手前」、dpolivaev の Spec Loop は dev-loop と同じ「実装の周」に重なる" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="160" y="440" width="940" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
