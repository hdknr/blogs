mxCell id="c16" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="305" width="70" height="40" as="geometry"/></mxCell><mxCell id="c17" value="営業" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="305" width="70" height="40" as="geometry"/></mxCell><mxCell id="c18" value="開発" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="305" width="70" height="40" as="geometry"/></mxCell><mxCell id="c19" value="営業" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="430" y="305" width="70" height="40" as="geometry"/></mxCell><mxCell id="c20" value="100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="305" width="70" height="40" as="geometry"/></mxCell><mxCell id="c21" value="250" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="305" width="70" height="40" as="geometry"/></mxCell><mxCell id="c22" value="80" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="305" width="70" height="40" as="geometry"/></mxCell><mxCell id="c23" value="SUM(金額) は金額の列だけ読めばよい。同じ型が並ぶので圧縮も効く。1 行の更新は列ごとに書き換えが要る" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="880" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
