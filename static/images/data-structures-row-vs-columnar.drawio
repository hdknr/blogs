<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0"><diagram id="row-vs-columnar" name="Row vs Columnar"><mxGraphModel dx="1000" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="同じ表（id・部署・金額）をディスクに並べる 2 つの方法" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="15" width="880" height="30" as="geometry"/></mxCell><mxCell id="c2" value="行指向（PostgreSQL・MySQL など OLTP）：1 行ぶんの値を続けて置く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="940" height="170" as="geometry"/></mxCell><mxCell id="c3" value="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="105" width="70" height="40" as="geometry"/></mxCell><mxCell id="c4" value="営業" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="130" y="105" width="70" height="40" as="geometry"/></mxCell><mxCell id="c5" value="100" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="200" y="105" width="70" height="40" as="geometry"/></mxCell><mxCell id="c6" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="290" y="105" width="70" height="40" as="geometry"/></mxCell><mxCell id="c7" value="開発" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="