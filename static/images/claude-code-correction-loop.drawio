<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="claude-code-correction-loop" name="Claude Code Correction Loop">
    <mxGraphModel dx="1300" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Claude Code 訂正ループ — 設定を足すのではなく、訂正の回数を増やす" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- Band A: correction loop -->
        <mxCell id="band-a" value="訂正ループ（毎日これを回す）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1160" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="① 計画を突き返す&#xa;&#xa;Plan モードで plan.md を出させ、&#xa;「実装はまだするな」と何往復も" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="125" width="200" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="② 実装させる&#xa;&#xa;詰まったら押し通さず&#xa;Plan モードへ戻る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="125" width="200" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="③ 間違いを直す&#xa;&#xa;「この変更について私を問い詰めて、&#xa;合格するまで PR を作るな」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="530" y="125" width="200" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="④ その場で書き戻させる&#xa;&#xa;「同じミスを繰り返さないよう&#xa;CLAUDE.md を更新して」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="760" y="125" width="200" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="⑤ 削る&#xa;&#xa;/doctor で CLAUDE.md と skills を&#xa;サイズ適正化する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="990" y="125" width="180" height="95" as="geometry"/>
        </mxCell>

        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a51" value="この往復の回数が成果を決める" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4472C4;strokeWidth=2.5;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=11;fontColor=#4472C4;fontStyle=1;" edge="1" parent="1" source="s5" target="s1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1080" y="275"/>
              <mxPoint x="170" y="275"/>
            </Array>
            <mxPoint x="-320" y="-14" as="offset"/>
          </mxGeometry>
        </mxCell>

        <!-- Band B: where corrections go -->
        <mxCell id="band-b" value="④ の行き先 — レイヤーを混ぜない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="560" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="CLAUDE.md = 提案&#xa;会話が長くなると古い行の影響力は薄れる。&#xa;守られない前提で書く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="hooks = 強制&#xa;破壊的な操作は PreToolUse hook でブロックする。&#xa;文章での禁止は強制にならない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="465" width="500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="skills = 反復の削除&#xa;1 日 2 回以上やる操作だけを skill にする。&#xa;git 管理してチームで共有する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="550" width="500" height="70" as="geometry"/>
        </mxCell>

        <!-- Band C: context externalisation -->
        <mxCell id="band-c" value="ループを回し続けるための土台 — コンテキストの外部化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="640" y="330" width="560" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="c1" value="進捗は plan.md / tasks.md に書き出す&#xa;会話の中だけに置かない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="380" width="500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c2" value="セッション終わりに HANDOFF.md を書かせる&#xa;何を試し、何が効き、何が駄目だったかを残す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="465" width="500" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="c3" value="残量を /statusline で常時表示し、早めに /clear&#xa;会話を捨てるのは記憶を諦めることではない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="550" width="500" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ab" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="s4" target="band-b">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Footer note -->
        <mxCell id="note" value="増やしているのは設定の数ではなく、間違いを直した回数である" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#4472C4;" vertex="1" parent="1">
          <mxGeometry x="320" y="660" width="600" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
