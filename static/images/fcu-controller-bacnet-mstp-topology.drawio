        <mxCell id="t4" value="" style="endArrow=none;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.5;" edge="1" parent="1" source="ctrl4">
          <mxGeometry relative="1" as="geometry"><mxPoint x="540" y="419" as="targetPoint"/></mxGeometry>
        </mxCell>

        <mxCell id="term1" value="終端抵抗&#xa;120 Ω" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="505" y="106" width="70" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="term2" value="終端抵抗&#xa;120 Ω" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="505" y="488" width="70" height="34" as="geometry"/>
        </mxCell>

        <mxCell id="mstpnote" value="トークンパッシング（送信権を回す）&#xa;9.6 / 19.2 / 38.4 / 76.8 kbps（初期値 76.8）&#xa;1 CH あたり自社機器 50 台まで / 最長 1000 m&#xa;分岐不可 ― デイジーチェーン配線&#xa;全機器で同一ボーレート・Max_Master を揃える" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="310" y="545" width="350" height="90" as="geometry"/>
        </mxCell>

        <!-- IP layer group -->
        <mxCell id="ip-group" value="BACnet/IP 側" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="240" height="580" as="geometry"/>
        </mxCell>

        <mxCell id="gc" value="ジェネラルコントローラ&#xa;（MS/TP ⇔ BACnet/IP ルータ）&#xa;RS-485 幹線 2 CH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="725" y="180" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="bms" value="中央監視装置 / BAS&#xa;savic-net、Metasys など" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="725" y="300" width="190" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="IoT ゲートウェイ&#xa;BAC0 / BACpypes&#xa;ReadProperty・COV 購読" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="725" y="400" width="190" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="ipnote" value="BACnet/IP は UDP 47808（0xBAC0）&#xa;ルータ配下のネットワーク番号を指定して&#xa;MS/TP 機器に到達する" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="720" y="490" width="215" height="60" as="geometry"/>
        </mxCell>

        <!-- Cloud -->
        <mxCell id="cloud" value="クラウド&#xa;時系列 DB・可視化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="400" width="180" height="66" as="geometry"/>
