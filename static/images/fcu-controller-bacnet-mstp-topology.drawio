        </mxCell>
        <mxCell id="sensor1" value="温度センサ&#xa;Pt100 / Pt1000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="176" width="120" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="panel1" value="設定器&#xa;ネオパネル 2 など" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="242" width="120" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="dio1" value="汎用 DI / DO&#xa;インターロック・加湿器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="308" width="120" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="fieldnote" value="専用シリアル 100 bps&#xa;（設定器側）&#xa;RJ-45 / LAN ケーブル配線" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="55" y="372" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- MS/TP trunk group -->
        <mxCell id="mstp-group" value="RS-485 幹線 ― BACnet MS/TP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="290" y="70" width="380" height="580" as="geometry"/>
        </mxCell>

        <mxCell id="ctrl1" value="FCU コントローラ&#xa;形 WJ-1202&#xa;MAC 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="150" width="150" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="ctrl2" value="FCU コントローラ&#xa;形 WJ-1202&#xa;MAC 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="235" width="150" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="ctrl3" value="VAV コントローラ&#xa;形 WJ-1201" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="320" width="150" height="48" as="geometry"/>
        </mxCell>
