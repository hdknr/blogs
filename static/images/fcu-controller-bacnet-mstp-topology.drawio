          <mxGeometry relative="1" as="geometry"><mxPoint x="540" y="264" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="t3" value="" style="endArrow=none;html=1;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.5;" edge="1" parent="1" source="ctrl3">
          <mxGeometry relative="1" as="geometry"><mxPoint x="540" y="344" as="targetPoint"/></mxGeometry>
