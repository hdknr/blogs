        <mxCell id="e-cloud" value="MQTT / HTTPS" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gw" target="cloud">
