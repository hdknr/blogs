        <mxCell id="e-gw" value="BACnet/IP" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="bms" target="gw">
          <mxGeometry relative="1" as="geometry"/>
