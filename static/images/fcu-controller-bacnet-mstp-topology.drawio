<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="fcu-bacnet-mstp" name="FCU Controller BACnet MS/TP Topology">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="FCU コントローラと BACnet MS/TP のネットワーク構成" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="320" y="18" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Field layer group -->
        <mxCell id="field-group" value="現場側（居室）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="230" height="580" as="geometry"/>
        </mxCell>

        <mxCell id="fcu1" value="ファンコイル&#xa;ユニット (FCU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
