            <mxPoint x="975" y="545" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c3-curve" value="" style="curved=1;endArrow=none;html=1;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
