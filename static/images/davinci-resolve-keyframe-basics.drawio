<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="davinci-keyframe-basics" name="Keyframe Basics">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="キーフレームは「値」ではなく「値の変化」を定義する" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="500" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="2 点打てば、その間はソフトが自動補間する（＝インビトウィーン）" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="500" height="20" as="geometry"/>
        </mxCell>

        <!-- ===== Panel 1: timeline with two keyframes ===== -->
        <mxCell id="p1-box" value="① インスペクタで 2 点打つ（例: ズーム 1.0 → 1.3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="980" height="245" as="geometry"/>
        </mxCell>

        <!-- inspector panel mock -->
        <mxCell id="insp-box" value="インスペクタ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="90" y="135" width="260" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="insp-row1" value="ズーム&#xa;1.000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="105" y="165" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="insp-dia1" value="◆" style="text;html=1;fontSize=18;align=center;verticalAlign=middle;fontColor=#e07b39;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="175" width="30" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="insp-row2" value="位置 X&#xa;0.00" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="105" y="215" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="insp-dia2" value="◇" style="text;html=1;fontSize=18;align=center;verticalAlign=middle;fontColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="300" y="225" width="30" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="insp-note" value="◇ グレー＝未設定 ／ ◆ オレンジ＝そのフレームにキーフレームあり" style="text;html=1;fontSize=10;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="90" y="300" width="300" height="30" as="geometry"/>
        </mxCell>

        <!-- arrow -->
        <mxCell id="arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="205" as="sourcePoint"/>
            <mxPoint x="420" y="205" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- timeline -->
        <mxCell id="tl-line" value="" style="endArrow=block;html=1;strokeColor=#333333;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="450" y="250" as="sourcePoint"/>
