        <mxCell id="kf-b" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e07b39;strokeColor=#a85a20;" vertex="1" parent="1">
          <mxGeometry x="880" y="238" width="24" height="24" as="geometry"/>
