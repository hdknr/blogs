            <mxPoint x="700" y="200" as="sourcePoint"/>
            <mxPoint x="700" y="240" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- ===== Panel 2: interpolation curves ===== -->
        <mxCell id="p2-box" value="② 補間のしかた（イージング）で「印象」が決まる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="980" height="310" as="geometry"/>
        </mxCell>

        <!-- Linear -->
        <mxCell id="c1-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="95" y="395" width="280" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="c1-title" value="リニア（既定）" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="95" y="400" width="280" height="24" as="geometry"/>
