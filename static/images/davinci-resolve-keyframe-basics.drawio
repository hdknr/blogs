          <mxGeometry x="812" y="270" width="160" height="35" as="geometry"/>
        </mxCell>

        <mxCell id="between-band" value="この区間は誰も打っていない＝自動補間される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontColor=#7f6000;" vertex="1" parent="1">
          <mxGeometry x="520" y="165" width="360" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="band-arr" style="edgeStyle=none;rounded=0;html=1;strokeColor=#d6b656;strokeWidth=1;dashed=1;endArrow=none;" edge="1" parent="1" source="between-band">
