          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="440" as="sourcePoint"/>
            <mxPoint x="130" y="545" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c1-axis-x" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="545" as="sourcePoint"/>
            <mxPoint x="345" y="545" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c1-curve" value="" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="545" as="sourcePoint"/>
            <mxPoint x="340" y="445" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c1-desc" value="等速。機械的で、モーショングラフィックス的な硬さが出る" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="100" y="550" width="270" height="30" as="geometry"/>
        </mxCell>

        <!-- Ease In and Out -->
        <mxCell id="c2-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="410" y="395" width="280" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="c2-title" value="イーズイン＆アウト" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="410" y="400" width="280" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="c2-axis-y" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="440" as="sourcePoint"/>
            <mxPoint x="445" y="545" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c2-axis-x" value="" style="endArrow=none;html=1;strokeColor=#999999;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="545" as="sourcePoint"/>
            <mxPoint x="660" y="545" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c2-curve" value="" style="curved=1;endArrow=none;html=1;strokeColor=#9673a6;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="445" y="545" as="sourcePoint"/>
            <mxPoint x="655" y="445" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="530" y="540"/>
              <mxPoint x="575" y="450"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c2-desc" value="ゆっくり動き出し、ゆっくり止まる。人の目に「自然」に見える" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="415" y="550" width="270" height="30" as="geometry"/>
        </mxCell>

        <!-- Bezier -->
        <mxCell id="c3-box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1">
          <mxGeometry x="725" y="395" width="280" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="c3-title" value="ベジェハンドルで調整" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="725" y="400" width="280" height="24" as="geometry"/>
        </mxCell>
