          </mxGeometry>
        </mxCell>
        <mxCell id="c3-handle" value="" style="endArrow=oval;html=1;strokeColor=#b85450;strokeWidth=1;dashed=1;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="545" as="sourcePoint"/>
            <mxPoint x="835" y="543" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="c3-desc" value="イーズをかけると生えるハンドルを引き、緩急を作り込む" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="730" y="550" width="270" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="p2-note" value="縦軸＝パラメーターの値（ズーム量・不透明度など）、横軸＝時間。2 点は同じでも、間の「傾きの付け方」で見え方が変わる" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#3b6ea5;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="100" y="600" width="900" height="40" as="geometry"/>
