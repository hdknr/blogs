          <mxGeometry x="1000" y="255" width="40" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="kf-a" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e07b39;strokeColor=#a85a20;" vertex="1" parent="1">
          <mxGeometry x="490" y="238" width="24" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="kf-a-label" value="キーフレーム A&#xa;00:00:00:00 / ズーム 1.0" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#a85a20;" vertex="1" parent="1">
          <mxGeometry x="422" y="270" width="160" height="35" as="geometry"/>
