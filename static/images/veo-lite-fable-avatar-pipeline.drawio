<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="veo-lite-fable-pipeline" name="Fable + Veo Lite pipeline">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="1 行の依頼から 24 秒のアバター動画まで（推定される分担）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="15" width="700" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="req" value="人間&lt;br&gt;&lt;br&gt;「アバター動画を&lt;br&gt;作って」&lt;br&gt;（1 行の依頼）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="150" width="150" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="fable" value="&lt;b&gt;Claude Fable 5.2&lt;/b&gt;&lt;br&gt;（オーケストレーター）&lt;br&gt;&lt;br&gt;・台本とカット割り&lt;br&gt;・Veo 用プロンプト&lt;br&gt;・3D 素材を作るコード&lt;br&gt;・BGM を作るコード&lt;br&gt;・編集の指示（ffmpeg）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="230" y="105" width="230" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="veo" value="&lt;b&gt;Veo 3.1 Lite&lt;/b&gt;&lt;br&gt;&lt;br&gt;・人物の映像&lt;br&gt;・声（音声は同時生成）&lt;br&gt;・1 クリップ最大 8 秒" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="210" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="local" value="&lt;b&gt;ローカル実行&lt;/b&gt;&lt;br&gt;&lt;br&gt;・3D レンダリング&lt;br&gt;・BGM の書き出し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="230" width="210" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="ff" value="&lt;b&gt;ffmpeg で結合&lt;/b&gt;&lt;br&gt;&lt;br&gt;クリップ連結&lt;br&gt;＋ BGM ミックス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="150" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="out" value="完成動画&lt;br&gt;24 秒 / 1080p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="170" width="140" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="req" target="fable">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="プロンプト" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="fable" target="veo">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="コード" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="fable" target="local">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="veo" target="ff">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="local" target="ff">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="ff" target="out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="※ 元の投稿が明かしているのは「台本・編集・3D・音楽＝Fable 5.2、映像・声＝Veo 3.1 Lite」という分担だけ。各工程の中身はこの記事による推定" style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="360" width="1100" height="40" as="geometry"/>
