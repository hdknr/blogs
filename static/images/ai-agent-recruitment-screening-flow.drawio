<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="ai-screening-flow" name="AI Screening Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="AIエージェントによるES事前評価フロー" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="440" height="30" as="geometry"/>
        </mxCell>

        <!-- Input -->
        <mxCell id="input" value="応募書類&#xa;(PDF / テキスト)&#xa;&#xa;ES・履歴書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="180" height="120" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="step1" value="1. 構造化・抽出&#xa;&#xa;&#x2022; 職歴 / スキル&#xa;&#x2022; 資格 / 語学力&#xa;&#x2022; アピールポイント&#xa;→ JSON へ整理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="290" y="140" width="200" height="140" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="step2" value="2. 評価基準との照合&#xa;&#xa;ルーブリックに基づく&#xa;スコアリングと理由付け&#xa;(AIエージェント)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="200" height="140" as="geometry"/>
        </mxCell>

        <!-- Step 3 -->
        <mxCell id="step3" value="3. 結果の出力&#xa;&#xa;&#x2022; 強み / 懸念点の要約&#xa;&#x2022; 推奨度スコア&#xa;&#x2022; 面接での深掘り質問案" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;align=center;spacingTop=5;" vertex="1" parent="1">
          <mxGeometry x="830" y="140" width="200" height="140" as="geometry"/>
        </mxCell>

        <!-- Human -->
        <mxCell id="human" value="&#x1f464; 最終判断は人間&#xa;(Human-in-the-Loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;verticalAlign=middle;align=center;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="160" width="90" height="100" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="input" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="step3" target="human">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
