        <mxCell id="c2" value="電波状況の変動・ハンドオーバー&#10;無通信での RRC 解放（＝正常動作）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#cccccc;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
