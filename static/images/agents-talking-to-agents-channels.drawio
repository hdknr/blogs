        <mxCell id="g2e3" value="SendMessage" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g2t1" target="g2t2">
