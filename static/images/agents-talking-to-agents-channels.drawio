        <!-- Group 4: A2A -->
        <mxCell id="g4" value="④ A2A プロトコル（ベンダー・組織をまたぐ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
