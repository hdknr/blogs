        <mxCell id="g3e1" value="SendMessage" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;fontColor=#b85450;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="g3s1" target="g3s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="g3e2" value="Remote Control 経由" style="endArrow=classic;html=1;strokeColor=#9673a6;dashed=1;fontSize=11;fontColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g3s1" target="g3s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="g3sub" value="ListAgents で相手を探す&lt;br&gt;同一マシンはローカルソケット" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="300" y="530" width="210" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="g3note" value="届くのはテキストだけ。承認や設定変更の代わりにはならない" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="675" width="440" height="40" as="geometry"/>
