<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="agent-channels" name="エージェント同士の会話経路">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="エージェント同士を会話させる 4 つの経路" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Group 1: Subagent -->
        <mxCell id="g1" value="① サブエージェント（1 セッション内）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="500" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="g1parent" value="親エージェント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="100" width="160" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="g1c1" value="子 A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g1c2" value="子 B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="240" width="120" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g1e1" value="委任" style="endArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=11;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g1parent" target="g1c1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="g1e2" value="委任" style="endArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=11;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="g1parent" target="g1c2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="g1note" value="子は最終報告を親に返す。やり取りは基本的に親経由" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="440" height="40" as="geometry"/>
        </mxCell>

        <!-- Group 2: Agent Teams -->
        <mxCell id="g2" value="② Agent Teams（リーダーが起動したチーム）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="570" y="60" width="500" height="320" as="geometry"/>
