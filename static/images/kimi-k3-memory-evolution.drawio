<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="kimi-k3-memory-evolution" name="Attention Memory Evolution">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Attention の「記憶」の設計変更 — GPT-2 から Kimi K3 まで" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Stage 1: Full Attention + KV Cache -->
        <mxCell id="s1-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="270" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="s1-label" value="&#x2460; Full Attention + KV キャッシュ" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="55" y="90" width="240" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="s1-sub" value="GPT-2 以降の標準" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="55" y="112" width="240" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="s1-t1" value="トークン 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="145" width="70" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s1-t2" value="トークン 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="176" width="110" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s1-t3" value="トークン 3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="207" width="150" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s1-t4" value="トークン 4" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="238" width="190" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s1-tn" value="トークン N" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b1c9e8;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="269" width="220" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="s1-arrow" value="" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="145" as="sourcePoint"/>
            <mxPoint x="60" y="300" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="s1-note" value="キャッシュは文脈長に比例して&#xa;増え続ける&#xa;&#xa;&#x2192; 100万トークンでは&#xa;&#x3000;&#x3000;保存・転送コストが支配的" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s1-good" value="&#x2714; 過去のどこでも精密に参照できる" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#3d7a3d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="435" width="220" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="s1-bad" value="&#x2716; メモリが O(文脈長) で増加" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="70" y="470" width="220" height="35" as="geometry"/>
        </mxCell>

        <!-- Stage 2: Linear Attention -->
        <mxCell id="s2-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="340" y="80" width="270" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="s2-label" value="&#x2461; 線形 Attention" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="355" y="90" width="240" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="s2-sub" value="固定サイズの状態へ折りたたむ" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="355" y="112" width="240" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="s2-state" value="固定サイズの状態&#xa;（ホワイトボード）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="180" width="130" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s2-in" value="新トークン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="145" width="90" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="s2-arr1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="s2-in" target="s2-state">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s2-loop" value="上書き更新" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;curved=1;fontSize=10;labelBackgroundColor=#f5f5f5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="200" as="sourcePoint"/>
            <mxPoint x="560" y="250" as="targetPoint"/>
            <Array as="points">
              <mxPoint x="590" y="225"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="s2-note" value="サイズが文脈長に依存しない&#xa;&#xa;&#x2192; 100万トークンでも&#xa;&#x3000;&#x3000;状態のサイズは一定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="320" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s2-good" value="&#x2714; メモリが O(1)。長文でも軽い" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#3d7a3d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="370" y="435" width="220" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="s2-bad" value="&#x2716; 書き込むほど古い情報と混ざり、&#xa;&#x3000;必要な事実までぼやける" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="370" y="470" width="220" height="35" as="geometry"/>
        </mxCell>

        <!-- Stage 3: DeltaNet family -->
        <mxCell id="s3-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;verticalAlign=top;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="270" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="s3-label" value="&#x2462; DeltaNet 系" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="655" y="90" width="240" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="s3-sub" value="足すのではなく「差分で直す」" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="655" y="112" width="240" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="s3-old" value="現在の状態から&#xa;同じ手がかりで読める内容" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="665" y="145" width="230" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="s3-delta" value="差分（Δ）だけを更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="665" y="205" width="230" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="s3-arr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="s3-old" target="s3-delta">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s3-gate" value="Gated DeltaNet: さらに&#xa;「古い情報をどれだけ薄めるか」を調整" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="665" y="260" width="230" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="s3-arr2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="s3-delta" target="s3-gate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="s3-note" value="例：「会議は火曜」→「水曜へ変更」&#xa;&#xa;両方を残さず、差し替えるべき&#xa;場所だけを更新する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="670" y="325" width="220" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="s3-good" value="&#x2714; 限られた記憶を雑に上書きしない" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#3d7a3d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="670" y="435" width="220" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="s3-bad" value="&#x2716; 忘れ方の調整が記憶全体で一律" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#b85450;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="670" y="470" width="220" height="35" as="geometry"/>
        </mxCell>

        <!-- Stage 4: KDA -->
        <mxCell id="s4-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4fc;strokeColor=#4472C4;verticalAlign=top;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="940" y="80" width="260" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="s4-label" value="&#x2463; Kimi Delta Attention" style="text;html=1;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;fontColor=#4472C4;" vertex="1" parent="1">
          <mxGeometry x="950" y="90" width="240" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="s4-sub" value="「忘れ方」を成分ごとに細分化" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#5a7fc0;" vertex="1" parent="1">
          <mxGeometry x="950" y="112" width="240" height="18" as="geometry"/>
        </mxCell>

        <mxCell id="s4-c1" value="成分 A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="965" y="150" width="70" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s4-g1" value="残す率 0.9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1055" y="150" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s4-c2" value="成分 B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="965" y="182" width="70" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s4-g2" value="残す率 0.3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1055" y="182" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s4-c3" value="成分 C" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="965" y="214" width="70" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s4-g3" value="残す率 0.7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1055" y="214" width="120" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s4-c4" value="成分 D" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="965" y="246" width="70" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="s4-g4" value="残す率 0.1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1055" y="246" width="120" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="s4-note" value="Gated DeltaNet の減衰調整を&#xa;記憶全体で一律にせず、より&#xa;細かい単位で行う&#xa;&#xa;&#x203b; 学習された値による調整であり、&#xa;&#x3000; 人間的な「理解して忘れる」ではない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4472C4;fontSize=10;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="965" y="320" width="215" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s4-good" value="&#x2714; 不要な情報を残しすぎず、&#xa;&#x3000;必要な情報を消しすぎない" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#3d7a3d;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="965" y="435" width="215" height="35" as="geometry"/>
        </mxCell>
        <mxCell id="s4-next" value="&#x2192; それでも単独では不十分。&#xa;&#x3000;K3 は MLA と混ぜて使う" style="text;html=1;fontSize=10;fontStyle=1;align=left;verticalAlign=middle;fontColor=#4472C4;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="965" y="470" width="215" height="35" as="geometry"/>
        </mxCell>

        <!-- Flow arrows between stages -->
        <mxCell id="fl1" value="" style="endArrow=classic;html=1;strokeColor=#4472C4;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="313" y="225" as="sourcePoint"/>
            <mxPoint x="337" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="fl2" value="" style="endArrow=classic;html=1;strokeColor=#4472C4;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="613" y="225" as="sourcePoint"/>
            <mxPoint x="637" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="fl3" value="" style="endArrow=classic;html=1;strokeColor=#4472C4;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="913" y="225" as="sourcePoint"/>
            <mxPoint x="937" y="225" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Bottom takeaway -->
        <mxCell id="takeaway" value="観点は 3 つ： 何を覚えるか（全部保存か固定メモか） / 何を入れ替えるか（差分更新と減衰） / どこを探し直すか（元の文脈への再参照）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="575" width="1160" height="40" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
