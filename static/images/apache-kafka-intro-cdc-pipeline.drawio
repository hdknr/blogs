<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="kafka-cdc" name="CDC pipeline with Kafka Connect and Debezium">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Debezium + Kafka Connect による CDC：業務 DB の変更を検索・RAG へ流す" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="15" width="800" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="db" value="業務 DB&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PostgreSQL / MySQL&lt;br&gt;（WAL・binlog）&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="150" width="140" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="src" value="Kafka Connect&lt;br&gt;&lt;b&gt;Debezium&lt;/b&gt; ソースコネクター&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;変更ログを読み、行の変更を&lt;br&gt;イベントに変換&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="160" width="190" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="kafka" value="Kafka&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;テーブルごとのトピック&lt;br&gt;（挿入・更新・削除のイベント）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="150" width="180" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="sink1" value="シンクコネクター&lt;br&gt;→ 検索エンジン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="70" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sink2" value="埋め込みワーカー&lt;br&gt;→ ベクトル DB（RAG）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="178" width="190" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="sink3" value="シンクコネクター&lt;br&gt;→ DWH・レイクハウス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="286" width="190" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="読み手はそれぞれ自分のコンシューマーグループで、自分のペースで読む。新しい読み手を足しても業務 DB の負荷は増えない" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="910" y="160" width="170" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="変更ログ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="db" target="src">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="src" target="kafka">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="kafka" target="sink1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="205"/><mxPoint x="670" y="97"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="kafka" target="sink2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="kafka" target="sink3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="670" y="205"/><mxPoint x="670" y="313"/></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
