        <mxCell id="title" value="シトラム / クライナー — 「点 → 線 → 面」の市場展開" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
