<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="cto-absent-layers" name="CTO不在組織の3層構造">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="CTO / CISO 不在組織の役割分担（3 層構造）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Layer 1 -->
        <mxCell id="exec" value="&lt;b&gt;① 意思決定・最終責任&lt;/b&gt;&lt;br&gt;経営層 / コーポレート担当役員&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;・事業リスクの許容度を決める&lt;br&gt;・予算を承認する&lt;br&gt;・対外公表を最終判断する&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="340" height="130" as="geometry"/>
        </mxCell>

        <!-- Layer 2 -->
        <mxCell id="ops" value="&lt;b&gt;② 平時の基盤運用・技術実行&lt;/b&gt;&lt;br&gt;情シス&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;・アカウント管理&lt;br&gt;・端末 / SaaS の統制&lt;br&gt;・バックアップ&lt;br&gt;・有事は隔離・停止の実行部隊&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="320" height="160" as="geometry"/>
        </mxCell>

        <!-- Layer 3 -->
        <mxCell id="csirt" value="&lt;b&gt;③ 有事のトリアージ・横断調整&lt;/b&gt;&lt;br&gt;CSIRT（兼務チーム）&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;・コマンダー：業務停止・隔離を判断&lt;br&gt;・PoC：法務・広報・外部機関と連絡&lt;br&gt;・平時は情シス・総務・法務の兼務&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="320" height="160" as="geometry"/>
        </mxCell>

        <!-- External advisor -->
        <mxCell id="advisor" value="&lt;b&gt;外部技術顧問 / 外部 CISO&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;アーキテクチャ・セキュリティ方針を月次レビュー&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="320" height="60" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="方針・指示" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="exec" target="ops">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="エスカレーション" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="csirt" target="exec">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="隔離・停止の指示" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="csirt" target="ops">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="レビュー" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#999999;strokeWidth=1.5;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="advisor" target="ops">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
