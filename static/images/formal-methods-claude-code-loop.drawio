          <mxGeometry x="340" y="60" width="320" height="680" as="geometry"/>
        </mxCell>
        <mxCell id="n_lane_v" value="検査器（判定する）" style="swimlane;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="300" height="680" as="geometry"/>
