        <mxCell id="n_run" value="全入力・全インターリーブを調べる&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Z3: sat / unsat　TLC: 反例トレース&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
