        <mxCell id="n_spec" value="仕様・設計を自然言語で書く&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SPEC.md / DESIGN.md&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n_model" value="主張を抜き出して形式化する&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Z3 の制約 / TLA+ の状態遷移と不変条件&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
