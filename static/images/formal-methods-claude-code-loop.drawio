        <mxCell id="n_fixmodel" value="モデルの前提を疑って直す&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;原子性・ロック・リトライの仮定など&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
