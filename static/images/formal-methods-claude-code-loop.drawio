        <mxCell id="n_q" value="反例はあるか？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="220" width="160" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="n_repro" value="反例を実装のテストで再現する&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;同じ入力・同じ実行順を pytest で強制&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="230" width="240" height="60" as="geometry"/>
