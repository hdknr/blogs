<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="tf-design-spec-mapping" name="Design spec to Terraform mapping">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="設計指示書の 4 要素と Terraform の構造の対応" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="grpSpec" value="設計指示書（docs/ に Markdown で置く）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="400" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="grpTf" value="Terraform リポジトリ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="570" y="60" width="400" height="470" as="geometry"/>
        </mxCell>

        <mxCell id="spec1" value="&lt;b&gt;① 全体像と State 分割方針&lt;/b&gt;&lt;br&gt;構成図／分割単位／別 State の参照方法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="spec2" value="&lt;b&gt;② リソース一覧と命名規則&lt;/b&gt;&lt;br&gt;論理名・物理名のルール／共通タグ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="205" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="spec3" value="&lt;b&gt;③ パラメータシート&lt;/b&gt;&lt;br&gt;変数名・型・環境ごとの値・制約" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="spec4" value="&lt;b&gt;④ 機密情報・手動作業の境界&lt;/b&gt;&lt;br&gt;シークレットの渡し方／Bootstrap 手順" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="415" width="340" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="tf1" value="&lt;b&gt;ディレクトリと backend&lt;/b&gt;&lt;br&gt;01_network / 02_database / 03_app&lt;br&gt;terraform_remote_state・data ソース" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tf2" value="&lt;b&gt;locals と provider&lt;/b&gt;&lt;br&gt;name_prefix = &quot;${var.project}-${var.env}&quot;&lt;br&gt;provider &quot;aws&quot; の default_tags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="205" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tf3" value="&lt;b&gt;variables.tf と *.tfvars&lt;/b&gt;&lt;br&gt;variable の type・validation&lt;br&gt;dev.tfvars / prod.tfvars" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="310" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="tf4" value="&lt;b&gt;data ソースと README の手順&lt;/b&gt;&lt;br&gt;data &quot;aws_secretsmanager_secret&quot;&lt;br&gt;Terraform 管理外の Bootstrap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="415" width="340" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="spec1" target="tf1">
          <mxGeometry relative="1" as="geometry"/>
