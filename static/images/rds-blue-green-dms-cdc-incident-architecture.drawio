<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="dms-bluegreen-arch" name="RDS Blue/Green と DMS CDC の停止">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="RDS Blue/Green 切替で DMS の CDC が FATAL 停止するまで" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="18" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- Band A: before switch -->
        <mxCell id="band-before" value="① 切替前 — DMS は binlog の座標を checkpoint に記憶しながら CDC を流している" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1020" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="rds-blue" value="RDS MySQL 8.0&#xa;(blue)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="120" width="170" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="dms-ok" value="DMS Serverless&#xa;replication_type: cdc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="370" y="120" width="180" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="s3-ok" value="S3&#xa;(Parquet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="120" width="150" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="analytics" value="分析基盤" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="900" y="120" width="130" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="e-a1" value="CDC (binlog)" style="endArrow=block;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;fontColor=#4472C4;" edge="1" parent="1" source="rds-blue" target="dms-ok">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a2" value="" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="dms-ok" target="s3-ok">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a3" value="" style="endArrow=block;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="s3-ok" target="analytics">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="checkpoint-note" value="RecoveryCheckpoint&#xa;mysql-bin-changelog.473018 : 7237787" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;fontColor=#7d6608;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="335" y="206" width="250" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="e-cp" value="" style="endArrow=none;html=1;strokeColor=#d6b656;dashed=1;" edge="1" parent="1" source="dms-ok" target="checkpoint-note">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Band B: after switch -->
        <mxCell id="band-after" value="② Blue/Green 切替後 — エンドポイントが green を向く。green の binlog は blue の複製ではない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="296" width="1020" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="rds-green" value="RDS MySQL 8.4&#xa;(green)&#xa;別のインスタンス実体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="352" width="170" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="dms-ng" value="DMS Serverless&#xa;FATAL_ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="370" y="352" width="180" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="s3-ng" value="S3 への出力&#xa;ゼロ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="352" width="150" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="blind" value="18 日間&#xa;誰も気付かない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="352" width="130" height="76" as="geometry"/>
        </mxCell>

        <mxCell id="e-b1" value="473018 の続きを要求&#xa;→ そんな binlog は無い" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=2;fontSize=11;fontColor=#b85450;" edge="1" parent="1" source="rds-green" target="dms-ng">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-b2" value="" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1" source="dms-ng" target="s3-ng">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-b3" value="" style="endArrow=block;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" parent="1" source="s3-ng" target="blind">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="error-note" value="Error 1236 reading binary log&#xa;Stop Reason FATAL_ERROR / Error Level FATAL&#xa;resume-processing では二度と復帰できない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;fontColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="448" width="310" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e-err" value="" style="endArrow=none;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="dms-ng" target="error-note">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="switch-arrow" value="Blue/Green 切替&#xa;(ダウンタイム 25 秒)" style="endArrow=block;html=1;strokeColor=#9673a6;strokeWidth=3;fontSize=11;fontStyle=1;fontColor=#6c3483;" edge="1" parent="1" source="rds-blue" target="rds-green">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="lesson" value="binlog 座標の不連続は Blue/Green の仕様であり避けられない。避けられるのは「それが障害になること」——&#xa;切替前に CDC を停止し、CdcStartTime で再開すれば欠損は数十秒で済む。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#4a235a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="552" width="1020" height="60" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
