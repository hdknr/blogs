<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="agent-self-improvement-four-mechanisms" name="Self-Improvement Four Mechanisms">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
