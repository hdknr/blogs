        <mxCell id="title" value="自己改善ループを深層学習の訓練ループに対応させる" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="18" width="600" height="30" as="geometry"/>
