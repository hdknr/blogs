<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram name="mutation harness の1周" id="page-mutation-loop">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ttl" value="mutation harness の 1 周 — 壊して、測って、必ず戻す" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="24" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="カバレッジが測るのは「実行されたか」。mutation が測るのは「検査されたか」。コードを 1 箇所だけ壊し、テストが落ちるかを見る。" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="lp-l" value="&lt;b&gt;ループ&lt;/b&gt;（変異の表を上から順に）" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="360" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;1. 保存&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;対象ファイルの元の内容を&lt;br&gt;メモリに取る&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#7A9CC0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="140" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;2. 変異を当てる&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;1 箇所だけ・意味の単位で&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D9822B;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;3. テストを回す&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family: monospace; font-size: 10px&quot;&gt;pytest tests/… -q&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#7A9CC0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;4. 判定を記録&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;件数ではなく&lt;br&gt;&lt;b&gt;どのテストが落ちたか&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EEF4;strokeColor=#7A9CC0;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="440" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;5. 必ず復元&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-family: monospace; font-size: 10px&quot;&gt;finally: / trap … EXIT&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E8B57;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="150" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e12" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#7A9CC0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="210" as="sourcePoint" />
            <mxPoint x="105" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e23" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#7A9CC0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="310" as="sourcePoint" />
            <mxPoint x="105" y="340" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e34" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#7A9CC0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="410" as="sourcePoint" />
            <mxPoint x="105" y="440" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e45" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#7A9CC0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="105" y="510" as="sourcePoint" />
            <mxPoint x="105" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eback" value="次の変異へ" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#2E8B57;rounded=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;fontSize=10;fontColor=#2E8B57;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-10" y="575" />
              <mxPoint x="-10" y="275" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="jd-l" value="&lt;b&gt;判定の読み方&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="300" height="24" as="geometry" />
        </mxCell>

        <mxCell id="red" value="&lt;font color=&quot;#B03A2E&quot;&gt;&lt;b&gt;RED&lt;/b&gt;&lt;/font&gt;&amp;nbsp; テストが変異を検出した&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;その検査には&lt;b&gt;検出力がある&lt;/b&gt;。落ちたテスト名を表に残す&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B03A2E;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="140" width="430" height="70" as="geometry" />
        </mxCell>

        <mxCell id="green" value="&lt;font color=&quot;#2E8B57&quot;&gt;&lt;b&gt;GREEN&lt;/b&gt;&lt;/font&gt;&amp;nbsp; 検出できなかった&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;ここで止めない。&lt;b&gt;必ず 3 つに切り分ける&lt;/b&gt;（混ぜると次の人が誤読する）&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#2E8B57;align=left;verticalAlign=middle;spacingLeft=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="240" width="430" height="70" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="&lt;b&gt;A. 本当の穴&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;誰も検査していない。&lt;br&gt;&lt;b&gt;検査を足す&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B03A2E;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="350" width="135" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b&gt;B. 等価変異&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;意味が変わっていない。&lt;br&gt;より強い変異と重ねて&lt;br&gt;RED になることで示す&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#D6C68A;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="427" y="350" width="135" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="&lt;b&gt;C. 死んだコード&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;到達不能なガード。&lt;br&gt;&lt;b&gt;足さずに削る&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D9822B&quot;&gt;一番よく出て、&lt;br&gt;一番価値がある&lt;/font&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D9822B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="574" y="350" width="136" height="110" as="geometry" />
        </mxCell>

        <mxCell id="eg1" value="" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#2E8B57;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="347" y="310" as="sourcePoint" />
            <mxPoint x="347" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eg2" value="" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#2E8B57;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="494" y="310" as="sourcePoint" />
            <mxPoint x="494" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="eg3" value="" style="endArrow=block;html=1;strokeWidth=1.5;strokeColor=#2E8B57;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="642" y="310" as="sourcePoint" />
            <mxPoint x="642" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="tbl" value="&lt;b&gt;リポジトリに残すのはこれだけ — 結果の表&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;harness 本体は使い捨て。置きっぱなしにするとアンカーが腐り、「何も当たっていないスクリプト」になる。&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-family: monospace; font-size: 11px&quot;&gt;dry-run ガードを外す&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;font color=&quot;#B03A2E&quot;&gt;RED&lt;/font&gt;&amp;nbsp; &amp;nbsp;test_dry_run_writes_nothing&lt;br&gt;排他生成を上書き生成に戻す&amp;nbsp; &lt;font color=&quot;#2E8B57&quot;&gt;GREEN&lt;/font&gt;&amp;nbsp; —&amp;nbsp; 本当の穴。検査を足した&lt;br&gt;型ガードを消す&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;font color=&quot;#2E8B57&quot;&gt;GREEN&lt;/font&gt;&amp;nbsp; —&amp;nbsp; 死んだコード。削った&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#C8D0D6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="280" y="490" width="830" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ftr" value="復元を落とすと作業ツリーが壊れる。例外でも中断でも戻るよう、復元は finally / trap に置く — 各変異のあとの 1 回だけでは足りない。" style="text;html=1;fontSize=11;fontColor=#B03A2E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="640" width="1050" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
