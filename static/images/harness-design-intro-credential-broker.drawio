<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="credential-broker" name="Credential Broker">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="クレデンシャルを中継サーバーに閉じ込める構成" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Agent side -->
        <mxCell id="agentside" value="&lt;b&gt;エージェント&lt;/b&gt;&lt;br&gt;（モデル＋クライアント）&lt;br&gt;&lt;br&gt;持っているのは&lt;br&gt;期限の短いトークンだけ&lt;br&gt;&lt;i&gt;API キーは context に入らない&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="180" width="210" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="idp" value="&lt;b&gt;ID 基盤&lt;/b&gt;&lt;br&gt;（Amazon Cognito など）&lt;br&gt;個人アカウントで認証" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="210" height="80" as="geometry"/>
        </mxCell>

        <!-- Cloud boundary -->
        <mxCell id="cloud" value="クラウドアカウント内（境界）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=3;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="440" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="relay" value="&lt;b&gt;中継サーバー&lt;/b&gt;&lt;br&gt;（EC2、または API Gateway＋Lambda）&lt;br&gt;&lt;br&gt;許可した操作だけを公開&lt;br&gt;呼び出し元の個人を記録" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="180" width="320" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="secrets" value="&lt;b&gt;シークレット管理&lt;/b&gt;&lt;br&gt;（AWS Secrets Manager など）&lt;br&gt;API キーを読めるのは中継サーバーだけ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="400" width="320" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="auditlog" value="&lt;b&gt;監査ログ&lt;/b&gt;&lt;br&gt;誰が・どの操作を" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="100" width="150" height="55" as="geometry"/>
        </mxCell>

        <!-- External -->
        <mxCell id="extapi" value="&lt;b&gt;外部 API&lt;/b&gt;&lt;br&gt;（データソース）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="850" y="200" width="200" height="100" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-login" value="ログイン" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="agentside" target="idp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-call" value="トークン付きで&lt;br&gt;操作を依頼" style="endArrow=classic;html=1;strokeColor=#333333;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="agentside" target="relay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-secret" value="自分のロールで読み取り" style="endArrow=classic;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="relay" target="secrets">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-log" value="" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=1;dashed=1;" edge="1" parent="1" source="relay" target="auditlog">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-ext" value="API キー付きで呼び出し&lt;br&gt;（送信先は許可リストのみ）" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" edge="1" parent="1" source="relay" target="extapi">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
