<mxfile host="app.diagrams.net">
  <diagram name="センチメントとアテンションは別のシグナル">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="ソーシャルメディアから取れる 2 つのシグナル" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Cookson et al. (2025) “Market Signals from Social Media” の整理より" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="150" y="54" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sent_h" value="センチメント（何を感じているか）&#10;強気／弱気の表明を集計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="att_h" value="アテンション（何に注目しているか）&#10;言及数・投稿量を集計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sent_a" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="sent_h" target="sent_b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="att_a" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="att_h" target="att_b" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sent_b" value="高センチメントの日の前に株価は上昇し、&#10;その後 20 日かけて反転（リバーサル）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="att_b" value="高アテンションの日の前に株価は下落し、&#10;その後もマイナスが継続" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="210" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sent_c" value="→ 順張りの根拠にはならない。&#10;過熱＝逆張りの計器として使う" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="310" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="att_c" value="→ 注目の急増は「まだ下がる」の側。&#10;出尽くし判定は投稿量の“減衰”で見る" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="310" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sent_a2" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="sent_b" target="sent_c" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="att_a2" style="endArrow=classic;html=1;rounded=0;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="att_b" target="att_c" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="caveat" value="前提: 米国の個人投資家向けプラットフォーム（StockTwits / X / Seeking Alpha, 2013〜2021）。日本株にそのまま移植できる保証はない" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="680" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
