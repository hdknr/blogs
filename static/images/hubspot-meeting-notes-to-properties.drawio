<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="hubspot-meeting-notes-to-properties" name="HubSpot Meeting Notes To Properties">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="840" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="商談議事録をリードの構造化プロパティーに落とすまでの配管" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="12" width="700" height="28" as="geometry"/>
        </mxCell>

        <!-- Band 1 label -->
        <mxCell id="b1-label" value="&#x1f399;&#xfe0f; STEP 1 — 商談の生データが CRM に入る" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#4472C4;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="500" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="src" value="商談が終わる&#xa;&#xa;HubSpot コール / Zoom 連携 /&#xa;Google Meet 連携 / サードパーティー&#xa;通話プロバイダー、およびミーティング・&#xa;メモのアクティビティー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="300" height="106" as="geometry"/>
        </mxCell>

        <mxCell id="ci" value="文字起こし ＋ AI 通話要約 (CI)&#xa;&#xa;自動言語検出で文字起こし。要約は&#xa;「通話の目的 / 主要な論点 / 決定内容 /&#xa;センチメント / 次のステップ」に分かれる&#xa;※ Sales Hub または Service Hub の&#xa;Professional 以上が必要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="78" width="340" height="106" as="geometry"/>
        </mxCell>

        <mxCell id="caveat" value="&#x26a0;&#xfe0f; ここで止めると&#xa;「読めるが効かない」&#xa;&#xa;要約はコール側の自由記述で&#xa;編集不可。人は読めるが、&#xa;リードの絞り込み条件や&#xa;分岐には使いにくい" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="78" width="260" height="106" as="geometry"/>
        </mxCell>

        <mxCell id="a-src-ci" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="src" target="ci">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-ci-caveat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=1.5;dashed=1;endArrow=block;" edge="1" parent="1" source="ci" target="caveat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Band 2 label -->
        <mxCell id="b2-label" value="&#x1f916; STEP 2 — データエージェントで「判断できる形」に変換する" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#8064A2;" vertex="1" parent="1">
          <mxGeometry x="40" y="198" width="500" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="r1" value="スマートプロパティー&#xa;&#xa;プロパティー自体に AI プロンプトを&#xa;埋め込む。データソースに&#xa;「アクティビティーと文字起こし」を&#xa;選ぶと、コール・Eメール・ミーティング・&#xa;メモから値を作る&#xa;&#xa;スケジュール入力（日次/週次/月次）や&#xa;レコード作成時の自動入力を設定できる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="228" width="326" height="164" as="geometry"/>
        </mxCell>

        <mxCell id="r2" value="ワークフロー&#xa;「データエージェント：カスタムプロンプト」&#xa;&#xa;プロンプトは 3,000 文字まで。&#xa;インターネットに接続されず、&#xa;プロンプトに入れたデータしか見ない&#xa;&#xa;出力タイプに［列挙］を選べば、&#xa;返す値を選択肢に縛れる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="387" y="228" width="326" height="164" as="geometry"/>
        </mxCell>

        <mxCell id="r3" value="ワークフロー&#xa;「データエージェント：調査」&#xa;&#xa;データソースを「プロパティーデータ」か&#xa;「コールの文字起こし」から選ぶ。&#xa;文字起こしは関連付けられた&#xa;直近 5 件のみが対象&#xa;&#xa;戻り値の型は 文字列 / 数値 /&#xa;ブール値 の 3 択" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="734" y="228" width="326" height="164" as="geometry"/>
        </mxCell>

        <mxCell id="a-ci-r1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="r1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="192"/>
              <mxPoint x="18" y="192"/>
              <mxPoint x="18" y="294"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a-ci-r2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="r2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-ci-r3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci" target="r3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="570" y="192"/>
              <mxPoint x="1082" y="192"/>
              <mxPoint x="1082" y="294"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Write bar -->
        <mxCell id="bar" value="書き込み: ［レコードを編集］アクションで応答をプロパティーに入れる ／ ［スマートフィルプロパティー］で一括入力する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="412" width="1020" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="a-r1-bar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="r1" target="bar">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-r2-bar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="r2" target="bar">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-r3-bar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="r3" target="bar">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Band 3 label -->
        <mxCell id="b3-label" value="&#x1f4cb; STEP 3 — 着地させるプロパティーは 3 種類に分けて設計する" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0e8088;" vertex="1" parent="1">
          <mxGeometry x="40" y="456" width="500" height="22" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="&#x2460; 要約系&#xa;例: 問い合わせメモ要約 (AI)&#xa;&#xa;複数行テキスト。人が読むための項目。&#xa;引き継ぎと事前準備の時間を削る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="486" width="326" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="p2" value="&#x2461; 判定系&#xa;例: クレーム検知 (AI)&#xa;&#xa;出力の書式をプロンプトで固定する。&#xa;判定 / 要点 / 時期 / 対応 / 温度 /&#xa;反復 / 上申 のように行を決め打ちすると&#xa;一覧で数秒で読める" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="387" y="486" width="326" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="p3" value="&#x2462; 分類系&#xa;例: 部署カテゴリ (AI)&#xa;&#xa;「次世代総務企画部一課」→「総務・庶務系」&#xa;ドロップダウン / ラジオボタンにする。&#xa;&#x2605; ここだけが自動化の条件として効く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=11;fontStyle=1;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="734" y="486" width="326" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="a-bar-p1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar" target="p1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="18" y="430"/>
              <mxPoint x="18" y="541"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a-bar-p2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar" target="p2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-bar-p3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="bar" target="p3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1082" y="430"/>
              <mxPoint x="1082" y="541"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Band 4 -->
        <mxCell id="use" value="&#x26a1; STEP 4 — 構造化した値がそのまま自動化の入力になる&#xa;セグメントの絞り込み条件 ／ ワークフローの分岐と登録トリガー ／ リードスコアリングへの加点 ／ レポートでの効果測定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1020" height="66" as="geometry"/>
        </mxCell>

        <mxCell id="a-p3-use" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0e8088;strokeWidth=2.5;endArrow=block;" edge="1" parent="1" source="p3" target="use">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Cost note -->
        <mxCell id="note" value="&#x1f4b3; クレジットの注意点: スマートプロパティーは実行するだけで、値が入らなくても HubSpot クレジットを消費する。クレジットが尽きるとワークフローの&#xa;「データエージェント：カスタムプロンプト」は失敗し、出力に null が入る — 「該当なし」と区別できないので、null 側の分岐を必ず用意しておく。&#xa;クレジットは月次リセットで繰り越し不可。単価と付与数は HubSpot 製品・サービスカタログが正なので、運用前に必ず確認する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=2;verticalAlign=middle;dashed=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="704" width="1020" height="72" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
