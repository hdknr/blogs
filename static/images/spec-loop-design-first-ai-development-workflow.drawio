<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="spec-loop-workflow" name="Spec Loop Workflow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Spec Loop のワークフロー（1 周 = 次の小さな仕様 1 つ）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- PLAN phase group -->
        <mxCell id="plan-group" value="PLAN フェーズ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="400" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="clarify" value="clarify&lt;br&gt;未解決の論点を質問で潰す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="plan" value="plan&lt;br&gt;タスクファイルを書く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="250" y="120" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="taskfile" value="&lt;b&gt;タスクファイル&lt;/b&gt;&lt;br&gt;Scope / Motivation / Briefing&lt;br&gt;Research（現状・図）&lt;br&gt;Design（目標・図）&lt;br&gt;Test specification" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="230" y="220" width="190" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="breakdown" value="大きければ分割&lt;br&gt;（サブタスク / 複数タスク）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="250" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Approval gate -->
        <mxCell id="approve" value="人間が承認&lt;br&gt;PLAN → EXECUTION" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="170" width="150" height="110" as="geometry"/>
        </mxCell>

        <!-- EXECUTION phase group -->
        <mxCell id="exec-group" value="EXECUTION フェーズ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="630" y="80" width="230" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="impl" value="実装 + テスト&lt;br&gt;承認済み Design の範囲内で" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="120" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="livingdocs" value="生きたドキュメントも&lt;br&gt;同じ増分で更新&lt;br&gt;（仕様・ADR・用語集）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="210" width="170" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="review" value="review へ移動" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="310" width="170" height="45" as="geometry"/>
        </mxCell>

        <!-- Done gate -->
        <mxCell id="done" value="人間が承認&lt;br&gt;→ DONE" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="280" width="150" height="110" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="clarify" target="plan">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="plan" target="taskfile">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;dashed=1;" edge="1" parent="1" source="taskfile" target="breakdown">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="taskfile" target="approve">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="approve" target="impl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="impl" target="livingdocs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="livingdocs" target="review">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="review" target="done">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" value="仕様が変わる発見があれば PLAN に戻して再承認" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;dashed=1;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="impl" target="plan">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="745" y="65"/>
              <mxPoint x="325" y="65"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" value="次の小さな仕様へ（新しい依頼は必ず PLAN から）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#6c8ebf;fontSize=11;fontColor=#333333;" edge="1" parent="1" source="done" target="clarify">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="975" y="440"/>
              <mxPoint x="15" y="440"/>
              <mxPoint x="15" y="150"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
