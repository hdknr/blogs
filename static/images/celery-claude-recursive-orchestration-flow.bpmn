      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F15_di" bpmnElement="F15">
        <di:waypoint x="1370" y="735" />
        <di:waypoint x="1420" y="735" />
        <di:waypoint x="1420" y="825" />
        <di:waypoint x="370" y="825" />
