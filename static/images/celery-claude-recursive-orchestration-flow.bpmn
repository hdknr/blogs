        <di:waypoint x="920" y="248" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Note_Plan_di" bpmnElement="Note_Plan">
        <dc:Bounds x="215" y="544" width="145" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Group_AI_di" bpmnElement="Group_AI" bioc:stroke="#e65100" color:border-color="#e65100">
        <dc:Bounds x="540" y="508" width="180" height="124" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="776" y="512" width="150" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Legend_di" bpmnElement="Note_Legend" bioc:stroke="#e65100" color:border-color="#e65100">
        <dc:Bounds x="880" y="115" width="420" height="50" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
