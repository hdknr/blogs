<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="sdd-org-maturity-stages" name="SDD Maturity Stages">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="組織で SDD を育てる 6 つの段階" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="band-indiv" value="個人・1 リポジトリ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="20" y="60" width="380" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="band-org" value="複数チーム・複数リポジトリ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="410" y="60" width="380" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="band-gov" value="組織の仕組み" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="800" y="60" width="380" height="270" as="geometry"/>
        </mxCell>

        <mxCell id="st1" value="&lt;b&gt;1. 実験&lt;/b&gt;&lt;br&gt;意図を明示する&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ゼロフェーズで文脈を集め、&lt;br&gt;AI の推測を要件にしない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="165" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="st2" value="&lt;b&gt;2. 再現性&lt;/b&gt;&lt;br&gt;チームの実践にする&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;成果物をバージョン管理し、&lt;br&gt;成果物ごとにレビューの問いを持つ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="100" width="165" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="st3" value="&lt;b&gt;3. 一貫性&lt;/b&gt;&lt;br&gt;共通ルール＋現場の裁量&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;全社原則・技術標準・&lt;br&gt;ローカル判断の 3 層&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="100" width="165" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="st4" value="&lt;b&gt;4. 協調&lt;/b&gt;&lt;br&gt;リポジトリの境界を越える&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;アンカーリポジトリで&lt;br&gt;ケイパビリティ全体を計画&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="100" width="165" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="st5" value="&lt;b&gt;5. ガバナンス&lt;/b&gt;&lt;br&gt;開発フローに組み込む&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PR・Actions・CODEOWNERS。&lt;br&gt;検証と承認を分ける&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="100" width="165" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="st6" value="&lt;b&gt;6. 計測&lt;/b&gt;&lt;br&gt;活動ではなく結果を測る&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Copilot の利用量 ≠&lt;br&gt;SDD の定着&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="165" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="st1" target="st2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="st2" target="st3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="st3" target="st4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="st4" target="st5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="st5" target="st6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="sig1" value="次へ進む合図：&lt;br&gt;作者に聞かなくても&lt;br&gt;変更の意図が分かる" style="text;html=1;fontSize=10;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="165" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sig2" value="次へ進む合図：&lt;br&gt;「Spec Kit 担当者」が&lt;br&gt;いなくても回る" style="text;html=1;fontSize=10;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="220" y="240" width="165" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sig3" value="次へ進む合図：&lt;br&gt;必須・調整可・責任者を&lt;br&gt;チームが区別できる" style="text;html=1;fontSize=10;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="430" y="240" width="165" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sig4" value="次へ進む合図：&lt;br&gt;分散した変更の寄与と&lt;br&gt;互換性の検証を説明できる" style="text;html=1;fontSize=10;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="610" y="240" width="165" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sig5" value="次へ進む合図：&lt;br&gt;不要な承認の連鎖なしに&lt;br&gt;不確実さと手戻りが減る" style="text;html=1;fontSize=10;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="820" y="240" width="165" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="sig6" value="次へ進む合図：&lt;br&gt;証拠を、強制ではなく&lt;br&gt;実践の調整に使っている" style="text;html=1;fontSize=10;align=center;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="1000" y="240" width="165" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="note" value="厳密な順序や認定モデルではなく、実務の目安（どこで詰まっているかを見つけるための地図）" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="345" width="800" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
