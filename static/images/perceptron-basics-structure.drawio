<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="perceptron-structure" name="Perceptron Structure">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="単純パーセプトロンの計算の流れ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="grp-in" value="入力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="150" height="320" as="geometry"/>
        </mxCell>

        <mxCell id="in-bias" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="85" y="110" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="in-bias-note" value="常に 1（バイアス用）" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="55" y="170" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="in-x1" value="x₁" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="85" y="200" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="in-x2" value="x₂" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="85" y="290" width="60" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="node-sum" value="重み付き和&lt;br&gt;&lt;b&gt;z = w₀ + w₁x₁ + w₂x₂&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="195" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node-step" value="ステップ関数&lt;br&gt;&lt;b&gt;z ≥ 0 なら 1&lt;br&gt;z &amp;lt; 0 なら 0&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="195" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="node-out" value="y" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="200" width="60" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="node-out-note" value="出力（0 または 1）" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="770" y="262" width="120" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="e-bias" value="w₀" style="endArrow=classic;html=1;strokeColor=#999999;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in-bias" target="node-sum">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-x1" value="w₁" style="endArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in-x1" target="node-sum">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-x2" value="w₂" style="endArrow=classic;html=1;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="in-x2" target="node-sum">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-sum-step" value="z" style="endArrow=classic;html=1;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="node-sum" target="node-step">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-step-out" value="" style="endArrow=classic;html=1;strokeColor=#333333;" edge="1" parent="1" source="node-step" target="node-out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="learn-box" value="学習: 出力 y と正解 t がずれたときだけ重みを更新する&lt;br&gt;&lt;b&gt;w ← w + η (t − y) x&lt;/b&gt;（η は学習率）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="320" width="390" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e-learn" value="" style="endArrow=classic;html=1;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="learn-box" target="node-sum">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
