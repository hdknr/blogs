<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="rai_d" name="Responsible AI">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="rai_title" value="責任ある AI の 6 つの原則と、確かめるための道具（レッスン 24）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="60" y="15" width="880" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="rai_grp" value="Microsoft の責任ある AI の原則" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="940" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="rai_p1" value="&lt;b&gt;公平性&lt;/b&gt;&lt;br&gt;偏ったデータで学習すると、&lt;br&gt;特定の集団に不利な予測になる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="100" width="290" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="rai_p2" value="&lt;b&gt;信頼性と安全性&lt;/b&gt;&lt;br&gt;モデルは間違える。確率と誤りの傾向を&lt;br&gt;理解したうえで判断に使う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="100" width="290" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="rai_p3" value="&lt;b&gt;プライバシーとセキュリティ&lt;/b&gt;&lt;br&gt;学習に使ったデータはモデルに記憶され、&lt;br&gt;取り出される危険がある" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="655" y="100" width="290" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="rai_p4" value="&lt;b&gt;インクルーシブ性（包括性）&lt;/b&gt;&lt;br&gt;背景や能力によらず、あらゆる人が&lt;br&gt;使えて恩恵を受けられるようにする" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="200" width="290" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="rai_p5" value="&lt;b&gt;透明性&lt;/b&gt;&lt;br&gt;AI を使っていることを明らかにし、&lt;br&gt;できるだけ解釈できるモデルを使う" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="355" y="200" width="290" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="rai_p6" value="&lt;b&gt;アカウンタビリティ（説明責任）&lt;/b&gt;&lt;br&gt;重要な判断には人間を関与させ、&lt;br&gt;責任の所在をはっきりさせる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="655" y="200" width="290" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="rai_tgrp" value="Responsible AI Toolbox の道具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="330" width="940" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="rai_t1" value="&lt;b&gt;Fairlearn&lt;/b&gt;&lt;br&gt;集団ごとの指標の差を測り、&lt;br&gt;差を小さくする&lt;br&gt;（公平性）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="215" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rai_t2" value="&lt;b&gt;Error Analysis&lt;/b&gt;&lt;br&gt;どんなデータで&lt;br&gt;間違えやすいかを調べる&lt;br&gt;（信頼性と安全性）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="370" width="215" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rai_t3" value="&lt;b&gt;InterpretML&lt;/b&gt;&lt;br&gt;どの特徴量が予測に&lt;br&gt;効いているかを説明する&lt;br&gt;（透明性）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="370" width="215" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="rai_t4" value="&lt;b&gt;EconML / DiCE&lt;/b&gt;&lt;br&gt;因果分析（もし〜なら）と、&lt;br&gt;判断を変えるには何を変えるか&lt;br&gt;（アカウンタビリティ・透明性）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="370" width="215" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="rai_foot" value="道具は原則を自動で守ってくれるものではなく、モデルの偏りや誤りの傾向を「見える化」するもの。どう判断するかは人間が決める（原則と道具の対応は筆者の整理）" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="495" width="940" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
