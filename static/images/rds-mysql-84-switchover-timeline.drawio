          <mxGeometry x="1000" y="360" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- DNS propagation callout -->
        <mxCell id="dns" value="12:07:33 に開始したリクエストは、リネーム完了後なのに旧インスタンスへ名前解決される → DNS 伝播の遅れ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;dashed=1;" vertex="1" parent="1">
