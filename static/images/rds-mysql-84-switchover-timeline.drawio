        <mxCell id="title" value="切替の瞬間（prod-main・秒単位）— RDS 内部の1秒とアプリから見た約24秒" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
