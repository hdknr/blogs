        </mxCell>
        <mxCell id="r5d" value="毎周期 Deleted → Created が出る（正常）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="298" width="440" height="40" as="geometry"/>
