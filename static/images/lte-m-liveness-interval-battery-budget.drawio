<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="lte-m-battery-budget" name="Battery Budget vs Detection Delay">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="「200 回程度の LTE 送信」という電池予算から逆算する" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="600" height="30" as="geometry"/>
