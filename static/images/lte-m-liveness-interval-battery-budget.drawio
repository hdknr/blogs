        <mxCell id="r6c" value="48 時間" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="338" width="220" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="r6d" value="毎周期 Deleted → Created が出る（正常）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="338" width="440" height="40" as="geometry"/>
