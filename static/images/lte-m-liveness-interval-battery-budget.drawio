          <mxGeometry x="60" y="338" width="180" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="r6b" value="約 200 日" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="338" width="200" height="40" as="geometry"/>
