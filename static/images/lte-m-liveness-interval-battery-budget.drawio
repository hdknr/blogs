        <mxCell id="subtitle" value="SmartFitPRO Basic（単 4 形乾電池 2 本 / LTE Cat.M1 / plan-D）の場合" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
