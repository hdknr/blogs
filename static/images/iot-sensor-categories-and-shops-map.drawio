        <mxCell id="c1" value="M5Stack&#xa;画面・筐体つき / 現場で見せる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="700" y="170" width="210" height="66" as="geometry"/>
