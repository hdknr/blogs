<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="iot-sensor-map" name="IoT Sensor Connection Map">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="IoT センサー接続の全体像 — 物理量 → 信号 → コンピュータ → クラウド" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== Layer 1: 物理量 ===== -->
        <mxCell id="l1box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#cccccc;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="270" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="l1label" value="① 測りたい物理量" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="230" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="温度 / 湿度（空調）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="126" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="CO2 / 粉塵（PM2.5）/ ガス" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="170" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="振動 / 加速度 / 傾き" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="214" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p4" value="圧力 / 差圧 / 水位" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="258" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p5" value="電流 / 電圧（電力）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="302" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="距離 / 在・不在（人感）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="346" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="画像（カメラ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="390" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p8" value="音声 / 騒音（マイク）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="434" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p9" value="接点 ON/OFF（開閉・稼働）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="478" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p10" value="既設の設備機器（空調盤・計測器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="522" width="220" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p11" value="産業用センサー（4-20mA 出力）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="65" y="566" width="220" height="34" as="geometry"/>
