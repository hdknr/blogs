          <mxGeometry x="380" y="90" width="230" height="26" as="geometry"/>
        </mxCell>

        <mxCell id="s1" value="デジタル通信&#xa;I2C / SPI / UART&#xa;（Grove・Unit で挿すだけ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="385" y="150" width="220" height="66" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="アナログ電圧&#xa;ADC で読む（0〜3.3V）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
