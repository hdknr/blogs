        <mxCell id="c4" value="※ 4-20mA・RS-485 は&#xa;変換モジュールを挟むのが定石" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;fontColor=#666666;dashed=1;" vertex="1" parent="1">
