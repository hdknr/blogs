        <mxCell id="c2" value="Arduino&#xa;アナログ・接点入力に強い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="1">
