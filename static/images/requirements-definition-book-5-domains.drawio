        <mxCell id="note" value="出典：『図と事例でやさしく学べる 要件定義 基本からAI対応まで』の目次をもとに筆者が整理" style="text;html=1;fontSize=11;align=right;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="460" y="570" width="600" height="25" as="geometry"/>
