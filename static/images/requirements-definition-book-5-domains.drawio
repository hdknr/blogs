        <!-- Chapter 8 -->
        <mxCell id="c8" value="&lt;b&gt;実行管理&lt;/b&gt;（第 8 章）　変更管理・成果物の整合性・根回し・レビュー観点・期待値管理・課題／QA 管理表・完了報告書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
