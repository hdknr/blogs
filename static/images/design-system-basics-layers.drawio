<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="design-system-layers" name="Design System Layers">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="デザインシステムの構成（下の層ほど土台）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Users of the system -->
        <mxCell id="designer" value="デザイナー&#xa;（Figma）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="90" y="60" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="engineer" value="エンジニア&#xa;（実装コード）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="shared-lang" value="同じ名前で会話する" style="text;html=1;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="255" y="90" width="140" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="arr-shared" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="designer" target="engineer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Product -->
        <mxCell id="product" value="プロダクト画面（Web・アプリ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="530" height="55" as="geometry"/>
        </mxCell>

        <!-- Components -->
        <mxCell id="components" value="UIコンポーネント&#xa;ボタン・入力フォーム・モーダル・ナビゲーション" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="530" height="65" as="geometry"/>
        </mxCell>

        <!-- Style guide -->
        <mxCell id="styleguide" value="スタイルガイド&#xa;タイポグラフィ・配色・アイコン・レイアウト" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="530" height="65" as="geometry"/>
        </mxCell>

        <!-- Tokens -->
        <mxCell id="tokens" value="デザイントークン&#xa;color-primary: #0066CC ／ spacing-md: 16px" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="405" width="530" height="65" as="geometry"/>
        </mxCell>

        <!-- Principles -->
        <mxCell id="principles" value="デザイン原則&#xa;「迷わせない」「誰にでも使える」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="490" width="530" height="65" as="geometry"/>
        </mxCell>

        <!-- Arrows: composed of -->
        <mxCell id="arr-c-p" style="endArrow=classic;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="components" target="product">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Documentation spanning all layers -->
        <mxCell id="docs" value="ドキュメント・&#xa;運用ルール&#xa;&#xa;使い方・NG例&#xa;更新・管理フロー&#xa;&#xa;（全層にまたがる）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="620" y="235" width="180" height="320" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
