<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="block-trade-tostnet" name="Block Trade Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="ブロック取引（ブロックトレード）の流れ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="390" y="20" width="400" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="立会市場を通さず、証券会社が在庫リスクを引き受けて ToSTNeT-1 で一括約定させる" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="340" y="48" width="500" height="20" as="geometry"/>
        </mxCell>

        <!-- Seller -->
        <mxCell id="seller-box" value="売り手" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="230" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="seller-1" value="事業会社（政策保有株の解消）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="135" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="seller-2" value="創業家・大株主" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="185" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="seller-3" value="機関投資家・PEファンド" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="235" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="seller-note" value="「まとめて、いま売り切りたい」" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="190" height="20" as="geometry"/>
        </mxCell>

        <!-- Broker -->
        <mxCell id="broker-box" value="証券会社（マーケット部門）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="280" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="broker-1" value="① 大量の株式を自己勘定で買い取る&#xa;（在庫として抱える＝価格変動リスク）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="140" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="broker-2" value="② 買い手を募集（機関投資家／個人）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="broker-3" value="③ ToSTNeT-1 で相手方を指定して一括約定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="broker-note" value="ディスカウントは、このリスクを引き受ける対価" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#3b6ea5;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="380" y="298" width="240" height="20" as="geometry"/>
        </mxCell>

        <!-- Buyer -->
        <mxCell id="buyer-box" value="買い手" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="730" y="100" width="230" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="buyer-1" value="国内外の機関投資家" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="135" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="buyer-2" value="個人投資家&#xa;（証券会社のサービス経由）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="750" y="185" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="buyer-3" value="発行会社自身&#xa;（自己株式取得なら ToSTNeT-3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="750" y="235" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="buyer-note" value="前営業日終値から数％割り引いた価格" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="750" y="285" width="190" height="20" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="arrow-1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;endArrow=block;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="seller-box" target="broker-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow-1-label" value="大量の売り注文" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="272" y="188" width="86" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="arrow-2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="broker-box" target="buyer-box">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow-2-label" value="割引価格で販売" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="644" y="188" width="84" height="20" as="geometry"/>
        </mxCell>

        <!-- Auction market (avoided) -->
        <mxCell id="auction" value="立会市場（ザラ場）&#xa;ここに大量注文を出すと、自分の売りで自分が損をする" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;fontColor=#993333;" vertex="1" parent="1">
          <mxGeometry x="360" y="395" width="280" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="avoid-arrow" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2;endArrow=none;startArrow=none;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="seller-box" target="auction">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="155" y="425"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="avoid-label" value="✕ マーケットインパクトを避けるため通さない" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="400" height="20" as="geometry"/>
        </mxCell>

        <!-- Timeline -->
        <mxCell id="tl-box" value="時間軸（個人向けブロックトレードの典型例）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1100" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="tl-line" style="endArrow=block;html=1;rounded=0;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="560" as="sourcePoint"/>
            <mxPoint x="1100" y="560" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <mxCell id="tl-1" value="前営業日 15:30&#xa;大引け" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="590" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="tl-1-note" value="この終値が基準価格" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="637" width="180" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="tl-1-dot" value="" style="ellipse;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="164" y="554" width="12" height="12" as="geometry"/>
        </mxCell>

        <mxCell id="tl-2" value="前営業日 17時ごろ&#xa;条件公表・申込受付開始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="tl-2-note" value="ディスカウント率が判明" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="637" width="180" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="tl-2-dot" value="" style="ellipse;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="404" y="554" width="12" height="12" as="geometry"/>
        </mxCell>

        <mxCell id="tl-3" value="当日 8:20&#xa;申込締切／ToSTNeT 取引開始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="590" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="tl-3-note" value="ToSTNeT-1 は 8:20〜18:00" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="637" width="180" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="tl-3-dot" value="" style="ellipse;html=1;fillColor=#82b366;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="644" y="554" width="12" height="12" as="geometry"/>
        </mxCell>

        <mxCell id="tl-4" value="当日 9:00&#xa;立会市場が寄り付く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="590" width="180" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="tl-4-note" value="需給悪化で下落することもある" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#993333;" vertex="1" parent="1">
          <mxGeometry x="820" y="637" width="180" height="18" as="geometry"/>
        </mxCell>
        <mxCell id="tl-4-dot" value="" style="ellipse;html=1;fillColor=#b85450;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="904" y="554" width="12" height="12" as="geometry"/>
        </mxCell>

        <mxCell id="tl-caption" value="約定した時点で買い手は含み益ではない。基準はあくまで前営業日の終値であり、当日の寄付き値ではない" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#993333;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="500" width="700" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
