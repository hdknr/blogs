        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="input" target="dlr-label"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="275"/><mxPoint x="250" y="110"/></Array></mxGeometry></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="input" target="flr-label"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="275"/><mxPoint x="250" y="275"/></Array></mxGeometry></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="input" target="ssr-label"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="275"/><mxPoint x="250" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="e4" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="dlr-label" target="dlr-out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="dlr-out" target="dlr-res"><mxGeometry relative="1" as="geometry"/></mxCell>
