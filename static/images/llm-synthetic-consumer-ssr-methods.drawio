<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="ssr-methods" name="DLR FLR SSR">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1160" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="合成消費者から購買意向（1〜5）を取り出す 3 つの方式" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="15" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- Input -->
        <mxCell id="input" value="&lt;b&gt;LLM（合成消費者）&lt;/b&gt;&lt;br&gt;実在回答者の属性&lt;br&gt;（年齢・性別・地域・収入）&lt;br&gt;＋ 製品コンセプト画像" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="190" height="110" as="geometry"/>
        </mxCell>

        <!-- Row labels / DLR -->
        <mxCell id="dlr-label" value="DLR&lt;br&gt;直接評定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="80" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dlr-out" value="整数を 1 つだけ答える&lt;br&gt;「3」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="460" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="dlr-res" value="「3」に偏る&lt;br&gt;KS 類似度 0.26〜0.39" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="80" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- FLR -->
        <mxCell id="flr-label" value="FLR&lt;br&gt;追従評定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="245" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="flr-text" value="自由記述で感想を書く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="245" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="flr-judge" value="別の LLM インスタンス&lt;br&gt;（評定の専門家役）が&lt;br&gt;整数 1 つに変換" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="240" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="flr-res" value="分布は改善&lt;br&gt;KS 類似度 0.59〜0.72" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="245" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- SSR -->
        <mxCell id="ssr-label" value="SSR&lt;br&gt;意味的類似度評定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="410" width="110" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ssr-text" value="自由記述で感想を書く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="410" width="190" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="ssr-embed" value="埋め込み → 1〜5 点の&lt;br&gt;参照文とコサイン類似度&lt;br&gt;→ 確率分布に正規化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="405" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ssr-res" value="人間に近い分布&lt;br&gt;KS 類似度 0.80〜0.88" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="410" width="180" height="60" as="geometry"/>
