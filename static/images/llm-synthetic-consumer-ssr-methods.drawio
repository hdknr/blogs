        <mxCell id="e7" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="flr-text" target="flr-judge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="flr-judge" target="flr-res"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="html=1;endArrow=block;strokeColor=#666666;" edge="1" parent="1" source="ssr-label" target="ssr-text"><mxGeometry relative="1" as="geometry"/></mxCell>
