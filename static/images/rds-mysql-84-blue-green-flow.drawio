<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="rds-bg-flow" name="RDS Blue/Green Deployment Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="RDS Blue/Green デプロイの4段階" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="350" y="20" width="400" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== Phase 1 ===== -->
        <mxCell id="p1box" value="【1】BG デプロイを作成（provisioning・ユーザー影響なし）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1020" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="p1users" value="ユーザー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p1blue" value="blue&#10;現行本番 MySQL 8.0&#10;（書き込み受付中）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="115" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1green" value="green&#10;複製・read-only レプリカ&#10;MySQL 8.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="115" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p1notraffic" value="トラフィックを&#10;受けない" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="870" y="130" width="110" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="p1e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p1users" target="p1blue">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p1e2" value="binlog レプリケーション" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;endArrow=block;fontSize=10;" edge="1" parent="1" source="p1blue" target="p1green">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== Phase 2 ===== -->
        <mxCell id="p2box" value="【2】green だけをアップグレード（blue は通常稼働のまま・ユーザー影響なし）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="245" width="1020" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="p2users" value="ユーザー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p2blue" value="blue&#10;MySQL 8.0&#10;（無変更）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="280" y="290" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2green" value="green&#10;MySQL 8.4 へ in-place&#10;アップグレード" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="290" width="200" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2note" value="クロスバージョンでも&#10;追随する" style="text;html=1;fontSize=10;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="870" y="305" width="110" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="p2e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p2users" target="p2blue">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2e2" value="8.0 → 8.4 でも継続" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;endArrow=block;fontSize=10;" edge="1" parent="1" source="p2blue" target="p2green">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== Phase 3 ===== -->
        <mxCell id="p3box" value="【3】switchover（エンドポイント名を入れ替え・書き込み停止 約1秒）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1020" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="p3blue" value="blue&#10;→ &quot;-old1&quot; に改名&#10;read-only 化して残る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="470" width="220" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="p3green" value="green&#10;→ 本番名に改名&#10;書き込み受付開始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="470" width="220" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="p3swap" value="エンドポイント名を&#10;入れ替え" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="462" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="p3e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p3blue" target="p3swap">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p3swap" target="p3green">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== Phase 4 ===== -->
        <mxCell id="p4box" value="【4】ユーザーは新本番へ。旧 blue は課金対象なので後で削除" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="595" width="1020" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="p4users" value="ユーザー" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="660" width="110" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="p4new" value="新本番（旧 green）&#10;MySQL 8.4.10" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="645" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p4old" value="...-old1（旧 blue）&#10;MySQL 8.0・read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="645" width="210" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p4del" value="スナップショット取得後に削除&#10;（残すと Extended Support 課金）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="870" y="645" width="165" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="p4e1" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#d79b00;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="p4users" target="p4new">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4e2" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;strokeColor=#b85450;strokeWidth=2;endArrow=block;dashed=1;" edge="1" parent="1" source="p4old" target="p4del">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p4tf" value="⚠ old1 を削除する前に Terraform state の張り替え（state rm + import）が必須 — DbiResourceId が変わるため" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontStyle=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="730" width="745" height="30" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
