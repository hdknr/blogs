<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram name="踏んだ罠 6 つ" id="page-mutation-traps">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ttl" value="踏んだ罠 6 つ — どれも出力は正常に出る" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="24" width="800" height="34" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="壊れた計測器は、壊れた顔をしていない。「測った」感覚だけが残り、測れていないことに気づけない。" style="text;html=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="56" width="1000" height="20" as="geometry" />
        </mxCell>

        <mxCell id="c1-l" value="&lt;b&gt;変異の作り方を間違える&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="100" width="340" height="24" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="&lt;b&gt;1. assert を消す&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;今通っている検査を消せば、必ず緑になる。それは変異ではない。&lt;br&gt;&lt;br&gt;→ 壊すのは&lt;b&gt;機構のほう&lt;/b&gt;&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B03A2E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="134" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="&lt;b&gt;3. 汚い変異&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;1 行だけ消して NameError。RED は出たが、ガードではなく関数を壊していた。&lt;br&gt;&lt;br&gt;→ 変異は&lt;b&gt;意味の単位&lt;/b&gt;で当てる&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#B03A2E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="30" y="264" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c2-l" value="&lt;b&gt;測定の再現性が崩れる&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="340" height="24" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="&lt;b&gt;2. 基準に動く参照を使う&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;&lt;font style=&quot;font-family: monospace&quot;&gt;origin/master&lt;/font&gt; が作業中にマージされ、「何も変えない変異」に化けた。&lt;br&gt;&lt;br&gt;→ &lt;b&gt;固定 SHA&lt;/b&gt; を指す&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D9822B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="134" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="&lt;b&gt;4. 失敗「件数」を表に書く&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;件数は変異の性質であって、テストスイートの性質ではない。2 人で当てたら食い違った。&lt;br&gt;&lt;br&gt;→ &lt;b&gt;どのテストが落ちたか&lt;/b&gt;を書く&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D9822B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="264" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="&lt;b&gt;6. 時計に依存する検査&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;秒解像度のタイムスタンプ。2 回の実行が秒境界をまたぐと見逃す。RED は運かもしれない。&lt;br&gt;&lt;br&gt;→ &lt;b&gt;時刻を固定&lt;/b&gt;するか、衝突を強制する&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#D9822B;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="394" width="340" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c3-l" value="&lt;b&gt;主張を実測より強く書く&lt;/b&gt;" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="770" y="100" width="340" height="24" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="&lt;b&gt;5.「網羅した」と先に書く&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;3 回続けて外した。1 回目は分岐を 1 つも当てていなかった。2 回目は 2 つ、3 回目も 6 つ残っていた。&lt;br&gt;&lt;br&gt;→ &lt;b&gt;分岐を列挙した表&lt;/b&gt;を作ってからでないと書けない&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFDF0;strokeColor=#D6C68A;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="770" y="134" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;共通する形&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;6 つとも、&lt;b&gt;出力は正常に出る&lt;/b&gt;。RED / GREEN の行はきちんと並び、スクリプトは最後まで走り、&lt;br&gt;「測った」という感覚だけが手元に残る。&lt;br&gt;&lt;br&gt;だから&lt;b&gt;結果を見ても気づけない&lt;/b&gt;。気づくには、変異を当てる前に「この変異が効いたら&lt;br&gt;どのテストが落ちるはずか」を先に書いておくしかない。&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FA;strokeColor=#C8D0D6;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="770" y="304" width="340" height="210" as="geometry" />
        </mxCell>

        <mxCell id="ftr" value="罠 1・3 は変異そのものの作り方、罠 2・4・6 は測定の再現性、罠 5 は結果の書き方。層が違うので、1 つ潰しても他は残る。" style="text;html=1;fontSize=11;fontColor=#B03A2E;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="30" y="534" width="1080" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
