<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="japan-bas-flow" name="Japan BAS Market Structure">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="ビル自動制御（BAS）の商流と、寡占を維持する 4 つの障壁" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="18" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Flow band -->
        <mxCell id="flow-group" value="新築案件の商流（上流 → 下流）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="1320" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="owner" value="発注者&#xa;デベロッパー・官公庁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="65" y="120" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="design" value="設計事務所&#xa;仕様書を書く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="255" y="120" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="gc" value="ゼネコン（元請）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="445" y="120" width="150" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="subcon" value="空調衛生サブコン&#xa;高砂熱学・新菱冷熱&#xa;三機工業 など" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="635" y="112" width="160" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="maker" value="計装メーカー&#xa;アズビル&#xa;ジョンソンコントロールズ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="835" y="112" width="170" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="keiso" value="計装工事会社&#xa;日本電技・東テク&#xa;など多数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1045" y="112" width="150" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="build" value="竣工・引渡し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1235" y="120" width="105" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="f1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="owner" target="design"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="design" target="gc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f3" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gc" target="subcon"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f4" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#6c8ebf;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="subcon" target="maker"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f5" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#d79b00;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="maker" target="keiso"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f6" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="keiso" target="build"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Lifecycle loop -->
        <mxCell id="loop-group" value="引渡し後 ― ここが本体の収益源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="640" y="280" width="720" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="maint" value="長期保守契約&#xa;点検・チューニング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1195" y="330" width="145" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="renew" value="10〜20 年で更新工事&#xa;中央監視は入れ替え&#xa;末端コントローラは残る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="960" y="322" width="180" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="back" value="同じベンダーが有利" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="330" width="170" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="l1" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="build" target="maint"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l2" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="maint" target="renew"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l3" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#82b366;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="renew" target="back"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="l4" value="案件が戻る" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=10;" edge="1" parent="1" source="back" target="maker"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Barriers -->
        <mxCell id="bar-group" value="新規参入を阻む 4 つの障壁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="1320" height="290" as="geometry"/>
        </mxCell>

        <mxCell id="b1" value="① 全国の施工・サービス拠点網&#xa;&#xa;BAS は据付調整と保守が本体。&#xa;拠点がなければ入札の土俵に&#xa;乗れない（JCI 日本は 45 拠点）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="530" width="290" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="② 日本独自の BACnet プロファイル&#xa;&#xa;電気設備学会 IEIEJ-P-0003 /&#xa;IEIEJ-G-0006 準拠が実質要件。&#xa;世界標準品をそのまま出せない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="390" y="530" width="290" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="③ 既設資産のロックイン&#xa;&#xa;末端コントローラは更新後も残る。&#xa;専用プロトコル区間があると&#xa;乗り換えコストが跳ね上がる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="710" y="530" width="290" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="④ 仕様書に書かれる実績要件&#xa;&#xa;設計段階で納入実績・体制が&#xa;条件になる。実績がないと&#xa;実績を作れないという循環" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1030" y="530" width="290" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="barnote" value="※ 市場規模は年間 2,000〜2,500 システム程度とされる小さな市場。上の 4 つを同時に越えられるプレイヤーが構造的に限られる。&#xa;※ アズビルの BA 事業はセグメント利益率 18.5%（2025 年度）で 3 事業中もっとも高く、伸びているのは既設建物向け・サービス分野。" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="682" width="1250" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
