        <mxCell id="e9" value="指摘" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;startArrow=classic;fontSize=10;" edge="1" parent="1" source="ireview" target="coderabbit">
          <mxGeometry relative="1" as="geometry"/>
