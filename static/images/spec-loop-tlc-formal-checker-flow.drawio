<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="spec-loop-tlc" name="spec-loop TLC flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="spec-review の中で TLC が使われる流れ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="290" y="10" width="600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="grpPlanner" value="spec-review（Planner）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="330" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;① 対象を選ぶ&lt;/b&gt;&lt;br&gt;状態を持つ業務フローを新しく足す／遷移を変えるときだけ TLC の対象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="100" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;② 検査器があるか確かめる&lt;/b&gt;&lt;br&gt;Java と tla2tools.jar。無ければ判定役を起動せず利用者に訊く" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="200" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;④ 指摘を振り分ける&lt;/b&gt;&lt;br&gt;仕様を直す／Q&amp;amp;A 表に起票／範囲の外として記録 など" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="420" width="280" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="grpFC" value="Formal Checker（書き込みツールなし・別ティア）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="420" y="60" width="380" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;③-1 性質の水準で形式化&lt;/b&gt;&lt;br&gt;ロックの方式や書き込み順は入れない&lt;br&gt;構成は最小（2〜3）から" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="100" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;③-2 TLC で検査&lt;/b&gt;&lt;br&gt;モデルは $TMPDIR に書いて走らせる。時間を区切り、超えたら判定できなかった" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="200" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;③-3 空振りを疑う&lt;/b&gt;&lt;br&gt;正常な状態に到達できるか・わざと壊した版で反例が出るか（陽性対照）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="300" width="320" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;③-4 報告&lt;/b&gt;&lt;br&gt;反例なし／反例あり／判定できなかった。反例ごとに頻度と影響、モデルの全文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="420" width="320" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="grpOut" value="その後" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="860" y="60" width="290" height="460" as="geometry"/>
        </mxCell>
        <mxCell id="o1" value="&lt;b&gt;仕様（性質とテスト）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="885" y="100" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="o2" value="&lt;b&gt;scaffold&lt;/b&gt;&lt;br&gt;Red テストと Issue を生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="885" y="200" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="o3" value="&lt;b&gt;dev-loop&lt;/b&gt;&lt;br&gt;Issue 1 件ずつ実装・検証" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="885" y="310" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="o4" value="&lt;b&gt;spec/formal/&lt;/b&gt;&lt;br&gt;（置き場所は決まっているが、保存する手順が無い）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="885" y="420" width="240" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="対象・理由・照合先を渡す" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2" target="f1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="f3" target="f4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="endArrow=classic;html=1;strokeColor=#666666;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="f4" target="p3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="直した仕様" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=10;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="o1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="195" y="560"/>
              <mxPoint x="830" y="560"/>
              <mxPoint x="830" y="125"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" style="endArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="o1" target="o2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e9" style="endArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="o2" target="o3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e10" value="" style="endArrow=classic;html=1;strokeColor=#b85450;dashed=1;fontSize=10;fontColor=#b85450;exitX=1;exitY=0.75;entryX=0;entryY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="f4" target="o4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="legend" value="オレンジ：LLM が判断するところ　緑：検査器（TLC）の出力で決まるところ　赤の破線：まだ無いつながり" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="760" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="e10label" value="モデル・トレースは届かない" style="text;html=1;fontSize=10;align=center;verticalAlign=top;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="885" y="492" width="240" height="20" as="geometry"/>
