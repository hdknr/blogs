        <mxCell id="pi" value="&lt;b&gt;Pi&lt;/b&gt;（実働・安価）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
