          <mxGeometry x="50" y="176" width="90" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="e1974" value="ジョン・プファール《Altered Landscapes》&#10;風景に紐やテープを仕掛け、視点を固定して撮る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
