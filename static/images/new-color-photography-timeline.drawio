        <mxCell id="e1981" value="★ 命名 — サリー・オークレア『The New Color Photography』&#10;Abbeville Press 刊／ICP（ニューヨーク）で同名の展覧会" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
