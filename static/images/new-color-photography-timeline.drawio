        <mxCell id="title" value="ニューカラー（New Color）年表 — カラー写真が「芸術」になるまで" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
