        </mxCell>
        <mxCell id="e1972" value="スティーブン・ショア《American Surfaces》撮影開始&#10;（LIGHT Gallery で発表、評価は冷淡）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
