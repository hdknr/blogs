<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="new-color-timeline" name="New Color Photography Timeline">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

