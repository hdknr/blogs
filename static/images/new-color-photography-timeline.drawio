        <mxCell id="e1976" value="★ 転換点 — MoMA「Photographs by William Eggleston」&#10;ジョン・シャーカフスキー企画（5/24–8/1）／酷評されつつ歴史を動かす" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
