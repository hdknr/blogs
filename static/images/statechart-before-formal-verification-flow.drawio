<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="statechart-flow" name="Statechart before formal verification">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="形式検証 Skill を作る前に状態遷移をモデルにする流れ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Phase 1: understand -->
        <mxCell id="g1" value="① 理解する（ここを足す）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="290" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="エージェントが機能を提案&lt;br&gt;（または既存コードを指定）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="115" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="状態遷移のモデルを書かせ&lt;br&gt;図はそこからレンダリング&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TLA+ や SCXML で&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="225" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="人がレンダリングした図を読んで判断&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;この遷移は正しい？ 抜けている状態は？&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="345" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a4" value="守るべき性質を 1 文で言語化&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;例：1 回の注文で請求は 1 回だけ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="465" width="230" height="70" as="geometry"/>
        </mxCell>

        <!-- Phase 2: verify -->
        <mxCell id="g2" value="② 検証する（pstack）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="290" height="520" as="geometry"/>
        </mxCell>
        <mxCell id="b1" value="/create-formal-verification-skill&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;性質 1 つを TLA+ などで検証&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="115" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b2" value="壊したコードで失敗することを確認&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;チェックを外す・順序を入れ替える&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="235" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b3" value="/statechart で結果を読む&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;違反状態までの最短経路を平易な言葉で&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="355" width="230" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b4" value="反例を実コードで再現&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;起きなければモデルを疑う&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="475" width="230" height="70" as="geometry"/>
        </mxCell>

        <!-- Output -->
        <mxCell id="c1" value="プロジェクト専用の&lt;br&gt;検証 Skill&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;変更のたびに 1 コマンドで再検査&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="270" width="230" height="90" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a4" target="b1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="345" y="500"/><mxPoint x="345" y="150"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="b4" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
