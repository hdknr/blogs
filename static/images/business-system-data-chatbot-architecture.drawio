<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="chatbot-arch" name="Data inquiry chatbot architectures">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="業務システムにデータ照会チャットボットを組み込む 2 つの構成" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- A: Text-to-SQL -->
        <mxCell id="a-group" value="A. Text-to-SQL（Auto Ontology など）— DB を直接問い合わせる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="1040" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="a-user" value="利用者&lt;br&gt;（事業所 X の担当者）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a-app" value="業務システム&lt;br&gt;チャット画面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="130" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a-ao" value="Text-to-SQL サービス&lt;br&gt;LLM が SQL を生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="a-db" value="業務 DB&lt;br&gt;（全事業所のデータ）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="a-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="a-user" target="a-app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e2" value="共通の API トークン" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;fontSize=10;" edge="1" parent="1" source="a-app" target="a-ao"><mxGeometry relative="1" as="geometry"><mxPoint y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a-e3" value="接続用 DB ユーザーで SQL 実行" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;endArrow=block;fontSize=10;fontColor=#b85450;" edge="1" parent="1" source="a-ao" target="a-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-skip" value="&lt;b&gt;通らないもの&lt;/b&gt;&lt;br&gt;・アプリの行単位の権限（事業所スコープ）&lt;br&gt;・アプリの計算ロジック（帳票・集計の正本）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="215" width="330" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a-risk" value="他事業所の数字が&lt;br&gt;見える・画面と&lt;br&gt;食い違うおそれ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="880" y="220" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- B: Tool calling -->
        <mxCell id="b-group" value="B. ツール呼び出し — LLM は既存の API を利用者の権限で呼ぶ（推奨）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;opacity=40;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="1040" height="270" as="geometry"/>
        </mxCell>
        <mxCell id="b-user" value="利用者&lt;br&gt;（事業所 X の担当者）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b-llm" value="LLM&lt;br&gt;質問を解釈し&lt;br&gt;呼ぶツールと引数を選ぶ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="410" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-tools" value="ツール層（照会専用）&lt;br&gt;get_project_cost など&lt;br&gt;ログイン中の利用者で実行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="410" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-app" value="既存の業務ロジック&lt;br&gt;権限チェック → 絞り込み&lt;br&gt;→ 正本の計算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="650" y="410" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-db" value="業務 DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="410" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="b-user" target="b-llm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="b-llm" target="b-tools"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="b-tools" target="b-app"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="b-app" target="b-db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-good" value="見える範囲も計算方法も、画面から見た場合と同じになる。LLM が決めるのは「どのツールをどの引数で呼ぶか」だけ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="520" width="600" height="50" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="lg1" value="LLM が判断する部分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="525" width="160" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="lg2" value="決定的なコード" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="553" width="160" height="22" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
