<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="gan" name="GAN training">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="GAN の学習は 2 段階を交互に繰り返す" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 1 -->
        <mxCell id="g1" value="① 識別器を学習する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="460" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="s1noise" value="乱数ベクトル&lt;br&gt;（100 次元）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="110" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s1gen" value="生成器&lt;br&gt;（更新しない）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="110" width="110" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s1real" value="本物の画像&lt;br&gt;（MNIST）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="190" y="200" width="110" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s1disc" value="&lt;b&gt;識別器&lt;/b&gt;&lt;br&gt;（ここを更新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="150" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s1e1" value="" style="endArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="s1noise" target="s1gen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s1e2" value="偽物" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="s1gen" target="s1disc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s1e3" value="本物" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="s1real" target="s1disc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s1note" value="正解ラベル：本物 = 1、偽物 = 0&lt;br&gt;本物と偽物を見分けられるように学習" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="55" y="290" width="410" height="70" as="geometry"/>
        </mxCell>

        <!-- Step 2 -->
        <mxCell id="g2" value="② 生成器を学習する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="510" y="60" width="460" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="s2noise" value="乱数ベクトル&lt;br&gt;（100 次元）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="150" width="110" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s2gen" value="&lt;b&gt;生成器&lt;/b&gt;&lt;br&gt;（ここを更新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="150" width="120" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s2disc" value="識別器&lt;br&gt;（凍結）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="830" y="150" width="110" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="s2e1" value="" style="endArrow=classic;html=1;strokeColor=#666666;" edge="1" parent="1" source="s2noise" target="s2gen"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2e2" value="偽物" style="endArrow=classic;html=1;strokeColor=#666666;fontSize=11;" edge="1" parent="1" source="s2gen" target="s2disc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s2note" value="偽物に「本物 = 1」のラベルを付けて学習&lt;br&gt;識別器をだませる画像を作れるように生成器を学習" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="535" y="290" width="410" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="損失は下がり続けるのではなく、2 つが押し合って振動するのが正常。Keras 3 では ② で識別器を凍結する書き方が変わった（本文参照）" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="405" width="940" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
