        <mxCell id="agents" value="&lt;b&gt;agents/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Red Team・Domain Checker・&lt;br&gt;Formal Checker・見積りの検証役&lt;br&gt;書き込みツールなし・別ティア&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
