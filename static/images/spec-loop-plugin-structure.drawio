        </mxCell>
        <mxCell id="speclabel" value="要求側プラグイン（例：spec-loop）" style="text;html=1;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;fontColor=#9c7a1c;" vertex="1" parent="1">
          <mxGeometry x="45" y="66" width="300" height="24" as="geometry"/>
