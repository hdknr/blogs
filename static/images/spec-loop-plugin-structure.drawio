<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="spec-loop-plugin" name="要求側プラグインと dev-loop の分担">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="要求側を 1 つのプラグインに、開発は dev-loop に" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="190" y="10" width="600" height="30" as="geometry"/>
