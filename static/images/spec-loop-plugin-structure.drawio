        </mxCell>
        <mxCell id="sk2" value="&lt;b&gt;spec-review&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Planner が書き、3 役がレビュー。抜ける条件を判定&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="160" width="280" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="sk3" value="&lt;b&gt;feasibility&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;見積り・スケジュール。予算責任者の合意で止まる&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="220" width="280" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="sk4" value="&lt;b&gt;proposal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;関門の確認と提案書の生成。決裁者の承認で止まる&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="280" width="280" height="46" as="geometry"/>
        </mxCell>
        <mxCell id="sk5" value="&lt;b&gt;scaffold&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;spec_ir.json → OpenAPI・型・Red テスト → Issue 化&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
