<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="ai-agent-design-layers" name="AI Agent Design Engineering Layers">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="AIエージェント設計の積み重なるレイヤー" style="text;html=1;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="290" y="20" width="600" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="上のレイヤーは下を置き換えるのではなく、下を内側に含んで設計範囲を広げる" style="text;html=1;fontSize=12;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="290" y="50" width="600" height="24" as="geometry"/>
        </mxCell>

        <!-- Scope axis -->
        <mxCell id="axis" value="" style="endArrow=blockThin;html=1;strokeColor=#999999;strokeWidth=2;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="620" as="sourcePoint"/>
            <mxPoint x="60" y="130" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="axis-label" value="設計範囲が広がる" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;horizontal=0;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="30" height="140" as="geometry"/>
        </mxCell>

        <!-- Layer 0: Model -->
        <mxCell id="model" value="モデル（頭脳）&#xa;Opus 5 / GPT / Gemini など" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;fontColor=#555555;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="580" width="300" height="50" as="geometry"/>
        </mxCell>

        <!-- Layer 1: Prompt -->
        <mxCell id="prompt" value="プロンプトエンジニアリング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="510" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="prompt-desc" value="AIへの「1回の指示」を設計する&#xa;例：目的・対象者・制約・出力形式・評価基準" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="510" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="prompt-office" value="社員に渡す1枚の依頼書" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;fontStyle=2;dashed=1;fontColor=#4472C4;" vertex="1" parent="1">
          <mxGeometry x="800" y="518" width="170" height="34" as="geometry"/>
        </mxCell>

        <!-- Layer 2: Context -->
        <mxCell id="context" value="コンテキストエンジニアリング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="440" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="context-desc" value="推論の瞬間に「何を知っている状態か」を設計する&#xa;選ぶ／並べる／圧縮する／分離する／更新する" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="440" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="context-office" value="机の上に置く資料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=10;fontStyle=2;dashed=1;fontColor=#5a8a3c;" vertex="1" parent="1">
          <mxGeometry x="800" y="448" width="170" height="34" as="geometry"/>
        </mxCell>

        <!-- Layer 3: Harness -->
        <mxCell id="harness" value="ハーネスエンジニアリング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="370" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="harness-desc" value="道具・ルール・権限・作業環境を設計する&#xa;ツール／MCP／サンドボックス／ログ／承認ポイント" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="370" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="harness-office" value="オフィス・備品・社内規程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=10;fontStyle=2;dashed=1;fontColor=#b8860b;" vertex="1" parent="1">
          <mxGeometry x="800" y="378" width="170" height="34" as="geometry"/>
        </mxCell>

        <!-- Layer 4: Loop -->
        <mxCell id="loop" value="ループエンジニアリング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="300" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="loop-desc" value="行動→観察→検証→修正の反復と「停止条件」を設計する&#xa;人間がループの制御装置をやめる" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="300" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="loop-office" value="作業・確認・修正の業務サイクル" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=10;fontStyle=2;dashed=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="800" y="308" width="170" height="34" as="geometry"/>
        </mxCell>

        <!-- Layer 5: Graph -->
        <mxCell id="graph" value="グラフエンジニアリング" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="230" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="graph-desc" value="複数工程・分岐・並列・承認経路を State / Node / Edge で設計する&#xa;ループは「単純な循環グラフ」＝対立しない" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="460" y="230" width="320" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="graph-office" value="部署・担当・承認経路（組織図）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;fontStyle=2;dashed=1;fontColor=#7c4daa;" vertex="1" parent="1">
          <mxGeometry x="800" y="238" width="170" height="34" as="geometry"/>
        </mxCell>

        <!-- Column headers -->
        <mxCell id="col1" value="レイヤー" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="100" y="196" width="340" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="col2" value="何を設計するのか" style="text;html=1;fontSize=11;fontStyle=1;align=left;verticalAlign=middle;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="460" y="196" width="320" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="col3" value="「新人社員」の比喩" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="800" y="196" width="170" height="24" as="geometry"/>
        </mxCell>

        <!-- Cross-cutting layers -->
        <mxCell id="cross-group" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 6;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="1000" y="190" width="160" height="440" as="geometry"/>
        </mxCell>
        <mxCell id="cross-label" value="横断レイヤー&#xa;（全段にかかる）" style="text;html=1;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#a6801a;" vertex="1" parent="1">
          <mxGeometry x="1005" y="198" width="150" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="cross-spec" value="スペック&#xa;（完成条件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1015" y="242" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cross-skill" value="スキル&#xa;（再利用手順）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1015" y="292" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cross-tool" value="ツール&#xa;（現実への手段）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1015" y="342" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cross-memory" value="メモリ／リトリーバル&#xa;（保存と取り出し）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1015" y="392" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cross-eval" value="Eval／観測&#xa;（測る・記録する）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1015" y="442" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cross-safety" value="セーフティ／権限&#xa;（最小権限・承認）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1015" y="492" width="130" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cross-intent" value="インテント&#xa;（衝突時の優先順位）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1015" y="542" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- Bottom note -->
        <mxCell id="note" value="成果 ＝ モデルの能力 × 仕様の明確さ × コンテキストの質 × ツールの使いやすさ × 検証ループの強さ × 安全設計" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;fontStyle=1;fontColor=#444444;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="655" width="1060" height="40" as="geometry"/>
        </mxCell>

        <!-- Vertical connectors between layers -->
        <mxCell id="c1" style="endArrow=blockThin;html=1;strokeColor=#aaaaaa;strokeWidth=1.5;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="model" target="prompt">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="c2" style="endArrow=blockThin;html=1;strokeColor=#aaaaaa;strokeWidth=1.5;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="prompt" target="context">
          <mxGeometry relative="1" as="geometry"/>
