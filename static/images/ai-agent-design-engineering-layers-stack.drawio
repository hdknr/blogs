        <mxCell id="c3" style="endArrow=blockThin;html=1;strokeColor=#aaaaaa;strokeWidth=1.5;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="context" target="harness">
          <mxGeometry relative="1" as="geometry"/>
