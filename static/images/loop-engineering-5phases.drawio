        <mxCell id="d6" value="失敗ならDISCOVERへ戻る" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="p5" target="p1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="410" /><mxPoint x="420" y="90" /></Array></mxGeometry></mxCell>
