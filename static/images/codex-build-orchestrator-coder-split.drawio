<mxfile host="app.diagrams.net" modified="2026-07-23T00:00:00.000Z" agent="Claude" version="24.0.0">
  <diagram name="Codex Build Orchestrator Coder Split" id="codex-build-orchestrator-coder-split">
    <mxGraphModel dx="1000" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="オーケストレーターとコーダーを分離し、承認ゲートで挟む開発フロー" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="660" height="40" as="geometry" />
        </mxCell>

        <!-- Orchestrator lane label -->
        <mxCell id="orchlabel" value="オーケストレーター役&lt;br&gt;（Claude Code など&lt;br&gt;／計画・レビュー・ゲート）" style="text;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="150" height="500" as="geometry" />
        </mxCell>

        <!-- Coder lane label -->
        <mxCell id="coderlabel" value="コーダー役&lt;br&gt;（OpenAI Codex CLI&lt;br&gt;／実装のみ）" style="text;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;rounded=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="330" width="150" height="150" as="geometry" />
        </mxCell>

        <!-- plan -->
        <mxCell id="plan" value="承認済みプラン&lt;br&gt;plan.md（人が事前レビュー）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="90" width="340" height="45" as="geometry" />
        </mxCell>

        <!-- preflight -->
        <mxCell id="preflight" value="① preflight&lt;br&gt;git 状態 / codex 認証 / 実行状態を確認・永続化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="160" width="340" height="50" as="geometry" />
        </mxCell>

        <!-- materialize -->
        <mxCell id="tasks" value="② タスク分解&lt;br&gt;プランを1タスク単位に展開し allowlist を用意" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="235" width="340" height="50" as="geometry" />
        </mxCell>

        <!-- loop box -->
        <mxCell id="loopbox" value="タスクごとのループ（1タスク = 1コミット）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#6c8ebf;dashed=1;fontSize=12;fontStyle=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="310" width="450" height="290" as="geometry" />
        </mxCell>

        <!-- brief codex -->
        <mxCell id="brief" value="③ Codex にブリーフを渡す&lt;br&gt;codex exec &quot;&lt;brief&gt;&quot; -s workspace-write &amp;lt; /dev/null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="335" width="340" height="45" as="geometry" />
        </mxCell>

        <!-- scope gate -->
        <mxCell id="scopegate" value="④ スコープゲート&lt;br&gt;check_scope.py が allowlist 外の変更を検出→範囲外なら停止" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="395" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- review diff -->
        <mxCell id="review" value="⑤ diff レビュー + テスト実行&lt;br&gt;オーケストレーターが変更内容を確認" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="480" width="340" height="45" as="geometry" />
        </mxCell>

        <!-- test gate -->
        <mxCell id="testgate" value="⑥ テストゲート（コミット前）&lt;br&gt;グリーンでなければコミットしない" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="535" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- commit -->
        <mxCell id="commit" value="⑦ コミット（AI 署名なし）→ インターフェイス台帳を更新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="625" width="340" height="45" as="geometry" />
        </mxCell>

        <!-- full suite -->
        <mxCell id="fullsuite" value="⑧ 全タスク完了 → フルスイート・ゲート（全テスト）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="705" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- push + PR -->
        <mxCell id="pr" value="⑨ push → PR を1本だけ作成（人がレビュー・マージ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="800" width="340" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="ep1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" source="plan" target="preflight" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" source="preflight" target="tasks" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep3" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" source="tasks" target="brief" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep4" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" source="brief" target="scopegate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep5" value="範囲内" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;fontColor=#82b366;fontStyle=1;" edge="1" source="scopegate" target="review" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep6" value="green" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;fontColor=#82b366;fontStyle=1;" edge="1" source="testgate" target="commit" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep5b" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" source="review" target="testgate" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep7" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;" edge="1" source="commit" target="fullsuite" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ep8" value="all green" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;fontColor=#82b366;fontStyle=1;" edge="1" source="fullsuite" target="pr" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- loop back: commit -> brief (next task) -->
        <mxCell id="eloop" value="次のタスクへ" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;dashed=1;rounded=1;strokeColor=#6c8ebf;fontColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="commit" target="brief" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="650" y="647" />
              <mxPoint x="650" y="357" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- fail edges -->
        <mxCell id="efail1" value="範囲外→停止" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;dashed=1;" edge="1" source="scopegate" target="stop" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="stop" value="人にエスカレーション&lt;br&gt;（3回失敗で run 停止）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="efail2" value="red→再試行/停止" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;strokeColor=#b85450;fontColor=#b85450;fontStyle=1;dashed=1;" edge="1" source="testgate" target="stop" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

