        <mxCell id="s3rep" value="S3&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;帳票 PDF (署名付き URL)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
