<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="distributed-spa-architecture" name="Distributed SPA Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="分散サービス × SPA の目標アーキテクチャ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="340" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Browser -->
        <mxCell id="spa" value="&lt;b&gt;ブラウザ&lt;/b&gt;&lt;br&gt;React SPA&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TanStack Query / Idempotency-Key 生成&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="30" y="300" width="170" height="80" as="geometry"/>
        </mxCell>

        <!-- CloudFront -->
        <mxCell id="cf" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;単一オリジン&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;/ → S3 (SPA)&lt;br&gt;/api/* → BFF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="295" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s3spa" value="S3&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SPA 静的ファイル&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="265" y="440" width="120" height="45" as="geometry"/>
        </mxCell>

        <!-- BFF -->
        <mxCell id="bff" value="&lt;b&gt;BFF&lt;/b&gt; (ECS)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cookie セッション → トークン&lt;br&gt;読み取りの集約&lt;br&gt;コマンド受付 (202 + 操作 ID)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="450" y="290" width="180" height="100" as="geometry"/>
        </mxCell>

        <!-- Orchestration group -->
        <mxCell id="orch-group" value="業務をまたぐ書き込み" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="680" y="70" width="200" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="sfn" value="&lt;b&gt;Step Functions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Saga オーケストレーター&lt;br&gt;リトライ・補償・タイムアウト&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="110" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="opdb" value="操作・ジョブ状態&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;DynamoDB 等&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="195" width="120" height="60" as="geometry"/>
        </mxCell>

        <!-- Business APIs group -->
