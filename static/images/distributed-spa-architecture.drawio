          <mxGeometry x="930" y="70" width="220" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="apiA" value="受注 API (ECS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
