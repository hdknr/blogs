        <!-- Notification -->
        <mxCell id="notify" value="&lt;b&gt;状態の通知&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ポーリング (まずはこれ)&lt;br&gt;→ SSE / AppSync Events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="470" width="170" height="70" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="同一オリジン&lt;br&gt;(CORS 不要)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#666666;fontSize=10;" edge="1" parent="1" source="spa" target="cf">
