<mxfile host="app.diagrams.net">
  <diagram name="サーキットブレーカーの状態遷移">
    <mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="レートリミット用サーキットブレーカーの状態遷移" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="20" width="600" height="36" as="geometry" />
        </mxCell>
        <mxCell id="closed" value="CLOSED&#10;通常どおり通す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="open" value="OPEN&#10;全部拒否して degrade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="100" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="half" value="HALF_OPEN&#10;同時に 1 本だけ通す" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="320" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e_closed_open" value="120 秒窓で 3 回ヒット" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeColor=#b85450;fontSize=12;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" source="closed" target="open" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_open_half" value="60 秒の冷却後、最初の 1 本" style="endArrow=classic;html=1;rounded=0;exitX=0.25;exitY=1;entryX=0.9;entryY=0;strokeColor=#d6b656;fontSize=12;fontColor=#996600;fontStyle=1;labelBackgroundColor=#ffffff;verticalAlign=bottom;" edge="1" source="open" target="half" parent="1">
          <mxGeometry x="-0.45" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_half_open" value="失敗 → 冷却を倍化（上限 600 秒）" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;entryX=0.85;entryY=1;strokeColor=#b85450;fontSize=12;fontColor=#b85450;fontStyle=1;labelBackgroundColor=#ffffff;verticalAlign=top;" edge="1" source="half" target="open" parent="1">
          <mxGeometry x="-0.45" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_half_closed" value="成功" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;entryX=0.5;entryY=1;strokeColor=#82b366;fontSize=12;fontColor=#3d7a2a;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" source="half" target="closed" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="note" value="半開の試行枠は必ず解放する。締め忘れると、レートリミットが解消しても永久に全拒否のまま止まり続ける。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="640" height="46" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
