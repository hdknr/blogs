<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="kabu-two-lanes" name="kabu API two lanes">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="maintitle" value="同じ「三菱UFJ eスマート証券のAPI」でも接続形態は別物" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="20" width="640" height="30" as="geometry"/>
        </mxCell>

        <!-- Left lane: corporate API -->
        <mxCell id="lane-corp" value="法人向け「三菱UFJ eスマート証券のAPI」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="470" height="530" as="geometry"/>
        </mxCell>

        <mxCell id="corp-app" value="事業者のサーバ&#xa;（取引ツール／ロボアド／助言業）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="120" width="290" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="corp-net" value="インターネット（OAuth 2.0 で認可）&#xa;専用線・広域イーサネット接続も選択可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="130" y="240" width="290" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="corp-core" value="証券基幹システム&#xa;発注基盤 RAIDEN®" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="130" y="355" width="290" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="corp-note" value="・法人口座＋書面審査＋来社面談が必須&#xa;・個人口座では契約できない&#xa;・発注／訂正／取消に対応&#xa;・PUSH は 時価／注文状態／建玉状態&#xa;・株式・先物OP に加え 投信・FX・プチ株®" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="450" width="390" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="corp-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="corp-app" target="corp-net">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="corp-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="corp-net" target="corp-core">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Right lane: kabu station API -->
        <mxCell id="lane-ks" value="個人向け「kabuステーション®API」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="590" y="70" width="470" height="530" as="geometry"/>
        </mxCell>

        <mxCell id="ks-pc" value="1 台の Windows PC（同一 IP の内側）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="620" y="105" width="410" height="235" as="geometry"/>
        </mxCell>

        <mxCell id="ks-app" value="自作プログラム（Python 等）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="140" width="330" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="ks-port" value="http://localhost:18080/kabusapi（本番）&#xa;ws://localhost:18080/kabusapi/websocket&#xa;18081 は検証環境" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="660" y="205" width="330" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="ks-station" value="kabuステーション®（GUI アプリ）&#xa;常時起動＋ログイン状態が前提" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="280" width="330" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="ks-core" value="証券基幹システム&#xa;発注基盤 RAIDEN®" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="365" width="290" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="ks-note" value="・個人口座＋電子契約のみ（書面・捺印なし）&#xa;・Professional／Premium プランが条件&#xa;・発注／取消のみ（訂正 API は存在しない）&#xa;・PUSH は 時価のみ（約定通知は来ない）&#xa;・株式・先物・オプション（投信／FX 発注は不可）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=11;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="630" y="450" width="390" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ks-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="ks-app" target="ks-port">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ks-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" parent="1" source="ks-port" target="ks-station">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ks-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="ks-station" target="ks-core">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="ip-warn" value="別 PC・コンテナからは叩けない&#xa;（同一 IP のリクエストのみ受付）" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="620" y="612" width="410" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="corp-target" value="対象：ツールを作って第三者に提供する事業者" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="80" y="612" width="390" height="20" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
