<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="capacitor-live-updates-aws" name="Capacitor Live Updates on AWS">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="n_title" value="Capacitor の Live Updates を自前の AWS で配信する構成" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="30" y="15" width="700" height="30" as="geometry"/>
        </mxCell>

        <!-- GitHub Actions -->
        <mxCell id="g_ci" value="GitHub Actions（手動で起動）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="30" y="70" width="300" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="ci_build" value="① npm ci ／ npm run build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="115" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ci_zip" value="② dist を zip に固める&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;index.html を直下に、隠しファイルは除外&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="185" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ci_sum" value="③ sha256sum でチェックサムを計算" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="255" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ci_oidc" value="④ OIDC で IAM ロールを引き受け&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;アクセスキーは置かない&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="325" width="260" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="ci_upload" value="⑤ zip をアップロードし、&lt;br&gt;manifest.json の該当の版を書き換え" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="395" width="260" height="55" as="geometry"/>
        </mxCell>

        <!-- AWS -->
        <mxCell id="g_aws" value="AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#d79b00;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="330" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="aws_iam" value="&lt;b&gt;IAM ロール&lt;/b&gt;&lt;br&gt;信頼: このリポジトリの main だけ&lt;br&gt;権限: bundles/* と manifest.json だけ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="105" width="270" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="aws_s3" value="S3 バケット（非公開・バージョニング有効）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=4;arcSize=5;" vertex="1" parent="1">
          <mxGeometry x="410" y="195" width="270" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="s3_zip" value="&lt;b&gt;bundles/1.4.0-web.13.zip&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;版ごとに別名。1 年キャッシュ・immutable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="235" width="230" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3_manifest" value="&lt;b&gt;manifest.json&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;ストア版 → 配る版・URL・チェックサム&lt;br&gt;max-age=60&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="430" y="315" width="230" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="aws_cf" value="&lt;b&gt;CloudFront&lt;/b&gt;&lt;br&gt;HTTPS で配信&lt;br&gt;S3 へは OAC 経由でだけ読む" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="440" width="270" height="70" as="geometry"/>
        </mxCell>

        <!-- App -->
        <mxCell id="g_app" value="アプリ（@capgo/capacitor-updater の手動モード）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=6;dashed=1;dashPattern=5 5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="310" height="470" as="geometry"/>
        </mxCell>
        <mxCell id="app_ready" value="① 起動直後に notifyAppReady()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="115" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="app_fetch" value="② 前面に来たら manifest.json を取得" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="185" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="app_pick" value="③ 自分のストア版（App.getInfo）に&lt;br&gt;対応するバンドルを選び、今のものと比べる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="255" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="app_dl" value="④ download({ url, version, checksum })&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;チェックサムが合わなければ捨てる&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="325" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="app_next" value="⑤ next() で、次にバックグラウンドへ&lt;br&gt;回ったときに切り替え" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="395" width="270" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="app_rollback" value="新しい版で notifyAppReady() が&lt;br&gt;期限内に呼ばれなければ、前の版へ自動で戻る" style="text;html=1;whiteSpace=wrap;fontSize=10;align=center;verticalAlign=middle;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="780" y="465" width="270" height="45" as="geometry"/>
        </mxCell>

        <!-- In-column flow arrows -->
        <mxCell id="e_ci1" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="ci_build" target="ci_zip"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ci2" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="ci_zip" target="ci_sum"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ci3" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="ci_sum" target="ci_oidc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ci4" style="html=1;endArrow=block;endFill=1;strokeColor=#82b366;" edge="1" parent="1" source="ci_oidc" target="ci_upload"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_app1" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="app_ready" target="app_fetch"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_app2" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="app_fetch" target="app_pick"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_app3" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="app_pick" target="app_dl"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_app4" style="html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;" edge="1" parent="1" source="app_dl" target="app_next"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_s3cf" style="html=1;endArrow=block;endFill=1;strokeColor=#d79b00;" edge="1" parent="1" source="aws_s3" target="aws_cf"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- Cross-column arrows -->
        <mxCell id="e_assume" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#fff8ee;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci_oidc" target="aws_iam">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="345" y="352"/><mxPoint x="345" y="137"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_put" value="PutObject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ci_upload" target="aws_s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e_get_manifest" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws_cf" target="app_fetch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="725" y="461"/><mxPoint x="725" y="212"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_get_zip" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aws_cf" target="app_dl">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="745" y="489"/><mxPoint x="745" y="352"/></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
