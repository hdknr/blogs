<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="review-flow" name="Risk-based Review Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="n-title" value="全件必須レビューから、リスクに応じたレビューへ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="n-pr" value="&lt;b&gt;PR を作成&lt;/b&gt;&lt;br&gt;小さく分ける" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="70" width="200" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="n-gates" value="&lt;b&gt;自動ゲート（全 PR 共通）&lt;/b&gt;&lt;br&gt;テスト / 型チェック / linter / アーキテクチャテスト&lt;br&gt;静的解析・依存関係スキャン・シークレット検出&lt;br&gt;ミューテーションテスト（テスト自体の検証）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="150" width="400" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="n-route" value="変更したパスで振り分け&lt;br&gt;（CODEOWNERS ＋ 必須ステータスチェック）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="260" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="n-high" value="&lt;b&gt;高リスク：人のレビュー必須&lt;/b&gt;&lt;br&gt;認証・認可 / 課金 / 個人情報&lt;br&gt;DB マイグレーション / インフラ設定&lt;br&gt;公開 API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n-low" value="&lt;b&gt;低リスク：自動ゲート通過でマージ可&lt;/b&gt;&lt;br&gt;テスト付きの小さな変更&lt;br&gt;内部リファクタリング / ドキュメント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="390" width="300" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="n-deploy" value="&lt;b&gt;本番側の安全網&lt;/b&gt;&lt;br&gt;フィーチャーフラグ / カナリアリリース / 監視 / ロールバック" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="520" width="400" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="n-share" value="&lt;b&gt;別枠：知識共有&lt;/b&gt;&lt;br&gt;ペアプロ・モブプロ&lt;br&gt;マージ後に読み合う会&lt;br&gt;変更要約の共有" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="760" y="150" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e-pr-gates" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="n-pr" target="n-gates">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-gates-route" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="n-gates" target="n-route">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-route-high" value="高リスク" style="endArrow=classic;html=1;strokeColor=#b85450;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;fontSize=11;" edge="1" parent="1" source="n-route" target="n-high">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-route-low" value="低リスク" style="endArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;fontSize=11;" edge="1" parent="1" source="n-route" target="n-low">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-high-deploy" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n-high" target="n-deploy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-low-deploy" style="endArrow=classic;html=1;strokeColor=#666666;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="n-low" target="n-deploy">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
