<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="claude-platform-on-aws-start-tier-gate" name="Claude on AWS: two paths, two escalation desks">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="AWS 経由で Claude を使う 2 つの経路と「上限を上げる窓口」の違い" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="18" width="800" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== Left lane: Amazon Bedrock ===== -->
        <mxCell id="bedrock-group" value="Amazon Bedrock — AWS がインフラと上限を運用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="480" height="580" as="geometry"/>
        </mxCell>

        <mxCell id="b1" value="AWS アカウント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="140" y="100" width="280" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="b2" value="Model access（AWS コンソール）&#10;Anthropic の初回利用フォームを送信" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="170" width="380" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="b3" value="主要 Claude モデルは全 Bedrock 顧客に開放&#10;Fable 5 / Opus 4.8 / Opus 4.7 / Sonnet 5 / Haiku 4.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="380" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="b4" value="上限 = AWS Service Quotas&#10;既定 200 万 input TPM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="330" width="380" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="b5" value="400 万 input TPM までは&#10;Anthropic の追加承認なしで引き上げ可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="410" width="380" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="b6" value="エスカレーション窓口&#10;AWS Support（RPM 調整もこちら）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="500" width="380" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="b-note" value="※ データは AWS のセキュリティ境界内で処理される" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="90" y="580" width="380" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== Right lane: Claude Platform on AWS ===== -->
        <mxCell id="cpaws-group" value="Claude Platform on AWS — Anthropic が運用、AWS は認証と課金" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="580" y="60" width="480" height="580" as="geometry"/>
        </mxCell>

        <mxCell id="c1" value="AWS アカウント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="280" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="c2" value="AWS コンソールで Sign up&#10;AWS Marketplace のサブスクは AWS が自動処理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="170" width="380" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="c3" value="platform.claude.com/partner-signup&#10;組織情報（用途を含む）を入力 → Anthropic 組織が作成される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="250" width="380" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="c4" value="上限 = Anthropic が直接管理&#10;AWS Service Quotas の対象外" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="330" width="380" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="c5" value="Start tier に固定・自動昇格なし&#10;Console の「Request rate limit increase」は利用不可" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="410" width="380" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="c6" value="エスカレーション窓口&#10;Anthropic の account representative または support" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="500" width="380" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="c-note" value="※ 推論データは AWS のセキュリティ境界外で Anthropic が処理する" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="630" y="580" width="380" height="30" as="geometry"/>
        </mxCell>

        <!-- ===== Arrows: left lane ===== -->
        <mxCell id="ba1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ba2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ba3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ba4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ba5" value="さらに上げたい" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;fontSize=10;fontColor=#666666;" edge="1" parent="1" source="b5" target="b6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== Arrows: right lane ===== -->
        <mxCell id="ca1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ca2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ca3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ca4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ca5" value="上げる手段はここだけ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#b85450;fontStyle=1;" edge="1" parent="1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== Conclusion banner ===== -->
        <mxCell id="conclusion" value="「新規アカウントだから止められている」のではなく、AWS Marketplace 課金の組織は Start tier 固定というのが設計。&#10;セルフサービスの引き上げ導線が存在しないため、結果として担当者経由になる。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="1020" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
