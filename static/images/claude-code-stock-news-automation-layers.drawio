<mxfile host="app.diagrams.net">
  <diagram name="ニュース分析の3層データソース構成">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Claude Code から叩くニュース分析の 3 層構成" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="160" y="20" width="500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="hdr_src" value="データソース" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="66" width="240" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hdr_tool" value="Claude Code 側の入口" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="66" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hdr_auto" value="自動化の可否" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="66" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="第 1 層　一次ソース（事実）&#10;EDINET API v2 / J-Quants API&#10;TDnet 公開ページ / 企業 IR の PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l1t" value="自作 MCP サーバ&#10;（REST を叩く）&#10;＋ aegis_fetch（PDF）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="100" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l1a" value="◎ 完全に自動化できる&#10;API キーは無料〜有料&#10;（J-Quants 無料は 12 週遅延）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="100" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="第 2 層　コンセンサス（予想）&#10;アナリスト予想 / 四季報予想&#10;会社の期初計画" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l2t" value="会社予想は MCP 経由&#10;アナリスト予想は&#10;手入力の YAML / CSV" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="230" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l2a" value="△ ここがボトルネック&#10;機械可読な無料ソースが&#10;実質なく、手入力が現実解" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="第 3 層　センチメント（反応）&#10;報道 RSS / Google News RSS&#10;X（ポスト） / PTS の値動き" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l3t" value="RSS は素の fetch&#10;X は従量課金 API&#10;PTS は目視" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="360" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="l3a" value="○ 網羅は RSS で可能&#10;ただし規約とコストの壁&#10;PTS は自動化を諦める" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="360" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="第 1 層と第 3 層の差分＝「事実と反応の歪み」がシグナル" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="500" width="380" height="50" as="geometry" />
        </mxCell>
        <mxCell id="arr1" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;exitX=0;exitY=0.5;edgeStyle=orthogonalEdgeStyle;" edge="1" source="l1" target="gap" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="155" />
              <mxPoint x="30" y="525" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="arr3" style="endArrow=classic;html=1;rounded=0;strokeColor=#82b366;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="l3" target="gap" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
