<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="ducklake-vs-iceberg" name="DuckLake vs Iceberg metadata">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="メタデータの置き場所：Iceberg と DuckLake" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Iceberg side -->
        <mxCell id="ice-group" value="Apache Iceberg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="450" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="ice-engine" value="計算エンジン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="100" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ice-cat" value="&lt;b&gt;カタログ&lt;/b&gt;（DB を持つサービス）&lt;br&gt;最新メタデータの位置だけを管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="105" y="170" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="ice-s3" value="オブジェクトストレージ（S3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="55" y="250" width="400" height="350" as="geometry"/>
        </mxCell>
        <mxCell id="ice-meta" value="metadata.json" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="285" width="150" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="ice-mlist" value="マニフェストリスト" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="165" y="350" width="180" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="ice-mf" value="マニフェスト（Avro）" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="165" y="415" width="180" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="ice-data" value="Parquet データファイル" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="ice-del" value="削除ファイル" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="480" width="170" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="ice-note" value="メタデータをたどるたびに S3 へ順番にリクエスト" style="text;html=1;fontSize=11;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="350" height="40" as="geometry"/>
        </mxCell>

        <!-- DuckLake side -->
        <mxCell id="dl-group" value="DuckLake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="450" height="560" as="geometry"/>
        </mxCell>
        <mxCell id="dl-engine" value="DuckDB（ducklake 拡張）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="650" y="100" width="190" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="dl-cat" value="&lt;b&gt;カタログ DB&lt;/b&gt;（PostgreSQL / SQLite / DuckDB）&lt;br&gt;スキーマ・スナップショット・ファイル一覧・統計&lt;br&gt;小さな変更（data inlining）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="170" width="370" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="dl-s3" value="オブジェクトストレージ（S3）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=5;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="545" y="420" width="400" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="dl-data" value="Parquet データファイル" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="655" y="460" width="180" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="dl-del" value="削除ファイル" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="655" y="515" width="180" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="dl-note" value="メタデータは SQL で取得。&lt;br&gt;ファイルの位置を引いて、&lt;br&gt;DuckDB が Parquet を&lt;br&gt;直接読む" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="770" y="280" width="170" height="90" as="geometry"/>
        </mxCell>

        <!-- Edges Iceberg -->
        <mxCell id="ei1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ice-engine" target="ice-cat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ei2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ice-cat" target="ice-meta">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ei3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ice-meta" target="ice-mlist">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ei4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ice-mlist" target="ice-mf">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ei5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ice-mf" target="ice-data">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ei6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#b85450;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ice-mf" target="ice-del">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edges DuckLake -->
        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dl-engine" target="dl-cat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dl-cat" target="dl-data">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
