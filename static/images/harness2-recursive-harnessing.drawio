<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="harness2-recursion" name="Harness2 Recursion">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="h2-title" value="Harness² の 2 段階の再帰（モデルの重みは固定）" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Task-level group -->
        <mxCell id="h2-task-group" value="タスクレベルの再帰：Propose–Probe–Compose（今のタスクのハーネスを磨く）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="940" height="230" as="geometry"/>
        </mxCell>

        <mxCell id="h2-initial" value="初期ハーネス&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;システムプロンプト・ツール・&lt;br&gt;メモリ・スキル・サブエージェント…&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h2-propose" value="&lt;b&gt;Propose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ハーネスエディタが&lt;br&gt;汎用／ドメイン固有の編集案を出す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="270" y="120" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h2-probe" value="&lt;b&gt;Probe&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;候補ハーネスで&lt;br&gt;同じタスクを実際に実行&lt;br&gt;（OpenCode / Codex）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="510" y="120" width="190" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="h2-compose" value="&lt;b&gt;Compose&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;実行の挙動の差から&lt;br&gt;改良版ハーネスを合成&lt;br&gt;（正解ラベル不要）&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="120" width="190" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="h2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="h2-initial" target="h2-propose">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="h2-propose" target="h2-probe">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h2-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#666666;endArrow=block;" edge="1" parent="1" source="h2-probe" target="h2-compose">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h2-e-loop" value="--k K：parallel（幅）／sequential（深さ）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c8ebf;endArrow=block;dashed=1;fontSize=11;fontColor=#336699;" edge="1" parent="1" source="h2-compose" target="h2-propose">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="845" y="250"/>
              <mxPoint x="365" y="250"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Harnessing-level group -->
        <mxCell id="h2-meta-group" value="ハーネシングレベルの再帰（タスクをまたいで「磨き方」を磨く）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8f0;strokeColor=#d79b00;fontStyle=1;fontSize=13;verticalAlign=bottom;spacingBottom=10;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="940" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="h2-reflector" value="&lt;b&gt;経験リフレクター&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;今回のステップを振り返り、&lt;br&gt;証拠に裏付けられた教訓を抽出&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="680" y="380" width="260" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="h2-improve" value="&lt;b&gt;改善ハーネス（永続）&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;採用されたハーネス＋教訓を蓄積。&lt;br&gt;次のタスクの編集案づくりを導く&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="380" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="h2-e4" value="採用ハーネスと実行の証拠" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;fontSize=11;" edge="1" parent="1" source="h2-compose" target="h2-reflector">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="900" y="300"/>
              <mxPoint x="900" y="300"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="h2-e5" value="更新" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;fontSize=11;" edge="1" parent="1" source="h2-reflector" target="h2-improve">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="h2-e6" value="次のタスクで参照" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;endArrow=block;fontSize=11;" edge="1" parent="1" source="h2-improve" target="h2-propose">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="330" y="300"/>
              <mxPoint x="330" y="300"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
