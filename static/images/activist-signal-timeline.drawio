<mxfile host="app.diagrams.net">
  <diagram name="アクティビストの買い集めと開示の時間軸">
    <mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="買い集めから義務開示までの時間軸 — どこで何を検知できるか" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="14" width="600" height="32" as="geometry" />
        </mxCell>
        <mxCell id="zone1" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=none;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="50" y="70" width="470" height="230" as="geometry" />
        </mxCell>
        <mxCell id="zone2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=none;opacity=60;" vertex="1" parent="1">
          <mxGeometry x="520" y="70" width="390" height="230" as="geometry" />
        </mxCell>
        <mxCell id="zone1l" value="制度開示に存在しない領域&#10;（報告義務が発生していない）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#996600;" vertex="1" parent="1">
          <mxGeometry x="130" y="76" width="310" height="36" as="geometry" />
        </mxCell>
        <mxCell id="zone2l" value="制度開示の領域&#10;（EDINET で 100% 取れる）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#3b5f9e;" vertex="1" parent="1">
          <mxGeometry x="570" y="76" width="290" height="36" as="geometry" />
        </mxCell>
        <mxCell id="axis" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#333333;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" y="200" as="sourcePoint" />
            <mxPoint x="910" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e1" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="96" y="192" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d79b00;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="316" y="192" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="556" y="192" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="796" y="192" width="16" height="16" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="買い集め開始&#10;（保有 1〜4%）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="34" y="140" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="日経の観測記事&#10;「関係者によると」" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#996600;" vertex="1" parent="1">
          <mxGeometry x="254" y="140" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="5% 到達&#10;（報告義務の発生）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="494" y="140" width="140" height="44" as="geometry" />
        </mxCell>
        <mxCell id="l4" value="EDINET に大量保有報告書&#10;（350／360）" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontStyle=1;fontColor=#3b5f9e;" vertex="1" parent="1">
          <mxGeometry x="734" y="140" width="160" height="44" as="geometry" />
        </mxCell>
        <mxCell id="lag" value="翌日起算 5 営業日以内" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#3b5f9e;" vertex="1" parent="1">
          <mxGeometry x="604" y="204" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="lagarr" value="" style="endArrow=classic;startArrow=classic;html=1;rounded=0;strokeColor=#6c8ebf;strokeWidth=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="564" y="226" as="sourcePoint" />
            <mxPoint x="804" y="226" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d1" value="数値データで気配だけ見える&#10;出来高の異常／立会外（ToSTNeT）&#10;→ 誰が買っているかはわからない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="56" y="240" width="230" height="54" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="ここが本記事の検知対象&#10;見出しに「ファンド名 × 銘柄名」が立つ&#10;→ 無料で機械検知できる" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="296" y="240" width="230" height="54" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="EDINET を突合に使う&#10;まだ開示が無い＝兆候として有効&#10;開示済み＝既知の事実に降格" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="620" y="240" width="250" height="54" as="geometry" />
        </mxCell>
        <mxCell id="note1" value="日経は「早いが漏れる」（取材ベースなので書かれなければ存在しない）&#10;EDINET は「遅いが漏れない」（報告義務ベースなので 100% 収録される）&#10;── この非対称そのものがシグナルになる" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="330" width="600" height="76" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="※ 5% 未満の買い集めは、金を払っても機械可読な代替データが存在しない。ここだけは「情報の非存在」の問題" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="130" y="420" width="700" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
