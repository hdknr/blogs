        </mxCell>

        <mxCell id="qGroup" value="質問（1〜1,000 個）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="30" y="340" width="220" height="160" as="geometry"/>
