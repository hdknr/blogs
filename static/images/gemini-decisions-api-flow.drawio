        <mxCell id="qNoul" value="noul（はい／いいえ）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="375" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="qChoice" value="choice（2〜255 択）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="415" width="160" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="qScore" value="score（段階評価）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="455" width="160" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="model" value="&lt;b&gt;gemini-decision-1&lt;/b&gt;&lt;br&gt;&lt;br&gt;候補を 1 回の forward pass で採点&lt;br&gt;（文章は生成しない）&lt;br&gt;&lt;br&gt;150〜250 ms・出力 0 トークン" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="350" y="200" width="250" height="150" as="geometry"/>
