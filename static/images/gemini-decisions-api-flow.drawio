        <mxCell id="code" value="アプリのコード&lt;br&gt;（if 文で分岐）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="920" y="215" width="150" height="120" as="geometry"/>
