<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="nec-ai-workforce-handoff" name="NEC AI Workforce Handoff Paths">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="790" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="自動処理と人の境界をまたぐ3つの経路" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Source -->
        <mxCell id="src" value="&lt;b&gt;AI社員の稼働&lt;/b&gt;&#xa;タスクを自律的に遂行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="190" height="100" as="geometry"/>
        </mxCell>

        <!-- Path 1 -->
        <mxCell id="p1" value="&lt;b&gt;① ゲート判定（Gate）&lt;/b&gt;&#xa;品質ゲート／配信ゲート&#xa;成果物ごとに自動で判定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="115" width="290" height="110" as="geometry"/>
        </mxCell>

        <!-- Path 2 -->
        <mxCell id="p2" value="&lt;b&gt;② 日次の検知（コックピット）&lt;/b&gt;&#xa;未登載の #AI社員 #タスク／&#xa;成果物停滞・リスクアラート" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="330" width="290" height="110" as="geometry"/>
        </mxCell>

        <!-- Path 3 -->
        <mxCell id="p3" value="&lt;b&gt;③ 週次サーベイ → AIボード決議&lt;/b&gt;&#xa;意思表明 → 相互検討 → 決議&#xa;判断は「承認」／「条件付き承認」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="310" y="545" width="290" height="110" as="geometry"/>
        </mxCell>

        <!-- Outcomes -->
        <mxCell id="o1a" value="非該当 → &lt;b&gt;自動配信可&lt;/b&gt;&#xa;人を通さずに出る" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f4e6;strokeColor=#82b366;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="85" width="250" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="o1b" value="該当・不合格 → 人の確認へ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="175" width="250" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="o2" value="「&lt;b&gt;有人追加を推奨&lt;/b&gt;」&#xa;「要確認」として提示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="352" width="250" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="o3" value="次回への持ち越し&#xa;【&lt;b&gt;人間の承認・最優先&lt;/b&gt;】&#xa;担当移管は「申し送り」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="680" y="560" width="250" height="80" as="geometry"/>
        </mxCell>

        <!-- Human -->
        <mxCell id="human" value="&lt;b&gt;人&lt;/b&gt;&#xa;&#xa;最終承認&#xa;&#xa;立ち会い&#xa;&#xa;データ・権限・&#xa;ナレッジの整備" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf6ec;strokeColor=#d79b00;fontSize=13;align=center;verticalAlign=middle;fontColor=#8a6100;" vertex="1" parent="1">
          <mxGeometry x="1000" y="175" width="190" height="465" as="geometry"/>
        </mxCell>

        <!-- Ledger -->
        <mxCell id="ledger" value="&lt;b&gt;管理台帳&lt;/b&gt;（実証時点では新設審議中・人間の承認待ち）&#xa;同じ失敗が3回続いたら&lt;b&gt;自動起票&lt;/b&gt; → 格上げ → 直ったら固定項目で確認して完了（是正は3段構え）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;verticalAlign=middle;fontColor=#5c3b6e;" vertex="1" parent="1">
          <mxGeometry x="310" y="690" width="880" height="70" as="geometry"/>
        </mxCell>

        <!-- Note -->
        <mxCell id="note" value="&lt;b&gt;有人 / 無人&lt;/b&gt; は&#xa;リスクの大小ではなく&#xa;&lt;b&gt;作業の可逆性&lt;/b&gt;で決まる&#xa;（戻せない操作は人が立ち会う）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=11;align=center;verticalAlign=middle;fontColor=#b85450;fontStyle=2;dashed=1;dashPattern=4 4;" vertex="1" parent="1">
          <mxGeometry x="50" y="620" width="190" height="140" as="geometry"/>
        </mxCell>

        <!-- Edges from source -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="p1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="275" y="380"/>
              <mxPoint x="275" y="170"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="p2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="src" target="p3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="275" y="380"/>
              <mxPoint x="275" y="600"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Path to outcome -->
        <mxCell id="e1a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="p1" target="o1a">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e1b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="p1" target="o1b">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2o" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="p2" target="o2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3o" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="p3" target="o3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Outcomes to human -->
        <mxCell id="eh1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="o1b" target="human">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eh2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="o2" target="human">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eh3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="o3" target="human">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Ledger link -->
        <mxCell id="el" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3" target="ledger">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
