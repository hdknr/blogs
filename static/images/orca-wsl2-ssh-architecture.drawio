<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="orca-wsl2-ssh" name="Orca to WSL2 over SSH">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Windows 上の Orca から WSL2（Ubuntu）へ SSH 接続する構成" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="230" y="20" width="640" height="30" as="geometry"/>
        </mxCell>

        <!-- Windows side -->
        <mxCell id="win-group" value="Windows 11（ホスト）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="330" height="480" as="geometry"/>
        </mxCell>

        <mxCell id="orca-app" value="Orca（デスクトップアプリ）&#xa;&#xa;・エディタ / 差分レビュー&#xa;・ブラウザ / 通知&#xa;・SSH ターゲット管理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="75" y="130" width="260" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="wslconfig" value="C:\Users\&amp;lt;user&amp;gt;\.wslconfig&#xa;&#xa;[wsl2]&#xa;networkingMode=mirrored" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Courier New;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="75" y="300" width="260" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="win-note" value="ミラーモードにすると Windows と WSL2 が&#xa;localhost で相互に通信できる" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="75" y="400" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- SSH arrow -->
        <mxCell id="ssh-arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=3;endArrow=classic;" edge="1" parent="1" source="orca-app" target="sshd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ssh-label" value="ssh &amp;lt;ubuntu-user&amp;gt;@localhost:22" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#b85450;labelBackgroundColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="385" y="160" width="230" height="26" as="geometry"/>
        </mxCell>

        <!-- WSL2 side -->
        <mxCell id="wsl-group" value="WSL2 / Ubuntu（ゲスト）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="630" y="80" width="430" height="480" as="geometry"/>
        </mxCell>

        <mxCell id="sshd" value="OpenSSH Server（sshd）&#xa;22番ポートで待ち受け" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="670" y="130" width="350" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="relay" value="Orca リレー（初回接続時に自動導入）&#xa;&#xa;Node.js + ネイティブ node-pty が必要&#xa;Linux ではホスト上でコンパイルされることが多い" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="670" y="220" width="350" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="toolchain" value="build-essential / python3&#xa;（無いとファイル・git・エディタは動くが&#xa;　リモートターミナルだけ動かない）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="340" width="350" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="agents" value="nvm で入れた Node.js / GitHub CLI&#xa;Claude Code・Codex CLI などのエージェント&#xa;git worktree（リモート側に作成される）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;verticalAlign=middle;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="670" y="430" width="350" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="sshd" target="relay">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="relay" target="toolchain">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="toolchain" target="agents">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="foot" value="画面・差分・ブラウザは Windows 側のまま、コマンドとエージェントの実行だけが Ubuntu 側で動く" style="text;html=1;fontSize=12;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="180" y="580" width="740" height="26" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
