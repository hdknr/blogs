<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="gcp-ga4-credentials" name="Google Cloud 認証情報の構成">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="GA4 / Search Console / PageSpeed の認証情報の対応関係" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="260" y="15" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Project container -->
        <mxCell id="project" value="Google Cloud プロジェクト（1 つでよい）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=8;dashed=1;dashPattern=6 6;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="1060" height="540" as="geometry"/>
        </mxCell>

        <!-- Column headers -->
        <mxCell id="h1" value="有効化する API（4 つ）" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="70" y="105" width="290" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="h2" value="Console で発行するもの" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="440" y="105" width="240" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="h3" value="ブラウザ認可で取得するもの" style="text;html=1;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="760" y="105" width="290" height="24" as="geometry"/>
        </mxCell>

        <!-- OAuth-required APIs -->
        <mxCell id="api-data" value="Google Analytics Data API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="145" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="api-admin" value="Google Analytics Admin API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="200" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="api-gsc" value="Google Search Console API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="255" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="oauth-note" value="OAuth 必須（ユーザーのデータを読む）" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="70" y="298" width="240" height="20" as="geometry"/>
        </mxCell>

        <!-- API-key API -->
        <mxCell id="api-psi" value="PageSpeed Insights API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="380" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="psi-note" value="OAuth 不要（公開 URL を外から測るだけ）" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="70" y="423" width="240" height="20" as="geometry"/>
        </mxCell>

        <!-- OAuth client -->
        <mxCell id="oauth-client" value="OAuth クライアント（デスクトップ アプリ型）&#xa;&#xa;client_id / client_secret&#xa;&#xa;プロジェクトに 1 つ・全 API で共用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="165" width="240" height="110" as="geometry"/>
        </mxCell>

        <!-- API key -->
        <mxCell id="api-key" value="API キー（AIza...）&#xa;&#xa;1 本を使い回せる&#xa;PSI API のみに制限する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="355" width="240" height="90" as="geometry"/>
        </mxCell>

        <!-- refresh tokens -->
        <mxCell id="rt-ga4" value="refresh_token（GA4 スコープ）&#xa;analytics.readonly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rt-gsc" value="refresh_token（SC スコープ）&#xa;webmasters.readonly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="790" y="225" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="rt-note" value="スコープごとに 1 つ ＝ 認可も 1 回ずつ" style="text;html=1;fontSize=10;fontStyle=2;align=center;verticalAlign=middle;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="790" y="278" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="rt-none" value="トークン不要" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;fontColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="375" width="240" height="50" as="geometry"/>
        </mxCell>

        <!-- Consent screen -->
        <mxCell id="consent" value="OAuth 同意画面 — 対象（Audience）：プロジェクトに 1 回だけ設定し、External なら「本番」に公開する&#xa;※ 公開せず「テスト中」のままだと refresh_token が 7 日で失効する" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="70" y="490" width="960" height="70" as="geometry"/>
        </mxCell>

        <!-- Edges: APIs to OAuth client -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="api-data" target="oauth-client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="api-admin" target="oauth-client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="api-gsc" target="oauth-client">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge: PSI to API key -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d79b00;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="api-psi" target="api-key">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edges: OAuth client to refresh tokens -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="oauth-client" target="rt-ga4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673a6;strokeWidth=1.5;endArrow=block;" edge="1" parent="1" source="oauth-client" target="rt-gsc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge: API key to none -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b3b3b3;strokeWidth=1.5;dashed=1;endArrow=block;" edge="1" parent="1" source="api-key" target="rt-none">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edge: consent applies to oauth client -->
        <mxCell id="e8" value="OAuth クライアントに効く" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;endArrow=block;fontSize=10;fontColor=#a68a2e;verticalAlign=bottom;exitX=0.32;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="consent" target="oauth-client">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="377" y="220"/>
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
