<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="hubspot-line-lead-linking" name="HubSpot LINE Lead Linking Architecture">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="HubSpot + LIFF によるリード紐づけアーキテクチャ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- LINE side group -->
        <mxCell id="line-group" value="LINE 側" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;dashed=1;dashPattern=5 5;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="780" height="190" as="geometry"/>
        </mxCell>

        <!-- LINE broadcast -->
        <mxCell id="broadcast" value="LINE 配信&#xa;(ブロードキャスト / リッチメニュー)&#xa;&#xa;全員に同じ URL を配布" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="110" width="220" height="110" as="geometry"/>
        </mxCell>

        <!-- liff.line.me -->
        <mxCell id="liffurl" value="https://liff.line.me/{liffId}&#xa;&#xa;LIFF ブラウザがエンドポイント URL を開き&#xa;ログインセッションから&#xa;アクセストークンを自動引き渡し" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="440" y="110" width="280" height="110" as="geometry"/>
        </mxCell>

        <!-- Arrow broadcast -> liffurl -->
        <mxCell id="arr-bc-liff" value="タップ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="broadcast" target="liffurl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HubSpot LP group -->
        <mxCell id="lp-group" value="HubSpot LP（CMS テーマのモジュール）＝ LIFF エンドポイント URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="780" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="lp-sdk" value="① LIFF SDK 読み込み&#xa;+ liff.init()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="370" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lp-profile" value="② liff.getProfile() で&#xa;userId を取得" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="350" y="370" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lp-hidden" value="③ HubSpot フォームの&#xa;hidden フィールド&#xa;line_user_id に注入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="370" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="lp-form" value="アンケートフォーム（email 必須 + line_user_id hidden）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="455" width="700" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="arr-sdk-prof" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="lp-sdk" target="lp-profile">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr-prof-hid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=1.5;" edge="1" parent="1" source="lp-profile" target="lp-hidden">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Arrow liffurl -> LP group -->
        <mxCell id="arr-liff-lp" value="LIFF ブラウザで LP を表示" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4472C4;strokeWidth=2.5;fontSize=10;" edge="1" parent="1" source="liffurl" target="lp-group">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- HubSpot contact -->
        <mxCell id="contact" value="HubSpot コンタクト&#xa;&#xa;email で既存コンタクトと自動名寄せ&#xa;+ line_user_id プロパティに userId が保存される" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="590" width="440" height="110" as="geometry"/>
        </mxCell>

        <!-- Arrow form -> contact -->
        <mxCell id="arr-form-contact" value="フォーム送信" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d79b00;strokeWidth=2.5;fontSize=10;" edge="1" parent="1" source="lp-form" target="contact">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- No extra server note -->
        <mxCell id="note" value="中継サーバー（Lambda 等）は不要&#xa;HubSpot ネイティブ + LIFF だけで完結" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=2;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="600" width="170" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
