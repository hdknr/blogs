<mxfile host="draw.io">
  <diagram name="YouTube Shorts 自動化パイプライン" id="yt-shorts-pipeline">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="600" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Step 1: Claude -->
        <mxCell id="step1" value="Claude&#xa;（スクリプト生成）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="175" y="40" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow 1 -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 2: AI音声合成 -->
        <mxCell id="step2" value="AI 音声合成&#xa;（ElevenLabs / Neets.ai / VOICEVOX）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="175" y="145" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow 2 -->
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 3: AI映像生成 -->
        <mxCell id="step3" value="AI 映像生成&#xa;（Runway / Kling）またはスライド素材" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="175" y="250" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow 3 -->
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 4: 自動編集 -->
        <mxCell id="step4" value="自動編集&#xa;（CapCut / OpusClip）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="175" y="355" width="220" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow 4 -->
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;" edge="1" parent="1" source="step4" target="step5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Step 5: YouTube Shorts -->
        <mxCell id="step5" value="YouTube Shorts アップロード" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="175" y="460" width="220" height="55" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
