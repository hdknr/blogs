<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="hubspot-contact-merge-flow" name="HubSpot Contact Merge Flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="AI × API で実現する「自動重複マージ」の 3 ステップ" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="240" y="20" width="500" height="30" as="geometry"/>
        </mxCell>

        <!-- Step 1: AI detection -->
        <mxCell id="step1" value="Step 1: AI が検知&#xa;&#xa;AI（またはスクリプト）が&#xa;「名前が一致、かつ会社名や&#xa;電話番号が類似」している&#xa;リードを抽出してリスト化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="step1-icon" value="&#x1f916; 検知" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#4472C4;" vertex="1" parent="1">
          <mxGeometry x="110" y="70" width="100" height="25" as="geometry"/>
        </mxCell>

        <!-- Step 2: Human approval -->
        <mxCell id="step2" value="Step 2: 人間が確認&#xa;&#xa;Slack・社内ツール・&#xa;スプレッドシート等に&#xa;「この 2 人、マージして&#xa;大丈夫ですか?」と AI が通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="100" width="240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="step2-icon" value="&#x1f464; 承認" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#b8860b;" vertex="1" parent="1">
          <mxGeometry x="440" y="70" width="100" height="25" as="geometry"/>
        </mxCell>

        <!-- Step 3: API execution -->
        <mxCell id="step3" value="Step 3: API で実行&#xa;&#xa;承認されたペアだけ&#xa;POST /crm/v3/objects/&#xa;contacts/merge を呼び出して&#xa;安全にマージ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="240" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="step3-icon" value="&#x2699;&#xfe0f; 実行" style="text;html=1;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontColor=#5a8a4a;" vertex="1" parent="1">
          <mxGeometry x="770" y="70" width="100" height="25" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="arr-12" value="候補リスト" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arr-23" value="承認 (OK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d6b656;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Why not full-auto note -->
        <mxCell id="note" value="全自動にしない理由: マージは取り消し不可の一発勝負。同姓同名の別人を誤マージするリスクがあるため、実行前に人間の承認を挟む" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=2;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="300" width="600" height="50" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
