<mxfile host="app.diagrams.net" agent="Claude Code" version="26.0.0">
  <diagram id="token-exchange-flow" name="Flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="モバイルアプリの全体フロー — 色帯がそれぞれの RFC の担当範囲" style="text;html=1;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="14" width="780" height="28" as="geometry"/>
        </mxCell>

        <!-- Phase bands (drawn first / behind) -->
        <mxCell id="band1" value="① ログイン ── RFC 6749（Authorization Code）＋ RFC 7636（PKCE）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f4ff;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="900" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="band2" value="② ★ RFC 7523（JWT Bearer Grant）の範囲 ── client→RP と RP→IdP の2段とも 7523 ★" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dcf8e2;strokeColor=#82b366;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="900" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="band3" value="③ API 呼び出し ── RFC 6749（Bearer トークンでのリソースアクセス）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff4e0;strokeColor=#d79b00;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="900" height="170" as="geometry"/>
        </mxCell>

        <!-- Participants -->
        <mxCell id="p-app" value="モバイルアプリ&#xa;(public client)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="56" width="160" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="p-idp" value="IdP&#xa;(統合認証)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="56" width="160" height="44" as="geometry"/>
        </mxCell>
        <mxCell id="p-rp" value="RP&#xa;(経費/マスタ/店舗)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="56" width="160" height="44" as="geometry"/>
        </mxCell>

        <!-- Lifelines -->
        <mxCell id="ll-app" style="endArrow=none;html=1;strokeColor=#b85450;dashed=1;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="170" y="100" as="sourcePoint"/>
            <mxPoint x="170" y="810" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-idp" style="endArrow=none;html=1;strokeColor=#6c8ebf;dashed=1;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="100" as="sourcePoint"/>
            <mxPoint x="500" y="810" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-rp" style="endArrow=none;html=1;strokeColor=#82b366;dashed=1;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="100" as="sourcePoint"/>
            <mxPoint x="820" y="810" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Band1 messages: App(170) <-> IdP(500) -->
        <mxCell id="m1" value="認可リクエスト (code_challenge=S256)" style="endArrow=block;html=1;strokeColor=#3b5b86;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="170" y="150" as="sourcePoint"/><mxPoint x="500" y="150" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m2" value="認可コード (カスタムスキームで受領)" style="endArrow=block;html=1;strokeColor=#3b5b86;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="185" as="sourcePoint"/><mxPoint x="170" y="185" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m3" value="コード + code_verifier を IdP の /token へ" style="endArrow=block;html=1;strokeColor=#3b5b86;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="170" y="222" as="sourcePoint"/><mxPoint x="500" y="222" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m4" value="身分証となる署名付き JWT を発行" style="endArrow=block;html=1;strokeColor=#3b5b86;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="259" as="sourcePoint"/><mxPoint x="170" y="259" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Band2 messages -->
        <mxCell id="m5" value="【7523-a】IdP の JWT を assertion として RP の /token へ (grant_type=...:jwt-bearer)" style="endArrow=block;html=1;strokeColor=#2d7a3e;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="170" y="345" as="sourcePoint"/><mxPoint x="820" y="345" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="n1" value="JWT の署名を検証&#xa;(IdP の公開鍵 / JWKS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d7a3e;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="720" y="365" width="200" height="36" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="【7523-b】同じ JWT を assertion として IdP の /token へ" style="endArrow=block;html=1;strokeColor=#2d7a3e;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="435" as="sourcePoint"/><mxPoint x="500" y="435" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="m7" value="access_token + refresh_token を返答 (= この JWT の IdP ユーザーが確定)" style="endArrow=block;html=1;strokeColor=#2d7a3e;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="500" y="475" as="sourcePoint"/><mxPoint x="820" y="475" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="n2" value="IdP ユーザーに対応する RP ローカルユーザーを&#xa;作成／解決（JIT プロビジョニング・RFC 範囲外）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="280" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="RP ローカルユーザーの access_token / refresh_token を発行" style="endArrow=block;html=1;strokeColor=#2d7a3e;strokeWidth=2;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="585" as="sourcePoint"/><mxPoint x="170" y="585" as="targetPoint"/></mxGeometry>
        </mxCell>

        <!-- Band3 messages -->
        <mxCell id="m9" value="Authorization: Bearer (RP が発行したトークン)" style="endArrow=block;html=1;strokeColor=#b8860b;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="170" y="690" as="sourcePoint"/><mxPoint x="820" y="690" as="targetPoint"/></mxGeometry>
        </mxCell>
        <mxCell id="n3" value="自分が発行したトークンを検証（ローカル）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b8860b;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="710" width="240" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="リソース応答" style="endArrow=block;html=1;strokeColor=#b8860b;strokeWidth=1.5;fontSize=11;align=center;verticalAlign=bottom;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="820" y="775" as="sourcePoint"/><mxPoint x="170" y="775" as="targetPoint"/></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
